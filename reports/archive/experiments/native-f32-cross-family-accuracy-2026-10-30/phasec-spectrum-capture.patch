+    let spin = ShtPlan::<f32>::new(grid, spin_harmonics.clone()).unwrap();
+    let sample = |index: usize, seed: u64| {
+        let mut x = (index as u64).wrapping_add(seed.wrapping_mul(0x9e37_79b9_7f4a_7c15));
+        x ^= x >> 30;
+        x = x.wrapping_mul(0xbf58_476d_1ce4_e5b9);
+        x ^= x >> 27;
+        x = x.wrapping_mul(0x94d0_49bb_1331_11eb);
+        x ^= x >> 31;
+        let signed = (x % 65_535) as i32 - 32_767;
+        signed as f32 / 32_768.0
+    };
+    let write = |name: &str, values: &[num_complex::Complex32]| {
+        let mut file = std::io::BufWriter::new(std::fs::File::create(out.join(name)).unwrap());
+        for value in values {
+            file.write_all(&value.re.to_le_bytes()).unwrap();
+            file.write_all(&value.im.to_le_bytes()).unwrap();
+        }
+    };
+    let sample_count = ntheta * nphi;
+    let scalar_map: Vec<f32> = (0..sample_count).map(|i| sample(i, 11)).collect();
+    let q_map: Vec<f32> = (0..sample_count).map(|i| sample(i, 23)).collect();
+    let u_map: Vec<f32> = (0..sample_count).map(|i| sample(i, 47)).collect();
+
+    let mut scalar_alm = vec![Complex32::new(0.0, 0.0); scalar_harmonics.nalm()];
+    let mut scalar_workspace = scalar.workspace().unwrap();
+    scalar
+        .analysis_into(&scalar_map, &mut scalar_alm, &mut scalar_workspace)
+        .unwrap();
+    write("scalar-analysis-spectrum.f32", &scalar_workspace.spectra);
+
+    let mut e_alm = vec![Complex32::new(0.0, 0.0); spin_harmonics.nalm()];
+    let mut b_alm = vec![Complex32::new(0.0, 0.0); spin_harmonics.nalm()];
+    let mut spin_workspace = spin.workspace().unwrap();
