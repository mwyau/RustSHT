+    write("spin-analysis-u-spectrum.f32", &spin_workspace.spin_spectra);
+
+    let coefficient = |l: usize, m: usize, lane: usize| {
+        let x = (l as u64)
+            .wrapping_mul(0x9e37_79b9)
+            .wrapping_add((m as u64).wrapping_mul(0x85eb_ca6b))
+            .wrapping_add((lane as u64).wrapping_mul(0xc2b2_ae35));
+        let signed = (x % 4_095) as i32 - 2_047;
+        signed as f32 / 4_096.0
+    };
+    let mut e_input = vec![Complex32::new(0.0, 0.0); spin_harmonics.nalm()];
+    let mut b_input = vec![Complex32::new(0.0, 0.0); spin_harmonics.nalm()];
+    for m in 0..=mmax {
+        for l in 600..=lmax {
+            let index = spin_harmonics.index(l, m).unwrap();
+            e_input[index] = Complex32::new(
+                coefficient(l, m, 1),
+                if m == 0 { 0.0 } else { coefficient(l, m, 2) },
+            );
+            b_input[index] = Complex32::new(
+                coefficient(l, m, 3),
+                if m == 0 { 0.0 } else { coefficient(l, m, 4) },
+            );
+        }
+    }
+    let mut q = vec![0.0_f32; sample_count];
+    let mut u = vec![0.0_f32; sample_count];
