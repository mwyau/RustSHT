+    spin.synthesis_spin_into(&e_input, &b_input, &mut q, &mut u, &mut synth_workspace)
+        .unwrap();
+    let mut dispatch = std::fs::File::create(out.join("spin-synthesis-dispatch.txt")).unwrap();
+    writeln!(
+        dispatch,
+        "execution_capacity={} ring_group_size={} cached_scalar_coefficients={} cached_finite_orders={}",
+        synth_workspace.execution_capacity,
+        synth_workspace.ring_group_size,
+        synth_workspace.spin1_scalar_coefficients.len(),
+        synth_workspace.spin1_scalar_coefficient_finite_orders.len(),
+    )
+    .unwrap();
+    let row_len = lmax + 2;
+    let order_row_start = mmax * row_len * 2;
+    let (first_channel, second_channel) = if synth_workspace.spin1_scalar_coefficients.is_empty() {
+        let recurrence = &synth_workspace.recurrence_workers[0];
+        (
+            &recurrence.fast_scalar_first[..row_len],
+            &recurrence.fast_scalar_second[..row_len],
+        )
+    } else {
+        (
+            &synth_workspace.spin1_scalar_coefficients
+                [order_row_start..order_row_start + row_len],
+            &synth_workspace.spin1_scalar_coefficients
+                [order_row_start + row_len..order_row_start + 2 * row_len],
+        )
+    };
+    write("spin-synthesis-converted-first-m16.f32", first_channel);
+    write("spin-synthesis-converted-second-m16.f32", second_channel);
+    let prepared_pair_count = (lmax + 1 - mmax + 2) / 2;
+    let recurrence = &synth_workspace.recurrence_workers[0];
+    write(
+        "spin-synthesis-pair-first-m16.f32",
+        &recurrence.fast_spin_first[..prepared_pair_count],
+    );
+    write(
+        "spin-synthesis-pair-second-m16.f32",
+        &recurrence.fast_spin_second[..prepared_pair_count],
+    );
+    write(
+        "spin-synthesis-pair-first2-m16.f32",
+        &recurrence.fast_spin_pair_first[..prepared_pair_count],
+    );
+    write(
+        "spin-synthesis-pair-second2-m16.f32",
+        &recurrence.fast_spin_pair_second[..prepared_pair_count],
+    );
+    write("spin-synthesis-q-spectrum.f32", &synth_workspace.spectra);
+    write(
+        "spin-synthesis-u-spectrum.f32",
+        &synth_workspace.spin_spectra,
+    );
+}
