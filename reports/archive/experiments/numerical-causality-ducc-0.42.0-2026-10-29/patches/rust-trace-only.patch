+#[test]
+#[ignore = "bounded AVX2 trace of the active compensated native-f32 zonal synthesis leaf"]
+fn native_f32_zonal_production_t720_numeric_trace_probe() {
+    use num_complex::Complex32;
+    use std::fmt::Write as _;
+
+    const LMAX: usize = 720;
+    const RINGS: [usize; 4] = [0, 1, 5, 360];
+    let grid = crate::grid::GridSpec::new(crate::grid::GridKind::GaussLegendre, LMAX + 1, 34, 0.0)
+        .unwrap();
+    let harmonics = crate::harmonics::HarmonicSpec::scalar(LMAX, 0).unwrap();
+    let plan = crate::plan::ShtPlan::<f32>::new(grid.clone(), harmonics).unwrap();
+    let latitude = plan.scalar_latitude_geometry.as_ref().unwrap();
+    let geometry = latitude.zonal_double_single.as_ref().unwrap();
+    let geometry_view = geometry.view();
+    let mut coefficients = vec![Complex32::new(0.0, 0.0); LMAX + 1];
+    coefficients[LMAX] = Complex32::new(1.0, 0.0);
+    let pair = LMAX / 2;
+    let mut csv = String::from("RUST_NATIVE_F32_ZONAL_TRACE,1,GL_T720,phi0=0,AVX2_lanes=8\n");
+
+    for ring in RINGS {
+        let theta = grid.theta()[ring];
+        let sine = latitude.theta_sin[ring];
+        let cosine = latitude.theta_cos[ring];
+        let cosine_high = geometry.cos_theta.high[ring];
+        let cosine_low = geometry.cos_theta.low[ring];
+        let cosine_squared_high = geometry.cos_theta_squared.high[ring];
+        let cosine_squared_low = geometry.cos_theta_squared.low[ring];
+        writeln!(
+            &mut csv,
+            "PLAN,{ring},theta={:016x},sin={:08x},cos={:08x},cos_hi={:08x},cos_lo={:08x},csq_hi={:08x},csq_lo={:08x},a_hi={:08x},a_lo={:08x},b_hi={:08x},b_lo={:08x},even_first_hi={:08x},even_first_lo={:08x},even_second_hi={:08x},even_second_lo={:08x},sectoral={:08x}",
+            theta.to_bits(),
+            sine.to_bits(),
+            cosine.to_bits(),
+            cosine_high.to_bits(),
+            cosine_low.to_bits(),
+            cosine_squared_high.to_bits(),
+            cosine_squared_low.to_bits(),
+            geometry.factor_a.high[pair].to_bits(),
+            geometry.factor_a.low[pair].to_bits(),
+            geometry.factor_b.high[pair].to_bits(),
+            geometry.factor_b.low[pair].to_bits(),
+            geometry.even_first.high[pair].to_bits(),
+            geometry.even_first.low[pair].to_bits(),
+            geometry.even_second.high[pair].to_bits(),
+            geometry.even_second.low[pair].to_bits(),
+            plan.sectoral_norms[0].to_bits(),
+        )
+        .unwrap();
+        let mut north = [0.0_f32; 8];
+        let mut south = [0.0_f32; 8];
+        super::begin_zonal_trace(ring);
+        assert!(Arch::new().dispatch(ZonalProductionTraceBatch {
+            coefficients: &coefficients,
+            geometry: geometry_view,
+            lmax: LMAX,
+            sectoral_norm: plan.sectoral_norms[0],
+            ring,
+            north: &mut north,
+            south: &mut south,
+        }));
+        let trace = super::zonal_trace_snapshot();
+        assert_eq!(
+            trace.len(),
+            pair,
+            "incomplete zonal recurrence trace at ring {ring}"
+        );
+        for entry in trace {
+            write!(&mut csv, "REC,{},{}", entry.ring, entry.degree).unwrap();
+            for bits in entry.values {
+                write!(&mut csv, ",{bits:08x}").unwrap();
+            }
+            writeln!(&mut csv).unwrap();
+        }
+        writeln!(
+            &mut csv,
+            "OUTPUT,{ring},north={:08x},south={:08x}",
+            north[0].to_bits(),
+            south[0].to_bits(),
+        )
+        .unwrap();
+        eprintln!(
+            "zonal trace ring={ring} theta={theta:.17e} sin={sine:.9e} cos={cosine:.9e} north={:.9e} south={:.9e}",
+            north[0], south[0]
+        );
+    }
+    let path = std::env::var("NUM_TRACE_RUST_ZONAL_CSV").unwrap_or_else(|_| {
+        "rust-zonal-f32.csv".to_owned()
+    });
+    std::fs::write(path, csv).unwrap();
+}
