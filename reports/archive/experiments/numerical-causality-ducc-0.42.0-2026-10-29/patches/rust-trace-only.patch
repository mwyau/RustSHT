+                    sectoral_norm: plan.sectoral_norms[order],
+                    order,
+                    lmax: LMAX,
+                    ring,
+                }));
+                let observations = super::kernel::prefix_observation_snapshot();
+                let trace = super::kernel::numeric_trace_snapshot();
+                assert!(
+                    trace.len() > 300,
+                    "incomplete ordinary trace for m={order}, ring={ring}: {}",
+                    trace.len()
+                );
+                assert!(trace.iter().all(|entry| entry.next == entry.actual_next));
+                for observation in observations {
+                    writeln!(
+                        &mut csv,
+                        "PREFIX,{},{} ,active={},scaled_pairs={},ordinary_start={},full_ieee={}",
+                        observation.order,
+                        observation.first_north_ring,
+                        observation.active_lanes,
+                        observation.scaled_pairs,
+                        observation.ordinary_start_degree,
+                        observation.reached_full_ieee,
+                    )
+                    .unwrap();
+                }
+                for entry in trace {
+                    write!(
+                        &mut csv,
+                        "REC,{},{},{},{},",
+                        entry.order, entry.ring, trace_part, entry.degree,
+                    )
+                    .unwrap();
+                    for bits in [
+                        entry.cosine_squared,
+                        entry.coefficient_a,
+                        entry.coefficient_b,
+                        entry.previous,
+                        entry.current,
+                        entry.leading,
+                        entry.next,
+                        entry.actual_next,
+                        entry.even_re,
+                        entry.odd_re,
+                        entry.even_im,
+                        entry.odd_im,
+                        entry.sum_even_re_in,
+                        entry.sum_even_re_out,
+                        entry.sum_odd_re_in,
+                        entry.sum_odd_re_out,
+                    ] {
+                        write!(&mut csv, "{bits:016x},").unwrap();
+                    }
+                    writeln!(&mut csv).unwrap();
+                }
+                let north_re = scratch.sum_even_re[0] + scratch.sum_odd_re[0] * cosine;
+                let south_re = scratch.sum_even_re[0] - scratch.sum_odd_re[0] * cosine;
+                let north_im = scratch.sum_even_im[0] + scratch.sum_odd_im[0] * cosine;
+                let south_im = scratch.sum_even_im[0] - scratch.sum_odd_im[0] * cosine;
+                writeln!(
+                    &mut csv,
+                    "OUTPUT,{order},{ring},{trace_part},theta={:016x},sin={:08x},cos={:08x},csq={:08x},north=({:08x},{:08x}),south=({:08x},{:08x}),even=({:08x},{:08x}),odd=({:08x},{:08x})",
+                    theta.to_bits(), sine.to_bits(), cosine.to_bits(), cosine_squared.to_bits(),
+                    north_re.to_bits(), north_im.to_bits(), south_re.to_bits(), south_im.to_bits(),
+                    scratch.sum_even_re[0].to_bits(), scratch.sum_even_im[0].to_bits(),
+                    scratch.sum_odd_re[0].to_bits(), scratch.sum_odd_im[0].to_bits(),
+                )
+                .unwrap();
+            }
+          }
+        }
+    }
+    let path = std::env::var("NUM_TRACE_RUST_CSV").unwrap_or_else(|_| {
+        "rust-native-f32.csv".to_owned()
+    });
+    std::fs::write(path, csv).unwrap();
+    eprintln!("native-f32 T720 AVX2 trace written; lanes={lanes}");
+}
