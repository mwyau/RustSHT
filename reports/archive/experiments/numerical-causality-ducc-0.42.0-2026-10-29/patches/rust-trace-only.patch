+        let mut trace = trace()
+            .lock()
+            .unwrap_or_else(|poisoned| poisoned.into_inner());
+        trace.0 = Some((order, ring));
+        trace.1.clear();
+    }
+
+    pub(super) fn record(record: RecurrenceTrace) {
+        let mut trace = trace()
+            .lock()
+            .unwrap_or_else(|poisoned| poisoned.into_inner());
+        if trace.0 == Some((record.order, record.ring)) {
+            trace.1.push(record);
+        }
+    }
+
+    pub(super) fn snapshot() -> Vec<RecurrenceTrace> {
+        trace()
+            .lock()
+            .unwrap_or_else(|poisoned| poisoned.into_inner())
+            .1
+            .clone()
+    }
+}
