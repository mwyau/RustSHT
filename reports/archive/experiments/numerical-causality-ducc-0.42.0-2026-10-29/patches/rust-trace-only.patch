+#[test]
+#[ignore = "isolated deterministic native-f32 public-map cross-language trace"]
+fn native_f32_public_map_t720_numeric_probe() {
+    use num_complex::Complex32;
+    use std::fmt::Write as _;
+
+    const LMAX: usize = 720;
+    const NTHETA: usize = LMAX + 1;
+    const NPHI: usize = 34;
+    const TARGET_RINGS: [usize; 7] = [0, 1, 5, 360, 715, 719, 720];
+    const TARGET_DEGREES: [usize; 5] = [600, 650, 700, 719, 720];
+    const ORDERS: [usize; 6] = [0, 1, 2, 5, 8, 16];
+
+    let grid = crate::grid::GridSpec::new(crate::grid::GridKind::GaussLegendre, NTHETA, NPHI, 0.0)
+        .unwrap();
+    let mut theta_csv = String::new();
+    for theta in grid.theta() {
+        writeln!(&mut theta_csv, "{:016x}", theta.to_bits()).unwrap();
+    }
+    let theta_path = std::env::var("NUM_TRACE_THETA_FILE").unwrap_or_else(|_| {
+        "gl-t720-theta.bits".to_owned()
+    });
+    std::fs::write(theta_path, theta_csv).unwrap();
+
+    let mut csv = String::from("RUST_NATIVE_F32_PUBLIC_MAP,1,GL_T720,phi0=0,nphi=34\n");
+    let mut low_csv = String::from("RUST_NATIVE_F32_LOW_ORDER_TRACE,1,GL_T720,AVX2_lanes=8\n");
+    for order in ORDERS {
+        let harmonics = crate::harmonics::HarmonicSpec::scalar(LMAX, order).unwrap();
+        let plan = crate::plan::ShtPlan::<f32>::new(grid.clone(), harmonics.clone()).unwrap();
+        let mut workspace = plan.workspace().unwrap();
+        plan.prepare_workspace(&mut workspace, 1).unwrap();
+        for degree in TARGET_DEGREES {
+            for (part, value) in [
+                ("re", Complex32::new(1.0, 0.0)),
+                ("im", Complex32::new(0.0, 1.0)),
+            ] {
+                if order == 0 && part == "im" {
+                    continue;
+                }
+                let mut alm = vec![Complex32::new(0.0, 0.0); harmonics.nalm()];
+                alm[harmonics.index(degree, order).unwrap()] = value;
+                let mut map = vec![f32::NAN; NTHETA * NPHI];
+                plan.synthesis_into(&alm, &mut map, &mut workspace).unwrap();
+                if degree == LMAX && order > 0 && order <= 2 && part == "re" {
+                    for trace_ring in [0, 1, 5, 360] {
+                        super::begin_low_order_trace(order, trace_ring);
+                        let mut trace_map = vec![f32::NAN; NTHETA * NPHI];
+                        plan.synthesis_into(&alm, &mut trace_map, &mut workspace)
+                            .unwrap();
+                        let trace = super::low_order_trace_snapshot();
+                        if trace.len() < 300 {
+                            writeln!(
+                                &mut low_csv,
+                                "FAIL,{order},{trace_ring},{:?},partial={}",
+                                super::low_order_trace_failure_snapshot(),
+                                trace.len()
+                            )
+                            .unwrap();
+                            let zonal = plan
+                                .scalar_latitude_geometry
+                                .as_ref()
+                                .and_then(|latitude| latitude.zonal_double_single.as_ref())
+                                .unwrap();
+                            let zonal_view = zonal.view();
+                            let low = zonal_view.low_order(order).unwrap();
+                            writeln!(
+                                &mut low_csv,
+                                "FAIL_SETUP,{order},{trace_ring},a0={:08x},{:08x},b0={:08x},{:08x},csq={:08x},{:08x},seed={:08x},{:08x},cos={:08x},{:08x}",
+                                low.factor_a.high[0].to_bits(),
+                                low.factor_a.low[0].to_bits(),
+                                low.factor_b.high[0].to_bits(),
+                                low.factor_b.low[0].to_bits(),
+                                low.cos_theta_squared.high[trace_ring].to_bits(),
+                                low.cos_theta_squared.low[trace_ring].to_bits(),
+                                low.sectoral_seed.high[trace_ring].to_bits(),
+                                low.sectoral_seed.low[trace_ring].to_bits(),
+                                low.cos_theta.high[trace_ring].to_bits(),
+                                low.cos_theta.low[trace_ring].to_bits(),
+                            )
+                            .unwrap();
+                        }
+                        for entry in trace {
+                            write!(
+                                &mut low_csv,
+                                "LOWREC,{},{},{}",
+                                entry.m, entry.ring, entry.degree
+                            )
+                            .unwrap();
+                            for bits in entry.values {
+                                write!(&mut low_csv, ",{bits:08x}").unwrap();
+                            }
+                            writeln!(&mut low_csv).unwrap();
+                        }
+                    }
+                }
+                for ring in TARGET_RINGS {
+                    write!(
+                        &mut csv,
+                        "MAP,{order},{degree},{part},{ring},{:016x},{:08x},{:08x}",
+                        grid.theta()[ring].to_bits(),
+                        value.re.to_bits(),
+                        value.im.to_bits(),
+                    )
+                    .unwrap();
+                    for pixel in &map[ring * NPHI..(ring + 1) * NPHI] {
+                        write!(&mut csv, ",{:08x}", pixel.to_bits()).unwrap();
+                    }
+                    writeln!(&mut csv).unwrap();
+                }
+            }
+        }
+    }
+    let path = std::env::var("NUM_TRACE_RUST_MAP_CSV").unwrap_or_else(|_| {
+        "rust-public-map.csv".to_owned()
+    });
+    std::fs::write(path, csv).unwrap();
+    let low_path = std::env::var("NUM_TRACE_RUST_LOW_CSV").unwrap_or_else(|_| {
+        "rust-low-order.csv".to_owned()
+    });
+    std::fs::write(low_path, low_csv).unwrap();
+}
