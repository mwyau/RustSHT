+#[expect(
+    clippy::too_many_arguments,
+    reason = "The shared prefix hands its independent ring recurrence slices to the native suffix."
+)]
+fn synthesize_ordinary_suffix_batch<T: OrderedSimdPrecision, S: Simd>(
+    simd: S,
+    previous_low: &mut [T],
+    current_low: &mut [T],
+    scratch: &mut ScalarOrderedScratch<'_, T>,
+    lmax: usize,
+    pair_count: usize,
+    degree: usize,
+    pair: usize,
+    active_count: usize,
+) -> bool {
+    let lanes = T::lane_count::<S>();
+    if lanes <= 1 {
+        for start in (0..active_count).step_by(lanes) {
+            if !synthesize_ordinary_suffix_vector::<T, S>(
+                simd,
+                &mut previous_low[start..start + lanes],
+                &mut current_low[start..start + lanes],
+                scratch,
+                lmax,
+                pair_count,
+                degree,
+                pair,
+                start,
+                start + lanes,
+            ) {
+                return false;
+            }
+        }
+        return true;
+    }
+
+    let pair_width = 2 * lanes;
+    if T::TRACK_RESIDUAL_RECURRENCE {
+        for start in (0..active_count).step_by(lanes) {
+            if !synthesize_ordinary_suffix_vector::<T, S>(
+                simd,
+                &mut previous_low[start..start + lanes],
+                &mut current_low[start..start + lanes],
+                scratch,
+                lmax,
+                pair_count,
+                degree,
+                pair,
+                start,
+                start + lanes,
+            ) {
+                return false;
+            }
+        }
+        return true;
+    }
+    let mut start = 0;
+    while start + pair_width <= active_count {
+        if !synthesize_ordinary_suffix_two_vectors::<T, S>(
+            simd,
+            scratch,
+            lmax,
+            pair_count,
+            degree,
+            pair,
+            start,
+            start + lanes,
+        ) {
+            return false;
+        }
+        start += pair_width;
+    }
+    start == active_count
+        || synthesize_ordinary_suffix_vector::<T, S>(
+            simd,
+            &mut previous_low[start..active_count],
+            &mut current_low[start..active_count],
+            scratch,
+            lmax,
+            pair_count,
+            degree,
+            pair,
+            start,
+            active_count,
+        )
