+            .unwrap_or_else(|poisoned| poisoned.into_inner())
+            .clone()
+    }
+
+    pub(super) fn record_prefix_detail(observation: PrefixObservation) {
+        if PREFIX_DETAIL_ENABLED.load(Ordering::Relaxed) {
+            prefix_detail()
