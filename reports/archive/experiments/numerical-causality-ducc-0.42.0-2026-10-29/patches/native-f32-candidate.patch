+#[test]
+fn f32_t720_zonal_double_single_matches_mixed_coefficients_and_resets() {
+    let lmax = 720;
+    let grid = GridSpec::new(GridKind::GaussLegendre, lmax + 1, 1, 0.0).unwrap();
+    let harmonics = HarmonicSpec::scalar(lmax, 0).unwrap();
+    let plan = ShtPlan::<f32>::new(grid.clone(), harmonics.clone()).unwrap();
+    let mut workspace = plan.workspace().unwrap();
+    plan.prepare_workspace(&mut workspace, 1).unwrap();
+    let mut alm = vec![Complex32::new(0.0, 0.0); harmonics.nalm()];
+    let mut state = 0x6d2b_79f5_u32;
+    for coefficient in &mut alm {
+        state ^= state << 13;
+        state ^= state >> 17;
+        state ^= state << 5;
+        coefficient.re = (state as f32 / u32::MAX as f32) * 2.0 - 1.0;
+    }
+
+    let mut map = vec![f32::NAN; plan.sample_count];
+    plan.synthesis_into(&alm, &mut map, &mut workspace).unwrap();
+    let first_map = map.clone();
+    map.fill(f32::NAN);
+    plan.synthesis_into(&alm, &mut map, &mut workspace).unwrap();
+    assert_eq!(
+        map, first_map,
+        "zonal workspace reset must be deterministic"
+    );
+
+    let mut maximum_absolute_error = 0.0_f64;
+    let mut maximum_scaled_error = 0.0_f64;
+    let sectoral_norm = crate::legendre::sectoral_normalizations::<f64>(0).unwrap()[0];
+    for (ring, &theta) in grid.theta().iter().enumerate() {
+        let cosine = theta.cos();
+        let mut ring_sum = 0.0_f64;
+        let mut ring_previous = 0.0_f64;
+        let mut ring_current = sectoral_norm;
+        for (degree, coefficient) in alm.iter().take(lmax + 1).enumerate() {
+            ring_sum = f64::from(coefficient.re).mul_add(ring_current, ring_sum);
+            if degree < lmax {
+                let epsilon = crate::legendre::epsilon::<f64>(degree, 0);
+                let next_epsilon = crate::legendre::epsilon::<f64>(degree + 1, 0);
+                let next = (cosine * ring_current - epsilon * ring_previous) / next_epsilon;
+                ring_previous = ring_current;
+                ring_current = next;
+            }
+        }
+        let absolute_error = (f64::from(map[ring]) - ring_sum).abs();
+        maximum_absolute_error = maximum_absolute_error.max(absolute_error);
+        maximum_scaled_error = maximum_scaled_error.max(absolute_error / (1.0 + ring_sum.abs()));
+    }
+    eprintln!(
+        "mixed-coefficient zonal max abs error={maximum_absolute_error:.3e}, max scaled error={maximum_scaled_error:.3e}"
+    );
+    assert!(maximum_scaled_error <= 2.0e-7);
+
+    let mut recovered = vec![Complex32::new(f32::NAN, f32::NAN); harmonics.nalm()];
+    plan.analysis_into(&map, &mut recovered, &mut workspace)
+        .unwrap();
+    for (degree, (actual, expected)) in recovered.iter().zip(&alm).enumerate() {
+        assert!(actual.re.is_finite() && actual.im.is_finite());
+        assert!(
+            (actual.re - expected.re).abs() <= 2.0e-3,
+            "zonal adjoint recovery at degree {degree}: {} vs {}",
+            actual.re,
+            expected.re
+        );
+    }
+}
