+#[derive(Clone, Copy)]
+struct DoubleSingleF32Vector<S: Simd> {
+    high: S::f32s,
+    low: S::f32s,
+}
+
+#[inline(always)]
+fn ds_vector_renormalize<S: Simd>(
+    simd: S,
+    high: S::f32s,
+    low: S::f32s,
+) -> DoubleSingleF32Vector<S> {
+    let sum = simd.add_f32s(high, low);
+    let virtual_low = simd.sub_f32s(sum, high);
+    let error = simd.add_f32s(
+        simd.sub_f32s(high, simd.sub_f32s(sum, virtual_low)),
+        simd.sub_f32s(low, virtual_low),
+    );
+    DoubleSingleF32Vector {
+        high: sum,
+        low: error,
+    }
+}
