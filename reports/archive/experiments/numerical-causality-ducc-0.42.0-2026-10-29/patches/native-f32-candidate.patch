+#[inline(always)]
+fn ds_vector_add<S: Simd>(
+    simd: S,
+    left: DoubleSingleF32Vector<S>,
+    right: DoubleSingleF32Vector<S>,
+) -> DoubleSingleF32Vector<S> {
+    let sum = simd.add_f32s(left.high, right.high);
+    let virtual_right = simd.sub_f32s(sum, left.high);
+    let high_error = simd.add_f32s(
+        simd.sub_f32s(left.high, simd.sub_f32s(sum, virtual_right)),
+        simd.sub_f32s(right.high, virtual_right),
+    );
+    let low_error = simd.add_f32s(left.low, right.low);
+    ds_vector_renormalize(simd, sum, simd.add_f32s(high_error, low_error))
+}
+
+#[inline(always)]
+fn ds_vector_mul<S: Simd>(
+    simd: S,
+    left: DoubleSingleF32Vector<S>,
+    right: DoubleSingleF32Vector<S>,
+) -> DoubleSingleF32Vector<S> {
+    let product = simd.mul_f32s(left.high, right.high);
+    let residual = simd.add_f32s(
+        simd.mul_add_f32s(left.high, right.high, simd.neg_f32s(product)),
+        simd.add_f32s(
+            simd.mul_f32s(left.high, right.low),
+            simd.mul_f32s(left.low, right.high),
+        ),
+    );
+    ds_vector_renormalize(simd, product, residual)
+}
+
+#[inline(always)]
+fn ds_vector_sub<S: Simd>(
