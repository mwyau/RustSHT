+    let shift = simd.min_u32s(unbounded_shift, simd.splat_u32s(24));
+    let significand = simd.or_u32s(
+        simd.and_u32s(bits, simd.splat_u32s(0x007f_ffff)),
+        simd.splat_u32s(0x0080_0000),
+    );
