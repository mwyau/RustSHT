+fn f32_t720_zonal_near_pole_matches_wide_independent_recurrence() {
+    let lmax = 720;
+    let grid = GridSpec::new(GridKind::GaussLegendre, lmax + 1, 1, 0.0).unwrap();
+    let harmonics = HarmonicSpec::scalar(lmax, 0).unwrap();
+    let plan = ShtPlan::<f32>::new_with_legendre_reuse_estimate(
+        grid.clone(),
