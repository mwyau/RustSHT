+    let mut precombined_ns = Vec::with_capacity(15);
+    for pair in 0..15 {
+        let mut run = |mode: u8| {
+            let start = std::time::Instant::now();
+            for _ in 0..repetitions {
+                run_sweep(mode, &mut output);
+            }
+            std::hint::black_box(&output);
+            start.elapsed().as_nanos()
+        };
+        let mut timings = [0_u128; 4];
+        let start_mode = pair % 4;
+        for offset in 0..4 {
+            let mode = (start_mode + offset) % 4;
+            timings[mode] = run(match mode {
+                0 => 0,
+                1 => 1,
+                2 => 3,
+                _ => 5,
+            });
+        }
+        baseline_ns.push(timings[0]);
+        residual_ns.push(timings[1]);
+        split_ns.push(timings[2]);
+        precombined_ns.push(timings[3]);
+        residual_ratios.push(timings[1] as f64 / timings[0] as f64);
+        split_ratios.push(timings[2] as f64 / timings[0] as f64);
+        precombined_ratios.push(timings[3] as f64 / timings[0] as f64);
+    }
+    residual_ratios.sort_by(f64::total_cmp);
+    split_ratios.sort_by(f64::total_cmp);
+    precombined_ratios.sort_by(f64::total_cmp);
