+            let factor_a = DoubleSingleF32Vector {
+                high: simd.splat_f32s(geometry.factor_a.high[pair]),
+                low: simd.splat_f32s(geometry.factor_a.low[pair]),
+            };
+            let factor_b = DoubleSingleF32Vector {
+                high: simd.splat_f32s(geometry.factor_b.high[pair]),
+                low: simd.splat_f32s(geometry.factor_b.low[pair]),
+            };
+            let leading = ds_vector_add(
+                simd,
+                ds_vector_mul(simd, factor_a, cosine_squared),
+                factor_b,
+            );
+            let next = ds_vector_add(simd, ds_vector_mul(simd, leading, current), previous);
+            previous = current;
+            current = next;
+        }
+    }
+
+    let odd_contribution = ds_vector_mul(simd, cosine, odd_sum);
+    let north = ds_vector_add(simd, even_sum, odd_contribution);
+    let south = ds_vector_sub(simd, even_sum, odd_contribution);
+    simd.partial_store_f32s(north_output, simd.add_f32s(north.high, north.low));
+    simd.partial_store_f32s(south_output, simd.add_f32s(south.high, south.low));
+    north_output[..active_lanes]
+        .iter()
+        .chain(&south_output[..active_lanes])
+        .all(|value| value.is_finite())
+}
+
+#[inline(always)]
+fn ds_vector_normal_or_zero<S: Simd>(simd: S, value: DoubleSingleF32Vector<S>) -> bool {
+    let zero = simd.splat_f32s(0.0);
+    let minimum = simd.splat_f32s(f32::MIN_POSITIVE);
+    let maximum = simd.splat_f32s(f32::MAX);
+    let high_abs = simd.abs_f32s(value.high);
+    let low_abs = simd.abs_f32s(value.low);
+    let high_valid = simd.and_m32s(
+        simd.less_than_or_equal_f32s(high_abs, maximum),
+        simd.or_m32s(
+            simd.equal_f32s(high_abs, zero),
+            simd.greater_than_or_equal_f32s(high_abs, minimum),
+        ),
+    );
+    let low_valid = simd.and_m32s(
+        simd.less_than_or_equal_f32s(low_abs, maximum),
+        simd.or_m32s(
+            simd.equal_f32s(low_abs, zero),
+            simd.greater_than_or_equal_f32s(low_abs, minimum),
+        ),
+    );
+    let valid = simd.and_m32s(high_valid, low_valid);
+    simd.first_true_m32s(simd.not_m32s(valid)) == S::F32_LANES
+}
+
+#[inline(always)]
+fn ds_vector_nonzero<S: Simd>(simd: S, value: DoubleSingleF32Vector<S>) -> S::m32s {
+    let zero = simd.splat_f32s(0.0);
+    let high_nonzero = simd.not_m32s(simd.equal_f32s(simd.abs_f32s(value.high), zero));
+    let low_nonzero = simd.not_m32s(simd.equal_f32s(simd.abs_f32s(value.low), zero));
+    simd.or_m32s(high_nonzero, low_nonzero)
+}
+
+#[inline(always)]
+fn ds_vector_checked_mul<S: Simd>(
+    simd: S,
+    left: DoubleSingleF32Vector<S>,
+    right: DoubleSingleF32Vector<S>,
+) -> Option<DoubleSingleF32Vector<S>> {
+    let product = ds_vector_mul(simd, left, right);
+    let product_is_zero = simd.and_m32s(
+        simd.equal_f32s(simd.abs_f32s(product.high), simd.splat_f32s(0.0)),
+        simd.equal_f32s(simd.abs_f32s(product.low), simd.splat_f32s(0.0)),
+    );
+    let nonzero_operands = simd.and_m32s(
+        ds_vector_nonzero(simd, left),
+        ds_vector_nonzero(simd, right),
+    );
+    let underflowed = simd.and_m32s(nonzero_operands, product_is_zero);
+    if simd.first_true_m32s(underflowed) != S::F32_LANES || !ds_vector_normal_or_zero(simd, product)
+    {
+        None
+    } else {
+        Some(product)
+    }
+}
+
+#[inline(always)]
+fn ds_vector_checked_add<S: Simd>(
+    simd: S,
+    left: DoubleSingleF32Vector<S>,
+    right: DoubleSingleF32Vector<S>,
+) -> Option<DoubleSingleF32Vector<S>> {
+    let sum = ds_vector_add(simd, left, right);
+    let sum_is_zero = simd.and_m32s(
+        simd.equal_f32s(simd.abs_f32s(sum.high), simd.splat_f32s(0.0)),
+        simd.equal_f32s(simd.abs_f32s(sum.low), simd.splat_f32s(0.0)),
+    );
+    let nonzero_operands = simd.and_m32s(
+        ds_vector_nonzero(simd, left),
+        ds_vector_nonzero(simd, right),
+    );
+    let underflowed = simd.and_m32s(nonzero_operands, sum_is_zero);
+    if simd.first_true_m32s(underflowed) != S::F32_LANES || !ds_vector_normal_or_zero(simd, sum) {
+        None
+    } else {
+        Some(sum)
+    }
+}
+
+#[inline(always)]
+fn ds_vector_checked_sub<S: Simd>(
+    simd: S,
+    left: DoubleSingleF32Vector<S>,
+    right: DoubleSingleF32Vector<S>,
+) -> Option<DoubleSingleF32Vector<S>> {
+    ds_vector_checked_add(
+        simd,
+        left,
+        DoubleSingleF32Vector {
+            high: simd.neg_f32s(right.high),
+            low: simd.neg_f32s(right.low),
+        },
+    )
+}
+
+#[expect(
+    clippy::too_many_arguments,
+    reason = "The test candidate low-order leaf receives setup, paired coefficients, and reflected complex outputs."
+)]
+pub(super) fn low_order_double_single_batch_f32<S: Simd>(
+    simd: S,
+    m: usize,
+    lmax: usize,
+    coefficient_even: &[Complex<f32>],
+    coefficient_odd: &[Complex<f32>],
+    geometry: LowOrderDoubleSingleView<'_, f32>,
+    ring_start: usize,
+    active_lanes: usize,
+    north_real: &mut [f32],
+    north_imag: &mut [f32],
+    south_real: &mut [f32],
+    south_imag: &mut [f32],
+) -> bool {
+    let lanes = S::F32_LANES;
+    let Some(pair_count) = lmax
+        .checked_sub(m)
+        .and_then(|count| count.checked_add(2))
+        .map(|count| count / 2)
+    else {
+        return false;
+    };
+    if !(1..=2).contains(&m)
+        || lanes == 0
+        || active_lanes == 0
+        || active_lanes > lanes
+        || north_real.len() < active_lanes
+        || north_imag.len() < active_lanes
+        || south_real.len() < active_lanes
+        || south_imag.len() < active_lanes
+        || coefficient_even.len() < pair_count
+        || coefficient_odd.len() < pair_count
+        || geometry.factor_a.high.len() != pair_count
+        || geometry.factor_a.low.len() != pair_count
+        || geometry.factor_b.high.len() != pair_count
+        || geometry.factor_b.low.len() != pair_count
+        || geometry.sectoral_seed.high.len() != geometry.cos_theta.high.len()
+        || geometry.sectoral_seed.low.len() != geometry.cos_theta.low.len()
+        || geometry.cos_theta.high.len() != geometry.cos_theta.low.len()
+        || geometry.cos_theta_squared.high.len() != geometry.cos_theta_squared.low.len()
+        || ring_start
+            .checked_add(active_lanes)
+            .is_none_or(|end| end > geometry.cos_theta.high.len())
+    {
+        return false;
+    }
+    let ring_end = ring_start + active_lanes;
+    let finite = geometry.cos_theta.high[ring_start..ring_end]
+        .iter()
+        .chain(&geometry.cos_theta.low[ring_start..ring_end])
+        .chain(&geometry.cos_theta_squared.high[ring_start..ring_end])
+        .chain(&geometry.cos_theta_squared.low[ring_start..ring_end])
+        .chain(&geometry.sectoral_seed.high[ring_start..ring_end])
+        .chain(&geometry.sectoral_seed.low[ring_start..ring_end])
+        .all(|value| value.is_finite());
+    if !finite
+        || coefficient_even[..pair_count]
+            .iter()
+            .chain(&coefficient_odd[..pair_count])
+            .any(|value| !value.re.is_finite() || !value.im.is_finite())
+    {
+        return false;
+    }
+
+    let cosine = DoubleSingleF32Vector {
+        high: simd.partial_load_f32s(&geometry.cos_theta.high[ring_start..]),
+        low: simd.partial_load_f32s(&geometry.cos_theta.low[ring_start..]),
+    };
+    let cosine_squared = DoubleSingleF32Vector {
+        high: simd.partial_load_f32s(&geometry.cos_theta_squared.high[ring_start..]),
+        low: simd.partial_load_f32s(&geometry.cos_theta_squared.low[ring_start..]),
+    };
+    let mut previous = DoubleSingleF32Vector {
+        high: simd.splat_f32s(0.0),
+        low: simd.splat_f32s(0.0),
+    };
+    let mut current = DoubleSingleF32Vector {
+        high: simd.partial_load_f32s(&geometry.sectoral_seed.high[ring_start..]),
+        low: simd.partial_load_f32s(&geometry.sectoral_seed.low[ring_start..]),
+    };
+    let mut even_re = previous;
+    let mut even_im = previous;
+    let mut odd_re = previous;
+    let mut odd_im = previous;
+    if !ds_vector_normal_or_zero(simd, current) {
+        return false;
+    }
+
+    for pair in 0..pair_count {
+        let even_re_coefficient = DoubleSingleF32Vector {
+            high: simd.splat_f32s(coefficient_even[pair].re),
+            low: simd.splat_f32s(0.0),
+        };
+        let even_im_coefficient = DoubleSingleF32Vector {
+            high: simd.splat_f32s(coefficient_even[pair].im),
+            low: simd.splat_f32s(0.0),
+        };
+        let odd_re_coefficient = DoubleSingleF32Vector {
+            high: simd.splat_f32s(coefficient_odd[pair].re),
+            low: simd.splat_f32s(0.0),
+        };
+        let odd_im_coefficient = DoubleSingleF32Vector {
+            high: simd.splat_f32s(coefficient_odd[pair].im),
+            low: simd.splat_f32s(0.0),
+        };
+        let Some(term) = ds_vector_checked_mul(simd, current, even_re_coefficient) else {
+            return false;
+        };
+        let Some(next) = ds_vector_checked_add(simd, even_re, term) else {
+            return false;
+        };
+        even_re = next;
+        let Some(term) = ds_vector_checked_mul(simd, current, even_im_coefficient) else {
+            return false;
+        };
+        let Some(next) = ds_vector_checked_add(simd, even_im, term) else {
+            return false;
+        };
+        even_im = next;
+        let Some(term) = ds_vector_checked_mul(simd, current, odd_re_coefficient) else {
+            return false;
+        };
+        let Some(next) = ds_vector_checked_add(simd, odd_re, term) else {
+            return false;
+        };
+        odd_re = next;
+        let Some(term) = ds_vector_checked_mul(simd, current, odd_im_coefficient) else {
+            return false;
+        };
+        let Some(next) = ds_vector_checked_add(simd, odd_im, term) else {
+            return false;
+        };
+        odd_im = next;
+
+        if pair + 1 < pair_count {
+            let factor_a = DoubleSingleF32Vector {
+                high: simd.splat_f32s(geometry.factor_a.high[pair]),
+                low: simd.splat_f32s(geometry.factor_a.low[pair]),
+            };
+            let factor_b = DoubleSingleF32Vector {
+                high: simd.splat_f32s(geometry.factor_b.high[pair]),
+                low: simd.splat_f32s(geometry.factor_b.low[pair]),
+            };
+            let Some(product) = ds_vector_checked_mul(simd, factor_a, cosine_squared) else {
+                return false;
+            };
+            let Some(leading) = ds_vector_checked_add(simd, product, factor_b) else {
+                return false;
+            };
+            let Some(product) = ds_vector_checked_mul(simd, leading, current) else {
+                return false;
+            };
+            let Some(next) = ds_vector_checked_add(simd, product, previous) else {
+                return false;
+            };
+            previous = current;
+            current = next;
+        }
+    }
+
+    let Some(odd_re) = ds_vector_checked_mul(simd, cosine, odd_re) else {
+        return false;
+    };
+    let Some(odd_im) = ds_vector_checked_mul(simd, cosine, odd_im) else {
+        return false;
+    };
+    let Some(north_re_value) = ds_vector_checked_add(simd, even_re, odd_re) else {
+        return false;
+    };
+    let Some(south_re_value) = ds_vector_checked_sub(simd, even_re, odd_re) else {
+        return false;
+    };
+    let Some(north_im_value) = ds_vector_checked_add(simd, even_im, odd_im) else {
+        return false;
+    };
+    let Some(south_im_value) = ds_vector_checked_sub(simd, even_im, odd_im) else {
+        return false;
+    };
+    simd.partial_store_f32s(
+        north_real,
+        simd.add_f32s(north_re_value.high, north_re_value.low),
+    );
+    simd.partial_store_f32s(
+        north_imag,
+        simd.add_f32s(north_im_value.high, north_im_value.low),
+    );
+    simd.partial_store_f32s(
+        south_real,
+        simd.add_f32s(south_re_value.high, south_re_value.low),
+    );
+    simd.partial_store_f32s(
+        south_imag,
+        simd.add_f32s(south_im_value.high, south_im_value.low),
+    );
+    north_real[..active_lanes]
+        .iter()
+        .all(|value| value.is_finite())
+        && north_imag[..active_lanes]
+            .iter()
+            .all(|value| value.is_finite())
+        && south_real[..active_lanes]
+            .iter()
+            .all(|value| value.is_finite())
+        && south_imag[..active_lanes]
+            .iter()
+            .all(|value| value.is_finite())
+}
+
