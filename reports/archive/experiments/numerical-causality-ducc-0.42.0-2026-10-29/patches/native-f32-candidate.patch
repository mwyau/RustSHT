+        };
+        counter.fetch_add(1, Ordering::Relaxed);
+    }
+
+    pub(super) fn record_shared_basis_zero_group() {
+        SHARED_BASIS_ZERO_GROUPS.fetch_add(1, Ordering::Relaxed);
+    }
+
+    pub(super) fn record_shared_basis_zero_shortcut() {
+        SHARED_BASIS_ZERO_SHORTCUTS.fetch_add(1, Ordering::Relaxed);
+    }
+
+    pub(super) fn record_uniform_scale_vector_update() {
