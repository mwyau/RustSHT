+                .unwrap_or_else(|poisoned| poisoned.into_inner())
+                .push(observation);
+        }
+    }
+
+    pub(super) fn record_ring_batch(output_ring_writes: usize) {
+        RING_BATCHES.fetch_add(1, Ordering::Relaxed);
