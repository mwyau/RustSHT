+fn low_order_double_single_geometry<T: ShtScalar>(
+    m: usize,
+    lmax: usize,
+    ring_count: usize,
+) -> Result<LowOrderDoubleSingleGeometry<T>, ShtError> {
+    let pair_count = lmax
+        .checked_sub(m)
+        .and_then(|count| count.checked_add(2))
+        .map(|count| count / 2)
+        .ok_or(ShtError::IntegerOverflow {
+            quantity: "low-order recurrence pair count",
+        })?;
+    let mut geometry = LowOrderDoubleSingleGeometry {
+        factor_a: DoubleSingleArray::zeroed(pair_count, "low-order factor-a high/low cache")?,
+        factor_b: DoubleSingleArray::zeroed(pair_count, "low-order factor-b high/low cache")?,
+        sectoral_seed: DoubleSingleArray::zeroed(
+            ring_count,
+            "low-order sectoral-seed high/low cache",
+        )?,
+    };
+    let epsilon = |degree: usize| {
+        let degree = degree as f64;
+        let order = m as f64;
+        (((degree - order) * (degree + order)) / ((2.0 * degree + 1.0) * (2.0 * degree - 1.0)))
+            .sqrt()
+    };
+    let mut alpha = 1.0 / epsilon(m + 1);
+    let alpha_one = epsilon(m + 1) / (epsilon(m + 2) * epsilon(m + 3));
+    for pair in 0..pair_count {
+        if pair == 1 {
+            alpha = alpha_one;
+        } else if pair >= 2 {
+            let degree = m + pair * 2;
+            let sign = if (pair - 1).is_multiple_of(2) {
+                1.0
+            } else {
+                -1.0
+            };
+            alpha = sign / (epsilon(degree) * epsilon(degree + 1) * alpha);
+        }
+        let degree = m + pair * 2;
+        let sign = if pair.is_multiple_of(2) { 1.0 } else { -1.0 };
+        let factor_a = sign * alpha * alpha;
+        let factor_b = -factor_a * (epsilon(degree + 2).powi(2) + epsilon(degree + 1).powi(2));
+        geometry.factor_a.set_split(pair, factor_a);
+        geometry.factor_b.set_split(pair, factor_b);
+    }
+    Ok(geometry)
 }
 
