+    )
+    .unwrap();
+    let mut workspace = plan.workspace().unwrap();
+    plan.prepare_workspace(&mut workspace, 1).unwrap();
+    let mut alm = vec![Complex32::new(0.0, 0.0); harmonics.nalm()];
+    alm[harmonics.index(lmax, 0).unwrap()].re = 1.0;
+
+    let mut raw_workspace = plan.workspace().unwrap();
+    plan.prepare_workspace(&mut raw_workspace, 1).unwrap();
+    for (ring, &theta) in grid.theta().iter().enumerate() {
+        (raw_workspace.theta_sin[ring], raw_workspace.theta_cos[ring]) =
+            crate::legendre::sin_cos_from_f64(theta);
+        raw_workspace.ring_order_limits[ring] =
+            <f32 as crate::legendre::ShtScalar>::polar_order_limit(
+                lmax,
+                0,
+                raw_workspace.theta_sin[ring],
+                raw_workspace.theta_cos[ring],
+            );
+    }
+    assert!(
+        <f32 as crate::legendre::ShtScalar>::synthesize_scalar_ordered_dispatched(
+            pulp::Arch::new(),
+            &alm,
+            lmax,
+            0,
+            None,
+            1,
+            1,
+            0.0,
+            &plan.sectoral_norms,
+            &raw_workspace.theta_sin[..lmax + 1],
+            &raw_workspace.theta_cos[..lmax + 1],
+            &raw_workspace.ring_order_limits[..lmax + 1],
+            &mut raw_workspace.spectra,
+            &mut scalar_ordered_scratch(&mut raw_workspace.recurrence_workers[0]),
+        )
+    );
+    let raw_spectrum = raw_workspace.spectra.clone();
+
+    let mut map = vec![f32::NAN; plan.sample_count];
+    plan.synthesis_into(&alm, &mut map, &mut workspace).unwrap();
+
+    let zonal_value = |cosine: f64| {
+        let mut previous = 0.0_f64;
+        let mut current = crate::legendre::sectoral_normalizations::<f64>(0).unwrap()[0];
+        for degree in 0..lmax {
+            let epsilon = crate::legendre::epsilon::<f64>(degree, 0);
+            let next_epsilon = crate::legendre::epsilon::<f64>(degree + 1, 0);
+            let next = (cosine * current - epsilon * previous) / next_epsilon;
+            previous = current;
+            current = next;
+        }
+        current
+    };
+    let mut raw_max_error = 0.0_f64;
+    let mut refined_max_error = 0.0_f64;
+    let mut raw_errors = Vec::with_capacity(grid.theta().len());
+    for (ring, &theta) in grid.theta().iter().enumerate() {
+        let reference = zonal_value(theta.cos());
+        let raw_error = (f64::from(raw_spectrum[ring].re) - reference).abs();
+        raw_errors.push(raw_error);
+        raw_max_error = raw_max_error.max(raw_error);
+        refined_max_error = refined_max_error.max((f64::from(map[ring]) - reference).abs());
+    }
+    for threshold in [1.0e-7, 1.0e-6, 1.0e-5, 1.0e-4, 1.0e-3] {
+        let exceeding: Vec<_> = raw_errors
+            .iter()
+            .enumerate()
+            .filter_map(|(ring, error)| (*error > threshold).then_some(ring))
+            .collect();
+        eprintln!(
+            "raw zonal errors >{threshold:.0e}: count={}, first={:?}, last={:?}",
+            exceeding.len(),
+            exceeding.first(),
+            exceeding.last()
+        );
+    }
+    for cosine_cutoff in [0.99, 0.999, 0.9999, 0.99999, 0.999999] {
+        let remaining_max = grid
+            .theta()
+            .iter()
+            .zip(&raw_errors)
+            .filter_map(|(&theta, &error)| (theta.cos().abs() < cosine_cutoff).then_some(error))
+            .fold(0.0_f64, f64::max);
+        eprintln!("raw zonal max outside |cos(theta)|>{cosine_cutoff}: {remaining_max:.3e}");
+    }
+    eprintln!(
+        "f32 T720 zonal sweep: raw_max_abs={raw_max_error:.3e}, refined_max_abs={refined_max_error:.3e}"
+    );
+    assert!(
+        raw_max_error > 1.0e-6,
+        "raw f32 path unexpectedly passed this stress input"
+    );
+    assert!(
+        refined_max_error <= 2.0e-7,
+        "refined maximum error={refined_max_error:.3e}"
+    );
+
+    let cosine = grid.theta()[0].cos();
+    let reference = zonal_value(cosine);
+    let actual = f64::from(map[0]);
+    let absolute_error = (actual - reference).abs();
+    eprintln!(
+        "f32 T720 zonal near-pole: actual={actual:.17}, reference={reference:.17}, abs_error={absolute_error:.3e}"
+    );
+    assert!(
+        absolute_error <= 2.0e-7,
+        "near-pole zonal error={absolute_error:.3e}, actual={actual:.17}, reference={reference:.17}"
+    );
+    assert!(map.iter().all(|value| value.is_finite()));
+}
