+            &INITIAL_SCALED_LANES,
+            &SCALED_BATCHES,
+            &SCALED_PAIR_UPDATES,
+            &UNIFORM_SCALE_UPDATES,
+            &UNIFORM_SCALE_MINUS_ONE_UPDATES,
+            &UNIFORM_SCALE_VECTOR_UPDATES,
