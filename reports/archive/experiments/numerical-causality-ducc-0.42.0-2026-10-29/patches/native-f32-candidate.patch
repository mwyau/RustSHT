+fn coefficients_allow_shared_basis<T: OrderedSimdPrecision>(
+    even: &[Complex<T>],
+    odd: &[Complex<T>],
+) -> bool {
+    even.iter().chain(odd).all(|coefficient| {
+        [coefficient.re, coefficient.im]
+            .into_iter()
+            .all(|value| value.is_finite() && value.abs() <= T::one())
+    })
+}
