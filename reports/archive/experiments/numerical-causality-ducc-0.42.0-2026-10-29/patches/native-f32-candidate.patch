+/// Typed SIMD leaves for the shared order-major scalar synthesis kernel.
+///
+/// The recurrence, scaling state machine, and reflected-ring traversal are
+/// generic over this trait. Its implementations only select native vector
+/// width, lane operations, and precision-specific range constants.
+pub(crate) trait OrderedSimdPrecision: LegendrePrecision {
+    type Vector<S: Simd>: Copy;
+    type Mask<S: Simd>: Copy;
+
+    const PREPARE_ORDER_CONSTANTS_IN_F64: bool;
+    const USE_SHARED_SCALED_BASIS_PREFIX: bool;
+    const SHARED_PREFIX_BATCH: bool;
+    const SKIP_SCALED_PREFIX: bool;
+    const TRACK_RESIDUAL_RECURRENCE: bool;
+    const SCALE_FTOL: Self;
+    const MAX_FINITE: Self;
+    const MIN_POSITIVE: Self;
+    /// Largest negative scale count that always restores a value bounded by
+    /// `SCALE_FTOL` to signed zero in shared-basis accumulation.
+    const SHARED_BASIS_ZERO_SCALE_LIMIT: i64;
+    const REFLECTION_TOLERANCE: Self;
+    const SYNTHESIS_FACTOR_LIMIT: Self;
+
+    fn lane_count<S: Simd>() -> usize;
+    fn as_simd<S: Simd>(values: &[Self]) -> (&[Self::Vector<S>], &[Self]);
+    fn as_mut_simd<S: Simd>(values: &mut [Self]) -> (&mut [Self::Vector<S>], &mut [Self]);
+    fn splat<S: Simd>(simd: S, value: Self) -> Self::Vector<S>;
+    fn vadd<S: Simd>(simd: S, left: Self::Vector<S>, right: Self::Vector<S>) -> Self::Vector<S>;
+    fn vsub<S: Simd>(simd: S, left: Self::Vector<S>, right: Self::Vector<S>) -> Self::Vector<S>;
+    fn vneg<S: Simd>(simd: S, value: Self::Vector<S>) -> Self::Vector<S>;
+    fn vmul<S: Simd>(simd: S, left: Self::Vector<S>, right: Self::Vector<S>) -> Self::Vector<S>;
+    fn vmul_add<S: Simd>(
+        simd: S,
+        left: Self::Vector<S>,
+        right: Self::Vector<S>,
+        addend: Self::Vector<S>,
+    ) -> Self::Vector<S>;
+    fn vabs<S: Simd>(simd: S, value: Self::Vector<S>) -> Self::Vector<S>;
+    fn less_equal<S: Simd>(simd: S, left: Self::Vector<S>, right: Self::Vector<S>)
+    -> Self::Mask<S>;
+    fn mask_not<S: Simd>(simd: S, value: Self::Mask<S>) -> Self::Mask<S>;
+    fn first_true<S: Simd>(simd: S, mask: Self::Mask<S>) -> usize;
+    fn scale_binary(value: Self, exponent: i64) -> Self;
+    fn scale_binary_uniform<S: Simd>(
+        simd: S,
+        values: &[Self],
+        output: &mut [Self],
+        exponent: i64,
+    ) -> bool;
+    fn initialize_sectoral_batch<S: Simd>(
+        simd: S,
+        sine: &[Self],
+        values: &mut [Self],
+        scales: &mut [i64],
+        exponent: usize,
+        lower_limit: Self,
+        factor_value: Self,
+    ) -> bool;
+    #[expect(
+        clippy::too_many_arguments,
+        reason = "The scaled-prefix leaf advances one packed order's recurrence and scale state."
+    )]
+    fn skip_scaled_prefix<S: Simd>(
+        simd: S,
+        m: usize,
+        lmax: usize,
+        pair_count: usize,
+        csq: &[Self],
+        coefficient_a: &[Self],
+        coefficient_b: &[Self],
+        previous: &mut [Self],
+        current: &mut [Self],
+        scale: &mut [i64],
+    ) -> Option<(usize, usize, bool)>;
+
+    #[expect(
+        clippy::too_many_arguments,
+        reason = "The zonal recurrence receives its coefficients, prepared constants, and reflected output lanes."
+    )]
+    fn synthesize_zonal_double_single_batch<S: Simd>(
+        simd: S,
+        coefficients: &[num_complex::Complex<Self>],
+        lmax: usize,
+        sectoral_norm: Self,
+        geometry: ZonalDoubleSingleView<'_, Self>,
+        ring_start: usize,
+        active_lanes: usize,
+        north_output: &mut [Self],
+        south_output: &mut [Self],
+    ) -> bool;
+
+    #[expect(
+        clippy::too_many_arguments,
+        reason = "The low-order leaf receives paired coefficients and four reflected complex outputs."
+    )]
+    fn synthesize_low_order_double_single_batch<S: Simd>(
+        simd: S,
+        m: usize,
+        lmax: usize,
+        coefficient_even: &[num_complex::Complex<Self>],
+        coefficient_odd: &[num_complex::Complex<Self>],
+        geometry: LowOrderDoubleSingleView<'_, Self>,
+        ring_start: usize,
+        active_lanes: usize,
+        north_real: &mut [Self],
+        north_imag: &mut [Self],
+        south_real: &mut [Self],
+        south_imag: &mut [Self],
+    ) -> bool;
+
+    #[inline(always)]
+    fn mask_all<S: Simd>(simd: S, mask: Self::Mask<S>) -> bool {
+        Self::first_true(simd, Self::mask_not(simd, mask)) == Self::lane_count::<S>()
+    }
+}
+
+macro_rules! impl_ordered_simd_precision {
+    (
+        $scalar:ty, $vector:ident, $mask:ident, $lanes:ident,
+        $as_simd:ident, $as_mut_simd:ident, $splat:ident,
+        $add:ident, $sub:ident, $neg:ident, $mul:ident, $mul_add:ident, $abs:ident, $less_equal:ident,
+        $mask_not:ident, $first_true:ident, $scale_binary:ident, $initialize_batch:ident,
+        $scale_binary_uniform:ident,
+        $prepare_order_constants_in_f64:expr, $use_shared_scaled_basis_prefix:expr,
+        $shared_prefix_batch:expr, $skip_scaled_prefix:expr, $track_residual_recurrence:expr,
+        $skip_prefix:ident, $zonal_batch:ident,
+        $low_order_batch:ident,
+        $shared_basis_zero_scale_limit:expr,
+        $ftol:expr, $max_finite:expr, $min_positive:expr,
+        $reflection_tolerance:expr, $synthesis_factor_limit:expr $(,)?
+    ) => {
+        impl OrderedSimdPrecision for $scalar {
+            type Vector<S: Simd> = S::$vector;
+            type Mask<S: Simd> = S::$mask;
+
+            const PREPARE_ORDER_CONSTANTS_IN_F64: bool = $prepare_order_constants_in_f64;
+            const USE_SHARED_SCALED_BASIS_PREFIX: bool = $use_shared_scaled_basis_prefix;
+            const SHARED_PREFIX_BATCH: bool = $shared_prefix_batch;
+            const SKIP_SCALED_PREFIX: bool = $skip_scaled_prefix;
+            const TRACK_RESIDUAL_RECURRENCE: bool = $track_residual_recurrence;
+            const SCALE_FTOL: Self = $ftol;
+            const MAX_FINITE: Self = $max_finite;
+            const MIN_POSITIVE: Self = $min_positive;
+            const SHARED_BASIS_ZERO_SCALE_LIMIT: i64 = $shared_basis_zero_scale_limit;
+            const REFLECTION_TOLERANCE: Self = $reflection_tolerance;
+            const SYNTHESIS_FACTOR_LIMIT: Self = $synthesis_factor_limit;
+
+            #[inline(always)]
+            fn lane_count<S: Simd>() -> usize {
+                S::$lanes
+            }
+            #[inline(always)]
+            fn as_simd<S: Simd>(values: &[Self]) -> (&[Self::Vector<S>], &[Self]) {
+                S::$as_simd(values)
+            }
+            #[inline(always)]
+            fn as_mut_simd<S: Simd>(values: &mut [Self]) -> (&mut [Self::Vector<S>], &mut [Self]) {
+                S::$as_mut_simd(values)
+            }
+            #[inline(always)]
+            fn splat<S: Simd>(simd: S, value: Self) -> Self::Vector<S> {
+                simd.$splat(value)
+            }
+            #[inline(always)]
+            fn vadd<S: Simd>(
+                simd: S,
+                left: Self::Vector<S>,
+                right: Self::Vector<S>,
+            ) -> Self::Vector<S> {
+                simd.$add(left, right)
+            }
+            #[inline(always)]
+            fn vsub<S: Simd>(
+                simd: S,
+                left: Self::Vector<S>,
+                right: Self::Vector<S>,
+            ) -> Self::Vector<S> {
+                simd.$sub(left, right)
+            }
+            #[inline(always)]
+            fn vneg<S: Simd>(simd: S, value: Self::Vector<S>) -> Self::Vector<S> {
+                simd.$neg(value)
+            }
+            #[inline(always)]
+            fn vmul<S: Simd>(
+                simd: S,
+                left: Self::Vector<S>,
+                right: Self::Vector<S>,
+            ) -> Self::Vector<S> {
+                simd.$mul(left, right)
+            }
+            #[inline(always)]
+            fn vmul_add<S: Simd>(
+                simd: S,
+                left: Self::Vector<S>,
+                right: Self::Vector<S>,
+                addend: Self::Vector<S>,
+            ) -> Self::Vector<S> {
+                simd.$mul_add(left, right, addend)
+            }
+            #[inline(always)]
+            fn vabs<S: Simd>(simd: S, value: Self::Vector<S>) -> Self::Vector<S> {
+                simd.$abs(value)
+            }
+            #[inline(always)]
+            fn less_equal<S: Simd>(
+                simd: S,
+                left: Self::Vector<S>,
+                right: Self::Vector<S>,
+            ) -> Self::Mask<S> {
+                simd.$less_equal(left, right)
+            }
+            #[inline(always)]
+            fn mask_not<S: Simd>(simd: S, value: Self::Mask<S>) -> Self::Mask<S> {
+                simd.$mask_not(value)
+            }
+            #[inline(always)]
+            fn first_true<S: Simd>(simd: S, mask: Self::Mask<S>) -> usize {
+                simd.$first_true(mask)
+            }
+            #[inline(always)]
+            fn scale_binary(value: Self, exponent: i64) -> Self {
+                $scale_binary(value, exponent)
+            }
+            #[inline(always)]
+            fn scale_binary_uniform<S: Simd>(
+                simd: S,
+                values: &[Self],
+                output: &mut [Self],
+                exponent: i64,
+            ) -> bool {
+                $scale_binary_uniform(simd, values, output, exponent)
+            }
+            #[inline(always)]
+            fn initialize_sectoral_batch<S: Simd>(
+                simd: S,
+                sine: &[Self],
+                values: &mut [Self],
+                scales: &mut [i64],
+                exponent: usize,
+                lower_limit: Self,
+                factor_value: Self,
+            ) -> bool {
+                super::scalar_ordered::$initialize_batch::<S>(
+                    simd,
+                    sine,
+                    values,
+                    scales,
+                    exponent,
+                    lower_limit,
+                    factor_value,
+                )
+            }
+            #[inline(always)]
+            fn skip_scaled_prefix<S: Simd>(
+                simd: S,
+                m: usize,
+                lmax: usize,
+                pair_count: usize,
+                csq: &[Self],
+                coefficient_a: &[Self],
+                coefficient_b: &[Self],
+                previous: &mut [Self],
+                current: &mut [Self],
+                scale: &mut [i64],
+            ) -> Option<(usize, usize, bool)> {
+                super::scalar_ordered::$skip_prefix::<S>(
+                    simd,
+                    m,
+                    lmax,
+                    pair_count,
+                    csq,
+                    coefficient_a,
+                    coefficient_b,
+                    previous,
+                    current,
+                    scale,
+                )
+            }
+            #[inline(always)]
+            fn synthesize_zonal_double_single_batch<S: Simd>(
+                simd: S,
+                coefficients: &[num_complex::Complex<Self>],
+                lmax: usize,
+                sectoral_norm: Self,
+                geometry: ZonalDoubleSingleView<'_, Self>,
+                ring_start: usize,
+                active_lanes: usize,
+                north_output: &mut [Self],
+                south_output: &mut [Self],
+            ) -> bool {
+                super::scalar_ordered::$zonal_batch::<S>(
+                    simd,
+                    coefficients,
+                    lmax,
+                    sectoral_norm,
+                    geometry,
+                    ring_start,
+                    active_lanes,
+                    north_output,
+                    south_output,
+                )
+            }
+
+            #[inline(always)]
+            fn synthesize_low_order_double_single_batch<S: Simd>(
+                simd: S,
+                m: usize,
+                lmax: usize,
+                coefficient_even: &[num_complex::Complex<Self>],
+                coefficient_odd: &[num_complex::Complex<Self>],
+                geometry: LowOrderDoubleSingleView<'_, Self>,
+                ring_start: usize,
+                active_lanes: usize,
+                north_real: &mut [Self],
+                north_imag: &mut [Self],
+                south_real: &mut [Self],
+                south_imag: &mut [Self],
+            ) -> bool {
+                super::scalar_ordered::$low_order_batch::<S>(
+                    simd,
+                    m,
+                    lmax,
+                    coefficient_even,
+                    coefficient_odd,
+                    geometry,
+                    ring_start,
+                    active_lanes,
+                    north_real,
+                    north_imag,
+                    south_real,
+                    south_imag,
+                )
+            }
+        }
+    };
+}
+
+impl_ordered_simd_precision!(
+    f32,
+    f32s,
+    m32s,
+    F32_LANES,
+    as_simd_f32s,
+    as_mut_simd_f32s,
+    splat_f32s,
+    add_f32s,
+    sub_f32s,
+    neg_f32s,
+    mul_f32s,
+    mul_add_f32s,
+    abs_f32s,
+    less_than_or_equal_f32s,
+    not_m32s,
+    first_true_m32s,
+    scale_binary_f32,
+    initialize_sectoral_batch_f32,
+    scale_binary_f32_uniform,
+    true,
+    true,
+    false,
+    false,
+    false,
+    no_scaled_prefix_skip,
+    zonal_double_single_batch_f32,
+    low_order_double_single_batch_f32,
+    -2,
+    f32::from_bits(67_u32 << 23),
+    f32::MAX,
+    f32::MIN_POSITIVE,
+    2.0e-6_f32,
+    f32::from_bits(143_u32 << 23),
+);
+
+impl_ordered_simd_precision!(
+    f64,
+    f64s,
+    m64s,
+    F64_LANES,
+    as_simd_f64s,
+    as_mut_simd_f64s,
+    splat_f64s,
+    add_f64s,
+    sub_f64s,
+    neg_f64s,
+    mul_f64s,
+    mul_add_f64s,
