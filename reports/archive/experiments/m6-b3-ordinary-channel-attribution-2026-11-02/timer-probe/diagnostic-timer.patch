+#[cfg(rustsht_m6_b3_profile_ordinary_stages)]
+static M6_B3_SECOND_CHANNEL_NS: std::sync::atomic::AtomicU64 = std::sync::atomic::AtomicU64::new(0);
+#[cfg(rustsht_m6_b3_profile_ordinary_stages)]
+static M6_B3_RANGE_SCAN_NS: std::sync::atomic::AtomicU64 = std::sync::atomic::AtomicU64::new(0);
+#[cfg(rustsht_m6_b3_profile_ordinary_stages)]
+static M6_B3_PROFILE_GROUPS: std::sync::atomic::AtomicU64 = std::sync::atomic::AtomicU64::new(0);
+#[cfg(rustsht_m6_b3_profile_ordinary_stages)]
+static M6_B3_PROFILE_SAMPLED_CALLS: std::sync::atomic::AtomicU64 =
+    std::sync::atomic::AtomicU64::new(0);
+
+#[cfg(rustsht_m6_b3_profile_ordinary_stages)]
+pub(super) fn m6_b3_profile_reset() {
+    use std::sync::atomic::Ordering::Relaxed;
+    M6_B3_ORDINARY_RECURRENCE_FIRST_NS.store(0, Relaxed);
+    M6_B3_SECOND_CHANNEL_NS.store(0, Relaxed);
+    M6_B3_RANGE_SCAN_NS.store(0, Relaxed);
+    M6_B3_PROFILE_GROUPS.store(0, Relaxed);
+    M6_B3_PROFILE_SAMPLED_CALLS.store(0, Relaxed);
+}
+
+#[cfg(rustsht_m6_b3_profile_ordinary_stages)]
+pub(super) fn m6_b3_profile_snapshot() -> [u64; 5] {
+    use std::sync::atomic::Ordering::Relaxed;
+    [
+        M6_B3_ORDINARY_RECURRENCE_FIRST_NS.load(Relaxed),
+        M6_B3_SECOND_CHANNEL_NS.load(Relaxed),
+        M6_B3_RANGE_SCAN_NS.load(Relaxed),
+        M6_B3_PROFILE_GROUPS.load(Relaxed),
+        M6_B3_PROFILE_SAMPLED_CALLS.load(Relaxed),
+    ]
+}
+
+#[cfg(rustsht_m6_b3_profile_ordinary_stages)]
+struct M6B3OrdinaryStageSample {
+    enabled: bool,
+    recurrence_first_ns: u64,
+    second_channel_ns: u64,
+    range_scan_ns: u64,
+    groups: u64,
+}
+
+#[cfg(rustsht_m6_b3_profile_ordinary_stages)]
+impl M6B3OrdinaryStageSample {
+    fn new(enabled: bool) -> Self {
+        Self {
+            enabled,
+            recurrence_first_ns: 0,
+            second_channel_ns: 0,
+            range_scan_ns: 0,
+            groups: 0,
+        }
+    }
+}
+
+#[cfg(rustsht_m6_b3_profile_ordinary_stages)]
+impl Drop for M6B3OrdinaryStageSample {
+    fn drop(&mut self) {
+        use std::sync::atomic::Ordering::Relaxed;
+        if self.enabled {
+            M6_B3_ORDINARY_RECURRENCE_FIRST_NS.fetch_add(self.recurrence_first_ns, Relaxed);
+            M6_B3_SECOND_CHANNEL_NS.fetch_add(self.second_channel_ns, Relaxed);
+            M6_B3_RANGE_SCAN_NS.fetch_add(self.range_scan_ns, Relaxed);
+            M6_B3_PROFILE_GROUPS.fetch_add(self.groups, Relaxed);
+            M6_B3_PROFILE_SAMPLED_CALLS.fetch_add(1, Relaxed);
+        }
+    }
+}
