+
+    let Some(started) = started else { return };
+    let elapsed = started.elapsed().as_nanos().min(u64::MAX as u128) as u64;
+    let index = rayon::current_thread_index().unwrap_or(0).min(63);
+    let (counters, blocks) = if scaled {
