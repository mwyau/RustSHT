+            .collect::<Vec<_>>()
+    };
+    let map0 = read_map("RUSTSHT_M6_MAP0");
+    let map1 = read_map("RUSTSHT_M6_MAP1");
+    assert_eq!(map0.len(), ntheta * nphi);
+    assert_eq!(map1.len(), ntheta * nphi);
+    let plan: ShtPlan<f64> = ShtPlan::new(
+        GridSpec::new(GridKind::GaussLegendre, ntheta, nphi, 0.23).unwrap(),
+        HarmonicSpec::new(720, mmax, 1).unwrap(),
+    )
+    .unwrap();
+    let mut workspace = plan.workspace().unwrap();
+    plan.prepare_workspace(&mut workspace, q).unwrap();
+    let count = plan.harmonics().nalm();
+    let mut e = vec![Complex64::new(0.0, 0.0); count];
+    let mut b = vec![Complex64::new(0.0, 0.0); count];
+    plan.analysis_spin_into(&map0, &map1, &mut e, &mut b, &mut workspace)
+        .unwrap();
+    let mut plain_wall_ns = Vec::new();
+    for _ in 0..3 {
+        let started = Instant::now();
+        plan.analysis_spin_into(&map0, &map1, &mut e, &mut b, &mut workspace)
+            .unwrap();
+        plain_wall_ns.push(started.elapsed().as_nanos());
+    }
+    crate::legendre::begin_scalar_analysis_route_profile();
+    let started = Instant::now();
+    plan.analysis_spin_into(&map0, &map1, &mut e, &mut b, &mut workspace)
+        .unwrap();
+    let wall_ns = started.elapsed().as_nanos();
+    let counts = crate::legendre::finish_scalar_analysis_route_profile();
+    let nonzero = |times: &[u64; 64]| {
+        times
+            .iter()
+            .enumerate()
+            .filter_map(|(index, &ns)| (ns > 0).then_some((index, ns)))
+            .collect::<Vec<_>>()
+    };
+    eprintln!(
+        "M6_B3_ROUTE_TIMING reduced={reduced} q={q} wall_ns={wall_ns} plain_wall_ns={plain_wall_ns:?} normal_seed_blocks={} prefix_scaled_blocks={} checked_scaled_blocks={} ordinary_route_blocks={} scaled_route_blocks={} ordinary_pair_accumulations={} scaled_pair_accumulations={} scaled_prefix_steps={} ordinary_suffix_steps={} scaled_transitions={} scaled_no_transition={} ordinary_threads={:?} scaled_threads={:?} scaled_prefix_threads={:?} ordinary_suffix_threads={:?} scaled_seed_lane_histogram={:?} scaled_seed_non_normal_lanes={} scaled_seed_total_lanes={}",
+        counts.normal_seed_blocks,
+        counts.prefix_enabled_scaled_blocks,
+        counts.checked_scaled_blocks,
+        counts.ordinary_route_blocks,
+        counts.scaled_route_blocks,
+        counts.typed_normal_pair_accumulations,
+        counts.typed_scaled_pair_accumulations,
+        counts.scaled_prefix_pair_steps,
+        counts.ordinary_suffix_pair_steps,
+        counts.scaled_route_transitions,
+        counts.scaled_route_no_transitions,
+        nonzero(&counts.ordinary_route_ns_by_thread),
+        nonzero(&counts.scaled_route_ns_by_thread),
+        nonzero(&counts.scaled_prefix_ns_by_thread),
+        nonzero(&counts.ordinary_suffix_ns_by_thread),
+        counts
+            .scaled_seed_lane_histogram
+            .iter()
+            .enumerate()
+            .filter_map(|(index, &count)| (count > 0).then_some((index, count)))
+            .collect::<Vec<_>>(),
+        counts.scaled_seed_non_normal_lanes,
+        counts.scaled_seed_total_lanes,
+    );
+}
