+#[cfg(all(test, feature = "parallel"))]
+#[inline(always)]
+pub(crate) fn record_scalar_analysis_route_substage(
+    scaled_prefix: bool,
+    started: Option<std::time::Instant>,
+    pair_steps: usize,
+    transitioned_to_normal: bool,
+) {
+    use std::sync::atomic::Ordering;
+
+    let Some(started) = started else { return };
+    let elapsed = started.elapsed().as_nanos().min(u64::MAX as u128) as u64;
+    let index = rayon::current_thread_index().unwrap_or(0).min(63);
+    if scaled_prefix {
+        SCALAR_ANALYSIS_SCALED_PREFIX_NS[index].fetch_add(elapsed, Ordering::Relaxed);
+        SCALAR_ANALYSIS_SCALED_PREFIX_PAIR_STEPS.fetch_add(pair_steps, Ordering::Relaxed);
+        let transitions = if transitioned_to_normal {
+            &SCALAR_ANALYSIS_SCALED_ROUTE_TRANSITIONS
+        } else {
+            &SCALAR_ANALYSIS_SCALED_ROUTE_NO_TRANSITIONS
+        };
+        transitions.fetch_add(1, Ordering::Relaxed);
+    } else {
+        SCALAR_ANALYSIS_ORDINARY_SUFFIX_NS[index].fetch_add(elapsed, Ordering::Relaxed);
+        SCALAR_ANALYSIS_ORDINARY_SUFFIX_PAIR_STEPS.fetch_add(pair_steps, Ordering::Relaxed);
+    }
+}
