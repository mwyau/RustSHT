+            &SCALAR_ANALYSIS_ORDINARY_ROUTE_BLOCKS,
+        )
+    };
+    counters[index].fetch_add(elapsed, Ordering::Relaxed);
+    blocks.fetch_add(1, Ordering::Relaxed);
+}
