+    second_coefficient_a: f64,
+    second_coefficient_b: f64,
+    sums: [f64; 8],
+}
+
+struct FusedAnalysisTwoPairScalarTailResult {
+    sums: [f64; 8],
+    tails_in_range: bool,
+}
