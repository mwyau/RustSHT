+struct B3TwoChannelKernel<'a, const ACCUMULATE: bool, const SECOND_CHANNEL: bool> {
+    fixture: &'a Fixture,
+    m: usize,
+    u_same_real: &'a [f64],
+    u_same_imag: &'a [f64],
+    u_opposite_real: &'a [f64],
+    u_opposite_imag: &'a [f64],
+    staged_q: &'a mut [Complex64],
+    staged_u: &'a mut [Complex64],
+    previous: &'a mut [f64],
+    current: &'a mut [f64],
+    next: &'a mut [f64],
+}
+
+impl<const ACCUMULATE: bool, const SECOND_CHANNEL: bool> WithSimd
+    for B3TwoChannelKernel<'_, ACCUMULATE, SECOND_CHANNEL>
+{
+    type Output = bool;
+
+    #[inline(always)]
+    fn with_simd<S: Simd>(self, simd: S) -> Self::Output {
+        let mut range_check_was_exercised = false;
+        let second_channel = if SECOND_CHANNEL {
+            Some(FusedScalarAnalysisPairSecondChannel {
+                same_real: self.u_same_real,
+                same_imag: self.u_same_imag,
+                opposite_real: self.u_opposite_real,
+                opposite_imag: self.u_opposite_imag,
+                staged_coefficients: self.staged_u,
+            })
+        } else {
+            None
+        };
+        FusedScalarAnalysisPair::<true, false, false, ACCUMULATE, SECOND_CHANNEL> {
+            m: self.m,
+            lmax: BENCH_LMAX,
+            range_check_was_exercised: &mut range_check_was_exercised,
+            pair_start: 0,
+            cos_theta: &self.fixture.cosine,
+            cos_theta_squared: &self.fixture.cosine_squared,
+            coefficient_a: &self.fixture.coefficient_a,
+            coefficient_b: &self.fixture.coefficient_b,
+            same_real: &self.fixture.same_real,
+            same_imag: &self.fixture.same_imag,
+            opposite_real: &self.fixture.opposite_real,
+            opposite_imag: &self.fixture.opposite_imag,
+            staged_coefficients: self.staged_q,
+            second_channel,
+            previous: self.previous,
+            current: self.current,
+            next: self.next,
+        }
+        .with_simd(simd)
+    }
+}
+
+fn run_b3_two_channel_kernel<const ACCUMULATE: bool, const SECOND_CHANNEL: bool>(
+    arch: Arch,
+    m: usize,
+    fixture: &Fixture,
+    u_same_real: &[f64],
+    u_same_imag: &[f64],
+    u_opposite_real: &[f64],
+    u_opposite_imag: &[f64],
+    staged_q: &mut [Complex64],
+    staged_u: &mut [Complex64],
+    previous: &mut [f64],
+    current: &mut [f64],
+    next: &mut [f64],
+) -> bool {
+    arch.dispatch(B3TwoChannelKernel::<ACCUMULATE, SECOND_CHANNEL> {
+        fixture,
+        m,
+        u_same_real,
+        u_same_imag,
+        u_opposite_real,
+        u_opposite_imag,
+        staged_q,
+        staged_u,
+        previous,
+        current,
+        next,
+    })
+}
+
+fn reset_b3_two_channel_kernel(
+    fixture: &Fixture,
+    staged_q: &mut [Complex64],
+    staged_u: &mut [Complex64],
+    previous: &mut [f64],
+    current: &mut [f64],
+    next: &mut [f64],
+) {
+    previous.copy_from_slice(&fixture.previous);
+    current.copy_from_slice(&fixture.current);
+    next.fill(0.0);
+    staged_q.fill(Complex64::new(0.0, 0.0));
+    staged_u.fill(Complex64::new(0.0, 0.0));
+}
+
+#[cfg(target_arch = "x86_64")]
+#[inline(always)]
+fn b3_rdpru(index: u32) -> u64 {
+    let low: u32;
+    let high: u32;
+    // AMD RDPRU indices 0 and 1 read MPERF and APERF. LFENCE orders the
+    // sample around the timed batch; this function is test-only.
+    unsafe {
+        core::arch::asm!(
+            "lfence",
+            "rdpru",
+            in("ecx") index,
+            out("eax") low,
+            out("edx") high,
+            options(nostack),
+        );
+    }
+    (u64::from(high) << 32) | u64::from(low)
+}
+
+fn time_b3_two_channel_variant<const ACCUMULATE: bool, const SECOND_CHANNEL: bool>(
+    repetitions: usize,
+    arch: Arch,
+    m: usize,
+    fixture: &Fixture,
+    u_same_real: &[f64],
+    u_same_imag: &[f64],
+    u_opposite_real: &[f64],
+    u_opposite_imag: &[f64],
+    staged_q: &mut [Complex64],
+    staged_u: &mut [Complex64],
+    previous: &mut [f64],
+    current: &mut [f64],
+    next: &mut [f64],
+) -> (f64, f64, f64, f64) {
+    let reset_started = Instant::now();
+    let reset_mperf_start = b3_rdpru(0);
+    let reset_aperf_start = b3_rdpru(1);
+    for _ in 0..repetitions {
+        reset_b3_two_channel_kernel(fixture, staged_q, staged_u, previous, current, next);
+        std::hint::black_box((&*staged_q, &*staged_u, &*previous, &*current, &*next));
+    }
+    let reset_aperf_end = b3_rdpru(1);
+    let reset_mperf_end = b3_rdpru(0);
+    let reset_ns = reset_started.elapsed().as_secs_f64() * 1.0e9 / repetitions as f64;
+    let reset_aperf = reset_aperf_end.wrapping_sub(reset_aperf_start) as f64 / repetitions as f64;
+    let reset_mperf = reset_mperf_end.wrapping_sub(reset_mperf_start) as f64 / repetitions as f64;
+
+    let started = Instant::now();
+    let mperf_start = b3_rdpru(0);
+    let aperf_start = b3_rdpru(1);
+    let mut success_count = 0;
+    for _ in 0..repetitions {
+        reset_b3_two_channel_kernel(fixture, staged_q, staged_u, previous, current, next);
+        success_count += run_b3_two_channel_kernel::<ACCUMULATE, SECOND_CHANNEL>(
+            arch,
+            m,
+            fixture,
+            u_same_real,
+            u_same_imag,
+            u_opposite_real,
+            u_opposite_imag,
+            staged_q,
+            staged_u,
+            previous,
+            current,
+            next,
+        ) as usize;
+        std::hint::black_box((&*staged_q, &*staged_u, &*previous, &*current, &*next));
+    }
+    assert_eq!(success_count, repetitions);
+    let aperf_end = b3_rdpru(1);
+    let mperf_end = b3_rdpru(0);
+    let wall_ns = started.elapsed().as_secs_f64() * 1.0e9 / repetitions as f64;
+    let aperf = aperf_end.wrapping_sub(aperf_start) as f64 / repetitions as f64;
+    let mperf = mperf_end.wrapping_sub(mperf_start) as f64 / repetitions as f64;
+    (wall_ns, reset_ns, aperf - reset_aperf, mperf - reset_mperf)
+}
+
+fn run_b3_variant(
+    accumulate: bool,
+    second: bool,
+    arch: Arch,
+    m: usize,
+    fixture: &Fixture,
+    u_same_real: &[f64],
+    u_same_imag: &[f64],
+    u_opposite_real: &[f64],
+    u_opposite_imag: &[f64],
+    staged_q: &mut [Complex64],
+    staged_u: &mut [Complex64],
+    previous: &mut [f64],
+    current: &mut [f64],
+    next: &mut [f64],
+) -> bool {
+    match (accumulate, second) {
+        (true, true) => run_b3_two_channel_kernel::<true, true>(
+            arch,
+            m,
+            fixture,
+            u_same_real,
+            u_same_imag,
+            u_opposite_real,
+            u_opposite_imag,
+            staged_q,
+            staged_u,
+            previous,
+            current,
+            next,
+        ),
+        (false, true) => run_b3_two_channel_kernel::<false, true>(
+            arch,
+            m,
+            fixture,
+            u_same_real,
+            u_same_imag,
+            u_opposite_real,
+            u_opposite_imag,
+            staged_q,
+            staged_u,
+            previous,
+            current,
+            next,
+        ),
+        (true, false) => run_b3_two_channel_kernel::<true, false>(
+            arch,
+            m,
+            fixture,
+            u_same_real,
+            u_same_imag,
+            u_opposite_real,
+            u_opposite_imag,
+            staged_q,
+            staged_u,
+            previous,
+            current,
+            next,
+        ),
+        (false, false) => run_b3_two_channel_kernel::<false, false>(
+            arch,
+            m,
+            fixture,
+            u_same_real,
+            u_same_imag,
+            u_opposite_real,
+            u_opposite_imag,
+            staged_q,
+            staged_u,
+            previous,
+            current,
+            next,
+        ),
+    }
+}
