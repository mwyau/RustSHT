+#[test]
+#[ignore = "manual B3 f64 recurrence versus two-channel accumulation attribution"]
+fn benchmark_b3_spin_analysis_leaf_components() {
+    const LMAX: usize = 720;
+    let m = std::env::var("RUSTSHT_B3_COMPONENT_M")
+        .ok()
+        .and_then(|value| value.parse().ok())
+        .unwrap_or(BENCH_ORDER);
+    let lanes = std::env::var("RUSTSHT_B3_COMPONENT_LANES")
+        .ok()
+        .and_then(|value| value.parse().ok())
+        .unwrap_or(64_usize);
+    let ring_start = std::env::var("RUSTSHT_B3_COMPONENT_RING_START")
+        .ok()
+        .and_then(|value| value.parse().ok())
+        .unwrap_or(64_usize);
+    let repetitions = std::env::var("RUSTSHT_B3_COMPONENT_REPETITIONS")
+        .ok()
+        .and_then(|value| value.parse().ok())
+        .unwrap_or(2_000_usize);
+    let sample_count = std::env::var("RUSTSHT_B3_COMPONENT_SAMPLES")
+        .ok()
+        .and_then(|value| value.parse().ok())
+        .unwrap_or(15_usize);
+    assert!(m <= LMAX && lanes > 0 && ring_start + lanes <= 361);
+    assert!(repetitions > 0 && sample_count >= 3);
+
+    let grid = crate::grid::GridSpec::new(crate::grid::GridKind::GaussLegendre, 721, 1458, 0.23)
+        .expect("GL T720 grid");
+    let angles = &grid.theta()[ring_start..ring_start + lanes];
+    let (sine, cosine): (Vec<_>, Vec<_>) = angles.iter().map(|theta| theta.sin_cos()).unzip();
+    let mut fixture = Fixture::from_geometry(m, LMAX, cosine.clone(), sine.clone());
+    for (current, &sin_theta) in fixture.current.iter_mut().zip(&sine) {
+        let mut sectoral = (4.0 * std::f64::consts::PI).sqrt().recip();
+        for order in 1..=m {
+            sectoral *= -(((2 * order + 1) as f64) / (2 * order) as f64).sqrt() * sin_theta;
+        }
+        *current = sectoral;
+    }
+    let u_same_real = (0..lanes)
+        .map(|lane| 0.16 + (0.021 * (lane as f64 + 1.7)).sin())
+        .collect::<Vec<_>>();
+    let u_same_imag = (0..lanes)
+        .map(|lane| -0.12 + 0.31 * (0.015 * (lane as f64 + 0.4)).cos())
+        .collect::<Vec<_>>();
+    let u_opposite_real = fixture
+        .cosine
+        .iter()
+        .enumerate()
+        .map(|(lane, &c)| c * (0.19 + (0.017 * (lane as f64 + 0.3)).sin()))
+        .collect::<Vec<_>>();
+    let u_opposite_imag = fixture
+        .cosine
+        .iter()
+        .enumerate()
+        .map(|(lane, &c)| c * (0.23 + (0.013 * (lane as f64 + 0.9)).cos()))
+        .collect::<Vec<_>>();
+    let mut u_fixture = Fixture::from_geometry(m, LMAX, cosine, sine);
+    u_fixture.current.clone_from(&fixture.current);
+    u_fixture.same_real.clone_from(&u_same_real);
+    u_fixture.same_imag.clone_from(&u_same_imag);
+    u_fixture.opposite_real.clone_from(&u_opposite_real);
+    u_fixture.opposite_imag.clone_from(&u_opposite_imag);
+    let fixture_base = std::env::var("RUSTSHT_B3_COMPONENT_FIXTURE_BASE").ok();
+    if let Some(base) = &fixture_base {
+        fixture.write_input_order(&format!("{base}-q.in"), lanes, m, LMAX);
+        u_fixture.write_input_order(&format!("{base}-u.in"), lanes, m, LMAX);
+    }
+    let arch = Arch::new();
+    eprintln!("B3_COMPONENT_ARCH {arch:?}");
+    let coefficient_count = LMAX - m + 1;
+    let mut staged_q = vec![Complex64::new(0.0, 0.0); coefficient_count];
+    let mut staged_u = vec![Complex64::new(0.0, 0.0); coefficient_count];
+    let mut previous = vec![0.0; lanes];
+    let mut current = fixture.current.clone();
+    let mut next = vec![0.0; lanes];
+
+    for (accumulate, second) in [(true, true), (false, true), (true, false), (false, false)] {
+        reset_b3_two_channel_kernel(
+            &fixture,
+            &mut staged_q,
+            &mut staged_u,
+            &mut previous,
+            &mut current,
+            &mut next,
+        );
+        assert!(run_b3_variant(
+            accumulate,
+            second,
+            arch,
+            m,
+            &fixture,
+            &u_same_real,
+            &u_same_imag,
+            &u_opposite_real,
+            &u_opposite_imag,
+            &mut staged_q,
+            &mut staged_u,
+            &mut previous,
+            &mut current,
+            &mut next,
+        ));
+    }
+
+    eprintln!(
+        "B3_COMPONENT_CONFIG m={m} lmax={LMAX} lanes={lanes} ring_start={ring_start} repetitions={repetitions} samples={sample_count} useful_degree_lane_updates={}",
+        lanes * (LMAX - m + 1)
+    );
+    let variants = ["q_plus_u", "u_only", "q_only", "recurrence_only"];
+    let mut samples = vec![Vec::with_capacity(sample_count); variants.len()];
+    let mut aperf_samples = vec![Vec::with_capacity(sample_count); variants.len()];
+    let mut mperf_samples = vec![Vec::with_capacity(sample_count); variants.len()];
+    for sample in 0..sample_count {
+        let order = if sample.is_multiple_of(2) {
+            [(true, true), (false, true), (true, false), (false, false)]
+        } else {
+            [(false, false), (true, false), (false, true), (true, true)]
+        };
+        for (accumulate, second) in order {
+            let output_index = match (accumulate, second) {
+                (true, true) => 0,
+                (false, true) => 1,
+                (true, false) => 2,
+                (false, false) => 3,
+            };
+            let (wall_ns, reset_ns, aperf, mperf) = match (accumulate, second) {
+                (true, true) => time_b3_two_channel_variant::<true, true>(
+                    repetitions,
+                    arch,
+                    m,
+                    &fixture,
+                    &u_same_real,
+                    &u_same_imag,
+                    &u_opposite_real,
+                    &u_opposite_imag,
+                    &mut staged_q,
+                    &mut staged_u,
+                    &mut previous,
+                    &mut current,
+                    &mut next,
+                ),
+                (false, true) => time_b3_two_channel_variant::<false, true>(
+                    repetitions,
+                    arch,
+                    m,
+                    &fixture,
+                    &u_same_real,
+                    &u_same_imag,
+                    &u_opposite_real,
+                    &u_opposite_imag,
+                    &mut staged_q,
+                    &mut staged_u,
+                    &mut previous,
+                    &mut current,
+                    &mut next,
+                ),
+                (true, false) => time_b3_two_channel_variant::<true, false>(
+                    repetitions,
+                    arch,
+                    m,
+                    &fixture,
+                    &u_same_real,
+                    &u_same_imag,
+                    &u_opposite_real,
+                    &u_opposite_imag,
+                    &mut staged_q,
+                    &mut staged_u,
+                    &mut previous,
+                    &mut current,
+                    &mut next,
+                ),
+                (false, false) => time_b3_two_channel_variant::<false, false>(
+                    repetitions,
+                    arch,
+                    m,
+                    &fixture,
+                    &u_same_real,
+                    &u_same_imag,
+                    &u_opposite_real,
+                    &u_opposite_imag,
+                    &mut staged_q,
+                    &mut staged_u,
+                    &mut previous,
+                    &mut current,
+                    &mut next,
+                ),
+            };
+            samples[output_index].push(wall_ns - reset_ns);
+            aperf_samples[output_index].push(aperf);
+            mperf_samples[output_index].push(mperf);
+            eprintln!(
+                "B3_COMPONENT sample={sample} variant={} adjusted_ns={:.3} aperf_cycles={aperf:.3} mperf_cycles={mperf:.3} wall_ns={wall_ns:.3} reset_ns={reset_ns:.3}",
+                variants[output_index],
+                wall_ns - reset_ns,
+            );
+        }
+    }
+    for (variant, values) in variants.iter().zip(samples.iter()) {
+        let mut sorted = values.clone();
+        sorted.sort_by(f64::total_cmp);
+        eprintln!(
+            "B3_COMPONENT_SUMMARY variant={variant} median_adjusted_ns={:.3} samples={values:?}",
+            sorted[sample_count / 2]
+        );
+    }
+    for sample in 0..sample_count {
+        eprintln!(
+            "B3_DELTA sample={sample} q_cost_same_route_ns={:.3} q_cost_single_route_ns={:.3} u_plus_rotation_ns={:.3}",
+            samples[0][sample] - samples[1][sample],
+            samples[2][sample] - samples[3][sample],
+            samples[1][sample] - samples[3][sample],
+        );
+    }
+    if let Some(base) = fixture_base {
+        reset_b3_two_channel_kernel(
+            &fixture,
+            &mut staged_q,
+            &mut staged_u,
+            &mut previous,
+            &mut current,
+            &mut next,
+        );
+        assert!(run_b3_two_channel_kernel::<true, true>(
+            arch,
+            m,
+            &fixture,
+            &u_same_real,
+            &u_same_imag,
+            &u_opposite_real,
+            &u_opposite_imag,
+            &mut staged_q,
+            &mut staged_u,
+            &mut previous,
+            &mut current,
+            &mut next,
+        ));
+        write_complex(&format!("{base}-q.rust"), &staged_q);
+        write_complex(&format!("{base}-u.rust"), &staged_u);
+    }
+}
