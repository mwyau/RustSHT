+                RECURRENCE_SEGMENTS.fetch_add(1, Ordering::Relaxed);
+                RECURRENCE_NS.fetch_add(
+                    elapsed.saturating_mul(group_count.min(u64::MAX as usize) as u64),
+                    Ordering::Relaxed,
+                );
+            }
+        }
+
+        #[inline(always)]
+        pub fn finish_second_channel(&mut self, start: Option<Instant>, group_count: usize) {
+            if let Some(elapsed) = Self::elapsed(start) {
+                SECOND_CHANNEL_SEGMENTS.fetch_add(1, Ordering::Relaxed);
+                SECOND_CHANNEL_NS.fetch_add(
+                    elapsed.saturating_mul(group_count.min(u64::MAX as usize) as u64),
+                    Ordering::Relaxed,
+                );
+            }
+        }
+    }
+
+    #[unsafe(no_mangle)]
+    pub extern "C" fn m6_b3_ordinary_profile_reset() {
+        ENABLED.store(false, Ordering::Relaxed);
+        CALLS.store(0, Ordering::Relaxed);
+        SAMPLES.store(0, Ordering::Relaxed);
+        RECURRENCE_SEGMENTS.store(0, Ordering::Relaxed);
+        SECOND_CHANNEL_SEGMENTS.store(0, Ordering::Relaxed);
+        RECURRENCE_NS.store(0, Ordering::Relaxed);
+        SECOND_CHANNEL_NS.store(0, Ordering::Relaxed);
+        GENERATION.fetch_add(1, Ordering::Relaxed);
+    }
+
+    #[unsafe(no_mangle)]
+    pub extern "C" fn m6_b3_ordinary_profile_enable(enabled: bool) {
+        ENABLED.store(enabled, Ordering::Relaxed);
+    }
+
+    #[unsafe(no_mangle)]
+    pub extern "C" fn m6_b3_ordinary_profile_value(index: u32) -> u64 {
+        match index {
+            0 => CALLS.load(Ordering::Relaxed),
+            1 => SAMPLES.load(Ordering::Relaxed),
+            2 => RECURRENCE_SEGMENTS.load(Ordering::Relaxed),
+            3 => SECOND_CHANNEL_SEGMENTS.load(Ordering::Relaxed),
+            4 => RECURRENCE_NS.load(Ordering::Relaxed),
+            5 => SECOND_CHANNEL_NS.load(Ordering::Relaxed),
+            _ => 0,
+        }
+    }
+}
