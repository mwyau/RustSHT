+        #[inline(always)]
+        pub fn active(&self) -> bool {
+            self.active
+        }
+
+        #[inline(always)]
+        pub fn start(&self) -> Option<Instant> {
+            self.active.then(Instant::now)
+        }
+
+        #[inline(always)]
+        fn elapsed(start: Option<Instant>) -> Option<u64> {
+            start.map(|start| start.elapsed().as_nanos().min(u64::MAX as u128) as u64)
+        }
+
