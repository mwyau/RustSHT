+    thread_local! {
+        static SAMPLE_POSITION: Cell<(u64, u64)> = const { Cell::new((u64::MAX, 0)) };
+    }
+
+    pub struct Sample {
+        active: bool,
+    }
+
+    impl Sample {
+        #[inline(always)]
+        pub fn new(two_channels: bool) -> Self {
+            if !two_channels || !ENABLED.load(Ordering::Relaxed) {
+                return Self { active: false };
+            }
+            CALLS.fetch_add(1, Ordering::Relaxed);
+            let generation = GENERATION.load(Ordering::Relaxed);
+            let active = SAMPLE_POSITION.with(|position| {
+                let (seen_generation, mut state) = position.get();
+                if seen_generation != generation {
+                    state = NEXT_THREAD_SEED.fetch_add(0x9e37_79b9_7f4a_7c15, Ordering::Relaxed);
+                }
+                state = state
+                    .wrapping_mul(6_364_136_223_846_793_005)
+                    .wrapping_add(1_442_695_040_888_963_407);
+                position.set((generation, state));
+                state < u64::MAX / SAMPLE_STRIDE
+            });
+            if active {
+                SAMPLES.fetch_add(1, Ordering::Relaxed);
+            }
+            Self { active }
+        }
