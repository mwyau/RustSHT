+    static GENERATION: AtomicU64 = AtomicU64::new(0);
+    static NEXT_THREAD_SEED: AtomicU64 = AtomicU64::new(0x9e37_79b9_7f4a_7c15);
+    static CALLS: AtomicU64 = AtomicU64::new(0);
+    static SAMPLES: AtomicU64 = AtomicU64::new(0);
