+struct B3OrdinaryLeafBenchCall<'a> {
+    m: usize,
+    lmax: usize,
+    cos_theta: &'a [f64],
+    cos_theta_squared: &'a [f64],
+    coefficient_a: &'a [f64],
+    coefficient_b: &'a [f64],
+    first_same_real: &'a [f64],
+    first_same_imag: &'a [f64],
+    first_opposite_real: &'a [f64],
+    first_opposite_imag: &'a [f64],
+    second_same_real: &'a [f64],
+    second_same_imag: &'a [f64],
+    second_opposite_real: &'a [f64],
+    second_opposite_imag: &'a [f64],
+    first_staged: &'a mut [Complex64],
+    second_staged: &'a mut [Complex64],
+    previous: &'a mut [f64],
+    current: &'a mut [f64],
+    next: &'a mut [f64],
+}
+
+impl WithSimd for B3OrdinaryLeafBenchCall<'_> {
+    type Output = bool;
+
+    fn with_simd<S: Simd>(self, _simd: S) -> Self::Output {
+        let simd = _simd;
+        let mut range_check_was_exercised = false;
+        FusedScalarAnalysisPair::<true, false, false, true, true> {
+            m: self.m,
+            lmax: self.lmax,
+            range_check_was_exercised: &mut range_check_was_exercised,
+            pair_start: 0,
+            cos_theta: self.cos_theta,
+            cos_theta_squared: self.cos_theta_squared,
+            coefficient_a: self.coefficient_a,
+            coefficient_b: self.coefficient_b,
+            same_real: self.first_same_real,
+            same_imag: self.first_same_imag,
+            opposite_real: self.first_opposite_real,
+            opposite_imag: self.first_opposite_imag,
+            staged_coefficients: self.first_staged,
+            second_channel: Some(FusedScalarAnalysisPairSecondChannel {
+                same_real: self.second_same_real,
+                same_imag: self.second_same_imag,
+                opposite_real: self.second_opposite_real,
+                opposite_imag: self.second_opposite_imag,
+                staged_coefficients: self.second_staged,
+            }),
+            previous: self.previous,
+            current: self.current,
+            next: self.next,
+        }
+        .with_simd(simd)
+    }
+}
