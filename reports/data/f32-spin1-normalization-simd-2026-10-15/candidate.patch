+    #[test]
+    fn f32_spin_pair_simd_range_check_accepts_normal_zero_and_tailed_blocks() {
+        for count in [64_usize, 61] {
+            let previous = (0..count)
+                .map(|lane| {
+                    if lane.is_multiple_of(5) {
+                        0.0
+                    } else {
+                        0.125 + lane as f32 * 0.001
+                    }
+                })
+                .collect::<Vec<_>>();
+            let current = (0..count)
+                .map(|lane| {
+                    if lane.is_multiple_of(7) {
+                        -0.0
+                    } else {
+                        -0.25 + lane as f32 * 0.002
+                    }
+                })
+                .collect::<Vec<_>>();
+            assert!(Arch::new().dispatch(PairsWithinScaleRange {
+                previous: &previous,
+                current: &current,
+            }));
+
+            let mut actual_previous = previous.clone();
+            let mut actual_current = current.clone();
+            let mut exponents = vec![0; count];
+            exponents[3] = -80;
+            Arch::new()
+                .dispatch(NormalizePairLanes {
+                    previous: &mut actual_previous,
+                    current: &mut actual_current,
+                    exponents: &mut exponents,
+                })
+                .unwrap();
+            assert_eq!(actual_previous, previous);
+            assert_eq!(actual_current, current);
+            assert_eq!(exponents[3], -80);
+        }
