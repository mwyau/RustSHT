-fn normalize_pair_lanes(
+fn normalize_pair_lanes<S: Simd>(
+    simd: S,
+    previous: &mut [f32],
+    current: &mut [f32],
+    exponents: &mut [i64],
+) -> Result<(), ShtError> {
+    debug_assert!(previous.iter().all(|value| value.is_finite()));
+    debug_assert!(current.iter().all(|value| value.is_finite()));
+
+    if !S::IS_SCALAR && pairs_within_scale_range(simd, previous, current) {
+        return Ok(());
+    }
+
+    normalize_pair_lanes_scalar(previous, current, exponents)
+}
+
+fn pairs_within_scale_range<S: Simd>(simd: S, previous: &[f32], current: &[f32]) -> bool {
+    debug_assert_eq!(previous.len(), current.len());
+
+    let (previous_vectors, previous_tail) = S::as_simd_f32s(previous);
+    let (current_vectors, current_tail) = S::as_simd_f32s(current);
+    debug_assert_eq!(previous_vectors.len(), current_vectors.len());
+    debug_assert_eq!(previous_tail.len(), current_tail.len());
+
+    let zero = simd.splat_f32s(0.0);
+    let largest = simd.splat_f32s(f32::MAX);
+    for index in 0..previous_vectors.len() {
+        let maximum = simd.max_f32s(
+            simd.abs_f32s(previous_vectors[index]),
+            simd.abs_f32s(current_vectors[index]),
+        );
+        if simd.reduce_max_f32s(maximum) > BIG {
+            return false;
+        }
+
+        let nonzero = simd.greater_than_f32s(maximum, zero);
+        let positive = simd.select_f32s(nonzero, maximum, largest);
+        if simd.reduce_min_f32s(positive) < SMALL {
+            return false;
+        }
+    }
+
+    for lane in 0..previous_tail.len() {
+        let previous_bits = previous_tail[lane].to_bits() & 0x7fff_ffff;
+        let current_bits = current_tail[lane].to_bits() & 0x7fff_ffff;
+        let maximum_bits = previous_bits.max(current_bits);
+        if maximum_bits > BIG.to_bits() || (maximum_bits != 0 && maximum_bits < SMALL.to_bits()) {
+            return false;
+        }
+    }
+
+    true
+}
