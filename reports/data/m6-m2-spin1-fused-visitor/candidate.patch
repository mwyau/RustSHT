+/// Multiplies two channel values by one shared basis and inverse-sine factor.
+///
+/// The ordinary path shares the factor checks while preserving the individual
+/// left-associated products. If either channel cannot use the same normal-range
+/// path, both values use the established scaled helper.
+pub(crate) fn multiply_complex_pair_scaled_product(
+    first: Complex64,
+    second: Complex64,
+    factor: f64,
+    additional_factor: f64,
+    exponent: i64,
+) -> (Complex64, Complex64) {
+    if let Some(product_pair) =
+        try_multiply_complex_pair_normal_path(first, second, factor, additional_factor, exponent)
+    {
+        return product_pair;
+    }
+
+    (
+        multiply_complex_scaled_product(first, factor, additional_factor, exponent),
+        multiply_complex_scaled_product(second, factor, additional_factor, exponent),
+    )
+}
+
+#[inline(always)]
+fn try_multiply_complex_pair_normal_path(
+    first: Complex64,
+    second: Complex64,
+    factor: f64,
+    additional_factor: f64,
+    exponent: i64,
+) -> Option<(Complex64, Complex64)> {
+    if factor.is_normal()
+        && additional_factor.is_normal()
+        && first.re.is_normal()
+        && first.im.is_normal()
+        && second.re.is_normal()
+        && second.im.is_normal()
+    {
+        let first_product = Complex64::new(
+            (first.re * factor) * additional_factor,
+            (first.im * factor) * additional_factor,
+        );
+        let second_product = Complex64::new(
+            (second.re * factor) * additional_factor,
+            (second.im * factor) * additional_factor,
+        );
+        if first_product.re.is_normal()
+            && first_product.im.is_normal()
+            && second_product.re.is_normal()
+            && second_product.im.is_normal()
+        {
+            if exponent == 0 {
+                return Some((first_product, second_product));
+            }
+            if let (Some(first_scaled), Some(second_scaled)) = (
+                scale_complex_normal_binary(first_product, exponent),
+                scale_complex_normal_binary(second_product, exponent),
+            ) {
+                return Some((first_scaled, second_scaled));
+            }
+        }
+    }
+    None
+}
