+/// Multiplies two channel values by one shared basis and inverse-sine factor.
+///
+/// The ordinary path shares the factor checks while preserving the individual
+/// left-associated products. If either channel cannot use the same normal-range
+/// path, both values use the established scaled helper.
+pub(crate) fn multiply_complex_pair_scaled_product(
+    first: Complex64,
+    second: Complex64,
+    factor: f64,
+    additional_factor: f64,
+    exponent: i64,
+) -> (Complex64, Complex64) {
+    if let Some(product_pair) =
+        try_multiply_complex_pair_normal_path(first, second, factor, additional_factor, exponent)
+    {
+        return product_pair;
+    }
+
+    (
+        multiply_complex_scaled_product(first, factor, additional_factor, exponent),
+        multiply_complex_scaled_product(second, factor, additional_factor, exponent),
+    )
+}
