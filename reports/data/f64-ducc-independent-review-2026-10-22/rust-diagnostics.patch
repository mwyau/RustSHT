+#[cfg(feature = "parallel")]
+#[test]
+#[ignore]
+fn independent_cc_synthesis_route_probe() {
+    for q in [1,8] {
+        let pool = rayon::ThreadPoolBuilder::new().num_threads(q).build().unwrap();
+        for (lmax,mmax) in [(255,255),(720,720),(720,180),(1023,1023)] {
+            let plan=make_cc_plan(lmax,mmax,lmax+2,GridSpec::fft_friendly_nphi(mmax).unwrap(),0.23);
+            let mut ws=pool.install(||plan.workspace()).unwrap();
+            pool.install(||plan.prepare_workspace(&mut ws,q)).unwrap();
+            let mut alm=vec![Complex64::new(0.0,0.0);plan.harmonics.nalm()];
+            for m in 0..=mmax { for l in m..=lmax {
+                let phase=(l*31+m*17) as f64*0.00137;
+                alm[plan.harmonics.index(l,m).unwrap()]=Complex64::new(phase.sin()*1e-4,if m==0 {0.0} else {phase.cos()*1e-4});
+            }}
+            let mut map=vec![0.0;plan.sample_count];
+            pool.install(||plan.synthesis_into(&alm,&mut map,&mut ws)).unwrap();
+            for c in &REVIEW_SYNTH_COUNTS {c.store(0,Ordering::Relaxed);}
+            REVIEW_SYNTH_GROUPS.lock().unwrap().clear();
+            REVIEW_SYNTH_ENABLED.store(true,Ordering::Relaxed);
+            pool.install(||plan.synthesis_into(&alm,&mut map,&mut ws)).unwrap();
+            REVIEW_SYNTH_ENABLED.store(false,Ordering::Relaxed);
+            let counts=REVIEW_SYNTH_COUNTS.each_ref().map(|c|c.load(Ordering::Relaxed));
+            eprintln!("REVIEW_SYNTH_ROUTES T{lmax} m{mmax} q{q} fused_declined_transition_fallback={counts:?} groups={:?}",REVIEW_SYNTH_GROUPS.lock().unwrap());
+            assert!(map.iter().all(|x|x.is_finite()));
+        }
+    }
+}
