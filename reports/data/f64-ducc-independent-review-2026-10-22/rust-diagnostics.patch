+#[cfg(feature = "parallel")]
+#[test]
+#[ignore]
+fn independent_cc_adjoint_cancellation_probe() {
+    let folder=std::path::PathBuf::from(std::env::var("RUSTSHT_REVIEW_ADJOINT_DIR").unwrap());
+    let read_real=|name:&str| std::fs::read(folder.join(name)).unwrap().as_chunks::<8>().0.iter().map(|v|f64::from_le_bytes(*v)).collect::<Vec<_>>();
+    let map=read_real("map.bin");
+    let raw=read_real("alm.bin");
+    let alm=raw.as_chunks::<2>().0.iter().map(|v|Complex64::new(v[0],v[1])).collect::<Vec<_>>();
+    let write_real=|name:&str,values:&[f64]|std::fs::write(folder.join(name),values.iter().flat_map(|v|v.to_le_bytes()).collect::<Vec<_>>()).unwrap();
+    let write_complex=|name:&str,values:&[Complex64]|std::fs::write(folder.join(name),values.iter().flat_map(|v|[v.re.to_le_bytes(),v.im.to_le_bytes()].concat()).collect::<Vec<_>>()).unwrap();
+    for q in [1,8] {
+        let pool=rayon::ThreadPoolBuilder::new().num_threads(q).build().unwrap();
+        let plan=make_cc_plan(214,214,216,432,0.23);
+        assert_eq!(map.len(),plan.sample_count);
+        let mut ws=pool.install(||plan.workspace()).unwrap();
+        pool.install(||plan.prepare_workspace(&mut ws,q)).unwrap();
+        let mut synthesized=vec![0.0;map.len()];let mut adjoint_analysis=synthesized.clone();
+        let mut analyzed=vec![Complex64::new(0.0,0.0);alm.len()];let mut adjoint_synthesis=analyzed.clone();
+        pool.install(|| {
+            plan.synthesis_into(&alm,&mut synthesized,&mut ws).unwrap();
+            plan.adjoint_synthesis_into(&map,&mut adjoint_synthesis,&mut ws).unwrap();
+            plan.analysis_into(&map,&mut analyzed,&mut ws).unwrap();
+            plan.adjoint_analysis_into(&alm,&mut adjoint_analysis,&mut ws).unwrap();
+        });
+        write_real(&format!("synthesized-q{q}.bin"),&synthesized);
+        write_real(&format!("adjoint-analysis-q{q}.bin"),&adjoint_analysis);
+        write_complex(&format!("analyzed-q{q}.bin"),&analyzed);
+        write_complex(&format!("adjoint-synthesis-q{q}.bin"),&adjoint_synthesis);
+        assert!(synthesized.iter().chain(&adjoint_analysis).all(|v|v.is_finite()));
+    }
+}
