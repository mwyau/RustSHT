+                    &workspace.theta_cos[ring_start..ring_end],
+                    &workspace.ring_order_limits,
+                    pulp::Arch::new(),
+                    &mut workspace.recurrence_workers[0],
+                )
+                .unwrap();
+            }
+            let mut finite_count = 0;
+            for (actual, expected) in fast_q
+                .iter()
