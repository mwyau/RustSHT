+/// Shared native-f32 recurrence leaf for the two scalar channels produced by
+/// spin-1 conversion. Normal-range packets accumulate both channels in one
+/// vector pass; scaled packets use the checked binary scaler and decline the
+/// block before writing spectra if any result is unsafe.
+#[cfg(feature = "parallel")]
+#[expect(
+    clippy::too_many_arguments,
+    reason = "The reflected f32 leaf receives two coefficient channels, both hemispheres, and caller-owned recurrence scratch."
+)]
+pub(crate) fn synthesize_f32_hemisphere_pair_block_dispatched(
+    arch: Arch,
+    m: usize,
+    lmax: usize,
+    sin_theta: &[f32],
+    cos_theta: &[f32],
+    sectoral_norm: f32,
+    coefficient_a: &[f32],
+    coefficient_b: &[f32],
+    first_even: &[Complex32],
+    first_odd: &[Complex32],
+    second_even: &[Complex32],
+    second_odd: &[Complex32],
+    spectrum_len: usize,
+    north_first: &mut [Complex32],
+    south_first: &mut [Complex32],
+    north_second: &mut [Complex32],
+    south_second: &mut [Complex32],
+    previous: &mut [f32],
+    current: &mut [f32],
+    next: &mut [f32],
+    exponents: &mut [i64],
+    sums: &mut [&mut [f32]; 8],
+) -> Result<bool, ShtError> {
+    let lane_count = sin_theta.len();
+    let Some(spectrum_count) = lane_count.checked_mul(spectrum_len) else {
+        return Ok(false);
+    };
+    if m > lmax
+        || lane_count == 0
+        || lane_count > LATITUDE_BLOCK_SIZE
+        || cos_theta.len() != lane_count
+        || spectrum_len <= m
+        || north_first.len() != spectrum_count
+        || south_first.len() != spectrum_count
+        || north_second.len() != spectrum_count
+        || south_second.len() != spectrum_count
+        || previous.len() < lane_count
+        || current.len() < lane_count
+        || next.len() < lane_count
+        || exponents.len() < lane_count
+        || sums.iter().any(|sum| sum.len() < lane_count)
+    {
+        return Ok(false);
+    }
+    if sin_theta
+        .iter()
+        .any(|&sine| !sine.is_finite() || sine < 0.01)
+        || cos_theta
+            .iter()
+            .any(|&cosine| !cosine.is_finite() || cosine.abs() > 1.0)
+    {
+        return Ok(false);
+    }
+
+    let pair_count = (lmax - m + 2) / 2;
+    if coefficient_a.len() < pair_count
+        || coefficient_b.len() < pair_count
+        || [first_even, first_odd, second_even, second_odd]
+            .iter()
+            .any(|coefficients| coefficients.len() < pair_count)
+        || coefficient_a[..pair_count]
+            .iter()
+            .chain(&coefficient_b[..pair_count])
+            .any(|&value| !f32_is_normal_or_zero(value))
+        || [first_even, first_odd, second_even, second_odd]
+            .iter()
+            .any(|coefficients| {
+                coefficients[..pair_count]
+                    .iter()
+                    .flat_map(|coefficient| [coefficient.re, coefficient.im])
+                    .any(|value| !f32_is_normal_or_zero(value))
+            })
+    {
+        return Ok(false);
+    }
+
+    for sum in sums.iter_mut() {
+        sum[..lane_count].fill(0.0);
+    }
+    let mut completed = true;
+    let accumulator = F32HemispherePairAccumulator {
+        m,
+        cos_theta,
+        first_even: &first_even[..pair_count],
+        first_odd: &first_odd[..pair_count],
+        second_even: &second_even[..pair_count],
+        second_odd: &second_odd[..pair_count],
+        sums: &mut *sums,
+        completed: &mut completed,
+    };
+    super::for_each_y_lm_paired_status_dispatched_typed::<f32, _>(
+        arch,
+        m,
+        lmax,
+        sin_theta,
+        cos_theta,
+        sectoral_norm,
+        &coefficient_a[..pair_count],
+        &coefficient_b[..pair_count],
+        previous,
+        current,
+        next,
+        exponents,
+        accumulator,
+    )?;
+    if !completed
+        || sums
+            .iter()
+            .any(|sum| sum[..lane_count].iter().any(|value| !value.is_finite()))
+    {
+        return Ok(false);
+    }
+
+    // Recombine parity only after all degree contributions are accumulated.
+    // The eight scratch rows now hold Q north/south and U north/south values.
+    for lane in 0..lane_count {
+        let inverse_sine = sin_theta[lane].recip();
+        let first_north_re = (sums[0][lane] + sums[2][lane]) * inverse_sine;
+        let first_north_im = (sums[1][lane] + sums[3][lane]) * inverse_sine;
+        let first_south_re = (sums[0][lane] - sums[2][lane]) * inverse_sine;
+        let first_south_im = (sums[1][lane] - sums[3][lane]) * inverse_sine;
+        let second_north_re = (sums[4][lane] + sums[6][lane]) * inverse_sine;
+        let second_north_im = (sums[5][lane] + sums[7][lane]) * inverse_sine;
+        let second_south_re = (sums[4][lane] - sums[6][lane]) * inverse_sine;
+        let second_south_im = (sums[5][lane] - sums[7][lane]) * inverse_sine;
+        let output_values = [
+            first_north_re,
+            first_north_im,
+            first_south_re,
+            first_south_im,
+            second_north_re,
+            second_north_im,
+            second_south_re,
+            second_south_im,
+        ];
+        if output_values.iter().any(|value| !value.is_finite()) {
+            return Ok(false);
+        }
+        for (sum, value) in sums.iter_mut().zip(output_values) {
+            sum[lane] = value;
+        }
+    }
+
+    // Validate every destination addition before committing any lane.
+    for lane in 0..lane_count {
+        let offset = lane * spectrum_len + m;
+        let destinations = [
+            (north_first[offset], sums[0][lane], sums[1][lane]),
+            (
+                south_first[(lane_count - 1 - lane) * spectrum_len + m],
+                sums[2][lane],
+                sums[3][lane],
+            ),
+            (north_second[offset], sums[4][lane], sums[5][lane]),
+            (
+                south_second[(lane_count - 1 - lane) * spectrum_len + m],
+                sums[6][lane],
+                sums[7][lane],
+            ),
+        ];
+        if destinations
+            .iter()
+            .any(|(old, re, im)| !(old.re + re).is_finite() || !(old.im + im).is_finite())
+        {
+            return Ok(false);
+        }
+    }
+    for lane in 0..lane_count {
+        let north_offset = lane * spectrum_len + m;
+        let south_offset = (lane_count - 1 - lane) * spectrum_len + m;
+        north_first[north_offset] += Complex32::new(sums[0][lane], sums[1][lane]);
+        south_first[south_offset] += Complex32::new(sums[2][lane], sums[3][lane]);
+        north_second[north_offset] += Complex32::new(sums[4][lane], sums[5][lane]);
+        south_second[south_offset] += Complex32::new(sums[6][lane], sums[7][lane]);
+    }
+    Ok(true)
+}
+
+struct F32HemispherePairAccumulator<'a, 'b> {
+    m: usize,
+    cos_theta: &'a [f32],
+    first_even: &'a [Complex32],
+    first_odd: &'a [Complex32],
+    second_even: &'a [Complex32],
+    second_odd: &'a [Complex32],
+    sums: &'a mut [&'b mut [f32]; 8],
+    completed: &'a mut bool,
+}
+
+impl super::PairedScalarRecurrenceVisitor<f32> for F32HemispherePairAccumulator<'_, '_> {
+    #[inline(always)]
+    fn visit<S: Simd>(
+        &mut self,
+        degree: usize,
+        ring_start: usize,
+        basis: &[f32],
+        lane_exponents: &[i64],
+        normal_range: bool,
+        simd: S,
+    ) -> Result<(), ShtError> {
+        if !*self.completed {
+            return Ok(());
+        }
+        let pair = (degree - self.m) / 2;
+        let coefficients = [
+            self.first_even[pair],
+            self.first_odd[pair],
+            self.second_even[pair],
+            self.second_odd[pair],
+        ];
+        let lanes = S::F32_LANES;
+        for packet_start in (0..basis.len()).step_by(lanes) {
+            let packet_end = (packet_start + lanes).min(basis.len());
+            let exponents = &lane_exponents[packet_start..packet_end];
+            if normal_range || exponents.iter().all(|&exponent| exponent == 0) {
+                let basis_vector = simd.partial_load_f32s(&basis[packet_start..packet_end]);
+                let cosine_vector = simd.partial_load_f32s(
+                    &self.cos_theta[ring_start + packet_start..ring_start + packet_end],
+                );
+                for (channel, coefficient) in coefficients.iter().enumerate() {
+                    let real_index = channel * 2;
+                    let imag_index = real_index + 1;
+                    let coefficient_re = if channel.is_multiple_of(2) {
+                        simd.splat_f32s(coefficient.re)
+                    } else {
+                        simd.mul_f32s(cosine_vector, simd.splat_f32s(coefficient.re))
+                    };
+                    let coefficient_im = if channel.is_multiple_of(2) {
+                        simd.splat_f32s(coefficient.im)
+                    } else {
+                        simd.mul_f32s(cosine_vector, simd.splat_f32s(coefficient.im))
+                    };
+                    let real = simd.mul_add_f32s(
+                        basis_vector,
+                        coefficient_re,
+                        simd.partial_load_f32s(
+                            &self.sums[real_index]
+                                [ring_start + packet_start..ring_start + packet_end],
+                        ),
+                    );
+                    let imag = simd.mul_add_f32s(
+                        basis_vector,
+                        coefficient_im,
+                        simd.partial_load_f32s(
+                            &self.sums[imag_index]
+                                [ring_start + packet_start..ring_start + packet_end],
+                        ),
+                    );
+                    simd.partial_store_f32s(
+                        &mut self.sums[real_index]
+                            [ring_start + packet_start..ring_start + packet_end],
+                        real,
+                    );
+                    simd.partial_store_f32s(
+                        &mut self.sums[imag_index]
+                            [ring_start + packet_start..ring_start + packet_end],
+                        imag,
+                    );
+                }
+            } else {
+                if packet_end - packet_start == lanes {
+                    let ring_start = ring_start + packet_start;
+                    let ring_end = ring_start + lanes;
+                    let cosine = &self.cos_theta[ring_start..ring_end];
+                    let basis = &basis[packet_start..packet_end];
+                    let exponents = &lane_exponents[packet_start..packet_end];
+                    let zero = Complex32::new(0.0, 0.0);
+                    for (channel, coefficient) in coefficients.iter().enumerate() {
+                        let (even, odd) = if channel.is_multiple_of(2) {
+                            (*coefficient, zero)
+                        } else {
+                            (zero, *coefficient)
+                        };
+                        let real_index = channel * 2;
+                        let imag_index = real_index + 1;
+                        let (real_rows, imag_rows) = self.sums.split_at_mut(imag_index);
+                        let real = &mut real_rows[real_index][ring_start..ring_end];
+                        let imag = &mut imag_rows[0][ring_start..ring_end];
+                        match try_accumulate_f32_scaled_synthesis_packet(
+                            simd, cosine, basis, exponents, real, imag, even, odd,
+                        ) {
+                            Some(true) => {}
+                            Some(false) | None => {
+                                // Do not commit this block if a full scaled packet
+                                // cannot be handled by the checked SIMD helper.
+                                *self.completed = false;
+                                return Ok(());
+                            }
+                        }
+                    }
+                } else {
+                    for lane in packet_start..packet_end {
+                        let ring = ring_start + lane;
+                        for (channel, coefficient) in coefficients.iter().enumerate() {
+                            let coefficient = if channel.is_multiple_of(2) {
+                                *coefficient
+                            } else {
+                                *coefficient * self.cos_theta[ring]
+                            };
+                            let contribution = super::super::scalar::multiply_complex_scaled_f32(
+                                coefficient,
+                                basis[lane],
+                                lane_exponents[lane],
+                            );
+                            let real_index = channel * 2;
+                            let imag_index = real_index + 1;
+                            let real = self.sums[real_index][ring] + contribution.re;
+                            let imag = self.sums[imag_index][ring] + contribution.im;
+                            if !real.is_finite() || !imag.is_finite() {
+                                *self.completed = false;
+                                return Ok(());
+                            }
+                            self.sums[real_index][ring] = real;
+                            self.sums[imag_index][ring] = imag;
+                        }
+                    }
+                }
+            }
+        }
+        Ok(())
+    }
+}
+
 #[cfg(feature = "parallel")]
 struct FusedHemispherePairBlock<'a> {
     pair_count: usize,
