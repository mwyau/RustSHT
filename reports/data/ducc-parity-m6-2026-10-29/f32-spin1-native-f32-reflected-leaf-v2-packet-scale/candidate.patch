 }
+
+#[test]
+fn f32_reflected_scaled_even_and_odd_rows_match_checked_scalar_products() {
+    let lane_count = Arch::new().dispatch(F32LaneCount);
+    let cosine = (0..lane_count)
+        .map(|lane| -0.45 + 0.1 * lane as f32)
+        .collect::<Vec<_>>();
+    let basis = (0..lane_count)
+        .map(|lane| 0.75 + 0.025 * lane as f32)
+        .collect::<Vec<_>>();
+    let exponents = (0..lane_count)
+        .map(|lane| [-300, -150, -149, -29, -20, -8, 7, 128][lane % 8])
+        .collect::<Vec<_>>();
+    let coefficient = Complex32::new(0.375, -0.25);
+
+    for odd_row in [false, true] {
+        let (result, actual_real, actual_imag) = Arch::new().dispatch(AccumulateScaledRow {
+            cosine: &cosine,
+            basis: &basis,
+            exponents: &exponents,
+            coefficient,
+            odd_row,
+        });
+        assert_eq!(result, Some(true));
+        let expected = (0..lane_count)
+            .map(|lane| {
+                let row_coefficient = if odd_row {
+                    Complex32::new(
+                        coefficient.re.mul_add(cosine[lane], 0.0),
+                        coefficient.im.mul_add(cosine[lane], 0.0),
+                    )
+                } else {
+                    coefficient
+                };
+                let contribution = crate::legendre::scalar::multiply_complex_scaled_f32(
+                    row_coefficient,
+                    basis[lane],
+                    exponents[lane],
+                );
+                Complex32::new(0.0 + contribution.re, 0.0 + contribution.im)
+            })
+            .collect::<Vec<_>>();
+        assert_same_bits(
+            &actual_real,
+            &expected.iter().map(|value| value.re).collect::<Vec<_>>(),
+        );
+        assert_same_bits(
+            &actual_imag,
+            &expected.iter().map(|value| value.im).collect::<Vec<_>>(),
+        );
+    }
+}
