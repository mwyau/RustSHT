 impl WithSimd for AccumulatePacket<'_> {
     type Output = (bool, Vec<f32>, Vec<f32>);
 
@@ -297,3 +331,55 @@ fn f32_scaled_packet_keeps_partial_simd_tail_on_exact_scalar_path() {
