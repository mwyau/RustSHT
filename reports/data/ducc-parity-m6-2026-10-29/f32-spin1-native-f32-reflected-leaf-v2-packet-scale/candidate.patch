+
+impl WithSimd for AccumulateScaledRow<'_> {
+    type Output = (Option<bool>, Vec<f32>, Vec<f32>);
+
+    fn with_simd<S: Simd>(self, simd: S) -> Self::Output {
+        let mut real = vec![0.0_f32; self.basis.len()];
+        let mut imag = vec![0.0_f32; self.basis.len()];
+        let zero = Complex32::new(0.0, 0.0);
+        let (even, odd) = if self.odd_row {
+            (zero, self.coefficient)
+        } else {
+            (self.coefficient, zero)
+        };
+        let result = try_accumulate_f32_scaled_synthesis_packet(
+            simd,
+            self.cosine,
+            self.basis,
+            self.exponents,
+            &mut real,
+            &mut imag,
+            even,
+            odd,
+        );
+        (result, real, imag)
+    }
+}
