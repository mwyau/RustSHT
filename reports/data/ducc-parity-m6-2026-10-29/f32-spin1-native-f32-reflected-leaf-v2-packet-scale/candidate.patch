 use super::*;
-use crate::{Complex64, GridKind, GridSpec, HarmonicSpec};
+use crate::{Complex32, Complex64, GridKind, GridSpec, HarmonicSpec};
+
+#[cfg(feature = "parallel")]
+#[test]
+fn native_f32_t720_reflected_spin1_leaf_activates_q1_q8_full_and_reduced() {
+    use std::sync::atomic::Ordering;
+
+    for (mmax, nphi) in [(720, 1458), (180, 378)] {
+        let plan = ShtPlan::<f32>::new(
+            GridSpec::new(GridKind::GaussLegendre, 721, nphi, 0.23).unwrap(),
+            HarmonicSpec::new(720, mmax, 1).unwrap(),
+        )
+        .unwrap();
+        let mut e = vec![Complex32::new(0.0, 0.0); plan.harmonics.nalm()];
+        let mut b = e.clone();
+        for m in 0..=mmax {
+            for degree in m.max(1)..=720 {
+                let index = plan.harmonics.index(degree, m).unwrap();
+                let scale = 1.0 / 721.0;
+                e[index] = Complex32::new(
+                    ((degree * 17 + m * 3) as f32).sin() * scale,
+                    if m == 0 {
+                        0.0
+                    } else {
+                        ((degree * 7 + m * 11) as f32).cos() * scale
+                    },
+                );
+                b[index] = Complex32::new(
+                    ((degree * 5 + m * 13) as f32).cos() * scale,
+                    if m == 0 {
+                        0.0
+                    } else {
+                        ((degree * 19 + m) as f32).sin() * scale
+                    },
+                );
+            }
+        }
+
+        for threads in [1, 8] {
+            let pool = rayon::ThreadPoolBuilder::new()
+                .num_threads(threads)
+                .build()
+                .unwrap();
+            let mut workspace = pool.install(|| plan.workspace()).unwrap();
+            let mut selected_q = vec![f32::NAN; plan.sample_count];
+            let mut selected_u = vec![f32::NAN; plan.sample_count];
+            F32_REFLECTED_PAIR_SUCCESSES.store(0, Ordering::Relaxed);
+            F32_REFLECTED_PAIR_ATTEMPTS.store(0, Ordering::Relaxed);
+            F32_REFLECTED_PAIR_DECLINES.store(0, Ordering::Relaxed);
+            pool.install(|| {
+                plan.synthesis_spin_into(&e, &b, &mut selected_q, &mut selected_u, &mut workspace)
+            })
+            .unwrap();
+            let successes = F32_REFLECTED_PAIR_SUCCESSES.load(Ordering::Relaxed);
+            let attempts = F32_REFLECTED_PAIR_ATTEMPTS.load(Ordering::Relaxed);
+            let declines = F32_REFLECTED_PAIR_DECLINES.load(Ordering::Relaxed);
+            assert!(
+                successes > 0,
+                "GL T720 M{mmax} q{threads} did not execute the f32 reflected leaf"
+            );
+            eprintln!(
+                "GL T720 M{mmax} q{threads} reflected f32 leaf attempts={attempts} successes={successes} declines={declines}"
+            );
+            assert!(
+                selected_q
+                    .iter()
+                    .chain(&selected_u)
+                    .all(|value| value.is_finite())
+            );
+            let first_q = selected_q.clone();
+            let first_u = selected_u.clone();
+            selected_q.fill(f32::NAN);
+            selected_u.fill(f32::NAN);
+            F32_REFLECTED_PAIR_SUCCESSES.store(0, Ordering::Relaxed);
+            F32_REFLECTED_PAIR_ATTEMPTS.store(0, Ordering::Relaxed);
+            F32_REFLECTED_PAIR_DECLINES.store(0, Ordering::Relaxed);
+            pool.install(|| {
+                plan.synthesis_spin_into(&e, &b, &mut selected_q, &mut selected_u, &mut workspace)
+            })
+            .unwrap();
+            assert!(F32_REFLECTED_PAIR_SUCCESSES.load(Ordering::Relaxed) > 0);
+            assert!(
+                selected_q
+                    .iter()
+                    .zip(first_q)
+                    .all(|(a, b)| a.to_bits() == b.to_bits())
+            );
+            assert!(
+                selected_u
+                    .iter()
+                    .zip(first_u)
+                    .all(|(a, b)| a.to_bits() == b.to_bits())
+            );
+        }
+    }
+}
 
