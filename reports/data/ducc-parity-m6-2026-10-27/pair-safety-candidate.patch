diff --git a/src/legendre/scalar_paired/analysis/tests.rs b/src/legendre/scalar_paired/analysis/tests.rs
index 3d8a055c..b8b10bf3 100644
--- a/src/legendre/scalar_paired/analysis/tests.rs
+++ b/src/legendre/scalar_paired/analysis/tests.rs
@@ -901,0 +902,79 @@ fn analysis_products_safe_simd_matches_ieee_boundaries() {
+#[test]
+fn analysis_channel_pair_safety_matches_independent_checks() {
+    for lane_count in [0, 1, 3, 4, 5, 8, 9, LATITUDE_BLOCK_SIZE] {
+        let max_input = f64::MAX / scalar::BIG / (2.0 * lane_count.max(1) as f64);
+        let q = [
+            vec![0.5; lane_count],
+            vec![-0.25; lane_count],
+            vec![f64::MIN_POSITIVE; lane_count],
+            vec![-0.0; lane_count],
+        ];
+        let u = [
+            vec![0.375; lane_count],
+            vec![0.125; lane_count],
+            vec![-0.75; lane_count],
+            vec![0.0; lane_count],
+        ];
+        let cosine = vec![1.0; lane_count];
+        let check = |q: [&[f64]; 4], u: [&[f64]; 4], cosine: &[f64]| {
+            let expected = [
+                analysis_products_safe(q[0], q[1], q[2], q[3], cosine),
+                analysis_products_safe(u[0], u[1], u[2], u[3], cosine),
+            ];
+            assert_eq!(
+                analysis_channels_products_safe(
+                    [q[0], u[0]],
+                    [q[1], u[1]],
+                    [q[2], u[2]],
+                    [q[3], u[3]],
+                    cosine,
+                ),
+                expected,
+                "lane_count={lane_count}"
+            );
+        };
+        let q_refs = [&q[0][..], &q[1], &q[2], &q[3]];
+        let u_refs = [&u[0][..], &u[1], &u[2], &u[3]];
+        check(q_refs, u_refs, &cosine);
+
+        for channel in 0..2 {
+            for component in 0..4 {
+                for lane in 0..lane_count {
+                    for invalid in [
+                        f64::NAN,
+                        f64::INFINITY,
+                        -f64::INFINITY,
+                        f64::MIN_POSITIVE * 0.5,
+                        f64::from_bits(max_input.to_bits() + 1),
+                    ] {
+                        let mut changed = vec![0.5; lane_count];
+                        changed[lane] = invalid;
+                        let mut q_values = q_refs;
+                        let mut u_values = u_refs;
+                        if channel == 0 {
+                            q_values[component] = &changed;
+                        } else {
+                            u_values[component] = &changed;
+                        }
+                        check(q_values, u_values, &cosine);
+                    }
+                }
+            }
+        }
+
+        for lane in 0..lane_count {
+            for invalid in [
+                f64::NAN,
+                f64::INFINITY,
+                -f64::INFINITY,
+                1.0 + f64::EPSILON,
+                -1.0 - f64::EPSILON,
+            ] {
+                let mut changed = cosine.clone();
+                changed[lane] = invalid;
+                check(q_refs, u_refs, &changed);
+            }
+        }
+    }
+}
+
