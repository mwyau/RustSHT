+/// Checks two spin-analysis channels together, sharing cosine validation and
+/// the SIMD lane traversal while keeping each channel's safety result separate.
+pub(crate) fn analysis_channels_products_safe(
+    same_real: [&[f64]; 2],
+    same_imag: [&[f64]; 2],
+    opposite_real: [&[f64]; 2],
+    opposite_imag: [&[f64]; 2],
+    cos_theta: &[f64],
+) -> [bool; 2] {
+    for channel in 0..2 {
+        debug_assert_eq!(same_real[channel].len(), same_imag[channel].len());
+        debug_assert_eq!(same_real[channel].len(), opposite_real[channel].len());
+        debug_assert_eq!(same_real[channel].len(), opposite_imag[channel].len());
+        debug_assert_eq!(same_real[channel].len(), cos_theta.len());
+    }
+    analysis_products_safe_channels(
+        same_real,
+        same_imag,
+        opposite_real,
+        opposite_imag,
+        cos_theta,
+    )
+}
