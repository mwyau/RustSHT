+def scheduler_totals(pid: int) -> tuple[int, int] | None:
+    task_dir = Path(f"/proc/{pid}/task")
+    try:
+        tasks = list(task_dir.iterdir())
+    except OSError:
+        return None
+    runtime_ns = wait_ns = 0
+    found = False
+    for task in tasks:
+        try:
+            fields = (task / "schedstat").read_text().split()
+            runtime_ns += int(fields[0])
+            wait_ns += int(fields[1])
+            found = True
+        except (OSError, ValueError, IndexError):
+            continue
+    return (runtime_ns, wait_ns) if found else None
+
+
