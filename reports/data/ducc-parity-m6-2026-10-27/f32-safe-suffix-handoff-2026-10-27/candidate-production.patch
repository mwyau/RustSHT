+#[test]
+fn f32_paired_handoff_preserves_the_rotated_recurrence_state() {
+    let m = 0;
+    let lmax = 8;
+    let sin_theta = (0..9)
+        .map(|ring| 0.2_f32 + 0.07 * ring as f32)
+        .collect::<Vec<_>>();
+    let cos_theta = sin_theta
+        .iter()
+        .map(|sine| (1.0 - sine * sine).sqrt())
+        .collect::<Vec<_>>();
+    let mut epsilon = vec![0.0_f32; lmax + 4];
+    fill_epsilon(m, lmax, &mut epsilon);
+    let factor_count = lmax / 2 + 2;
+    let mut alpha = vec![0.0_f32; factor_count];
+    let mut coefficient_a = vec![0.0_f32; factor_count];
+    let mut coefficient_b = vec![0.0_f32; factor_count];
+    assert!(fill_paired_scalar_factors(
+        m,
+        lmax,
+        &epsilon,
+        &mut alpha,
+        &mut coefficient_a,
+        &mut coefficient_b,
+    ));
+    let sectoral_norm = sectoral_normalizations(m).unwrap()[m];
+
+    for arch in [Arch::Scalar, Arch::new()] {
+        for pair_start in [1, 2, 3] {
+            let mut previous = vec![0.0_f32; sin_theta.len()];
+            let mut current = vec![0.0_f32; sin_theta.len()];
+            let mut next = vec![0.0_f32; sin_theta.len()];
+            let mut exponents = vec![0_i64; sin_theta.len()];
+            let mut saved_previous = None;
+            let mut saved_current = None;
+            let completed = super::super::super::scalar_paired::for_each_y_lm_paired_status_until_dispatched_typed::<f32, _>(
+                arch,
+                m,
+                lmax,
+                &sin_theta,
+                &cos_theta,
+                sectoral_norm,
+                &coefficient_a,
+                &coefficient_b,
+                &mut previous,
+                &mut current,
+                &mut next,
+                &mut exponents,
+                |degree, _ring_start, pair_previous, pair_current, lane_exponents, normal_range| {
+                    if (degree - m) / 2 == pair_start {
+                        assert!(normal_range);
+                        assert!(lane_exponents.iter().all(|&exponent| exponent == 0));
+                        saved_previous = Some(pair_previous.to_vec());
+                        saved_current = Some(pair_current.to_vec());
+                        Ok(false)
+                    } else {
+                        Ok(true)
+                    }
+                },
+            )
+            .unwrap();
+
+            assert!(!completed);
+            let (rotated_previous, rotated_current) = match pair_start % 3 {
+                0 => (&previous, &current),
+                1 => (&current, &next),
+                _ => (&next, &previous),
+            };
+            assert_eq!(saved_previous.as_deref(), Some(rotated_previous.as_slice()));
+            assert_eq!(saved_current.as_deref(), Some(rotated_current.as_slice()));
+        }
+    }
+}
