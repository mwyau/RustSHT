 use super::*;
 
+#[inline(always)]
+fn rotate_spectrum_by_phase<T: ShtScalar>(spectrum: Complex<T>, phase: Complex<T>) -> Complex<T> {
+    Complex::new(
+        spectrum.re.mul_add(phase.re, -(spectrum.im * phase.im)),
+        spectrum.im.mul_add(phase.re, spectrum.re * phase.im),
+    )
+}
