new file mode 100644
index 00000000..bc2421d6
--- /dev/null
+++ b/examples/m6_spin1_analysis_callgrind.rs
@@ -0,0 +1,48 @@
+use std::error::Error;
+use std::fs;
+use std::io::Write;
+use std::time::Instant;
+use rustsht::{Complex64, GridKind, GridSpec, HarmonicSpec, ShtPlan, ShtWorkspace};
+unsafe extern "C" { fn m6_callgrind_zero(); fn m6_callgrind_start(); fn m6_callgrind_stop(); }
+fn read_f64(path: &str, count: usize) -> Result<Vec<f64>, Box<dyn Error>> {
+    let bytes = fs::read(path)?;
+    if bytes.len() != count * 8 { return Err(format!("wrong f64 length in {path}").into()); }
+    Ok(bytes.chunks_exact(8).map(|chunk| f64::from_le_bytes(chunk.try_into().unwrap())).collect())
+}
+fn write_complex(path: &str, values: &[Complex64]) -> Result<(), Box<dyn Error>> {
+    let mut file = fs::File::create(path)?;
+    for value in values { file.write_all(&value.re.to_le_bytes())?; file.write_all(&value.im.to_le_bytes())?; }
+    Ok(())
+}
+fn same_bits(a: &[Complex64], b: &[Complex64]) -> bool {
+    a.len() == b.len() && a.iter().zip(b).all(|(x, y)| x.re.to_bits() == y.re.to_bits() && x.im.to_bits() == y.im.to_bits())
+}
+fn run_once(plan: &ShtPlan, map0: &[f64], map1: &[f64], e: &mut [Complex64], b: &mut [Complex64], workspace: &mut ShtWorkspace) -> Result<(), Box<dyn Error>> {
+    plan.analysis_spin_into(map0, map1, e, b, workspace)?;
+    std::hint::black_box((&*e, &*b));
+    Ok(())
+}
+fn main() -> Result<(), Box<dyn Error>> {
+    let args: Vec<String> = std::env::args().collect();
+    if args.len() != 12 || args[1] != "--worker" { return Err("usage: --worker THREADS NTHETA NPHI LMAX MMAX PHI0 MAP0 MAP1 OUTE OUTB".into()); }
+    let threads: usize = args[2].parse()?; let ntheta: usize = args[3].parse()?; let nphi: usize = args[4].parse()?;
+    let lmax: usize = args[5].parse()?; let mmax: usize = args[6].parse()?; let phi0: f64 = args[7].parse()?;
+    let nalm = (mmax + 1) * (lmax + 1) - mmax * (mmax + 1) / 2; let map_count = ntheta * nphi;
+    let map0 = read_f64(&args[8], map_count)?; let map1 = read_f64(&args[9], map_count)?;
+    let mut e = vec![Complex64::new(0.0, 0.0); nalm]; let mut b = vec![Complex64::new(0.0, 0.0); nalm];
+    rayon::ThreadPoolBuilder::new().num_threads(threads).build_global()?;
+    let plan = ShtPlan::new(GridSpec::new(GridKind::GaussLegendre, ntheta, nphi, phi0)?, HarmonicSpec::new(lmax, mmax, 1)?)?;
+    let mut workspace = plan.workspace()?; plan.prepare_workspace(&mut workspace, threads)?;
+    run_once(&plan, &map0, &map1, &mut e, &mut b, &mut workspace)?;
+    let expected_e = e.clone(); let expected_b = b.clone();
+    for _ in 0..2 { run_once(&plan, &map0, &map1, &mut e, &mut b, &mut workspace)?; assert!(same_bits(&expected_e, &e) && same_bits(&expected_b, &b), "warm analysis changed output"); }
+    let started = Instant::now();
+    unsafe { m6_callgrind_zero(); m6_callgrind_start(); }
+    run_once(&plan, &map0, &map1, &mut e, &mut b, &mut workspace)?;
+    unsafe { m6_callgrind_stop(); }
+    let elapsed_ms = started.elapsed().as_secs_f64() * 1.0e3;
+    assert!(same_bits(&expected_e, &e) && same_bits(&expected_b, &b), "profiled analysis changed output");
+    write_complex(&args[10], &e)?; write_complex(&args[11], &b)?;
+    eprintln!("PROFILE_DONE backend=rustsht q={threads} elapsed_ms={elapsed_ms:.3} nalm={nalm}");
+    Ok(())
+}
