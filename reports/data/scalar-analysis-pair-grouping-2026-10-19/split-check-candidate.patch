+#[cfg(target_arch = "x86_64")]
+#[target_feature(enable = "avx2")]
+#[inline]
+unsafe fn analysis_mask_all_avx2(mask: core::arch::x86_64::__m256d) -> bool {
+    use core::arch::x86_64::_mm256_movemask_pd;
+    _mm256_movemask_pd(mask) == 0b1111
+}
+
+#[inline(always)]
+fn analysis_mask_all_fast<S: Simd>(simd: S, mask: S::m64s) -> bool {
+    #[cfg(target_arch = "x86_64")]
+    if S::F64_LANES == 4 {
+        // The four-lane x86 backends guarantee AVX2. Their Pulp mask has the
+        // same four-lane representation as a 256-bit packed double mask.
+        let mask =
+            unsafe { core::mem::transmute_copy::<S::m64s, core::arch::x86_64::__m256d>(&mask) };
+        return unsafe { analysis_mask_all_avx2(mask) };
+    }
+    analysis_mask_all(simd, mask)
+}
