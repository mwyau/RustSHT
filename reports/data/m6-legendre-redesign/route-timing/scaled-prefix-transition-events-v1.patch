+#[cfg(test)]
+#[derive(Default)]
+struct PrefixScaleEvents {
+    initial_normalize_calls: u64,
+    initial_normalize_lane_visits: u64,
+    initial_exponent_change_lanes: u64,
+    initial_abs_exponent_shift: u64,
+    prefix_normalize_calls: u64,
+    prefix_normalize_lane_visits: u64,
+    prefix_exponent_change_lanes: u64,
+    prefix_abs_exponent_shift: u64,
+    prefix_scale_probes: u64,
+    prefix_scale_probe_triggers: u64,
+    prefix_rebase_events: u64,
+    prefix_abs_rebase_shift: u64,
+}
+
+#[cfg(test)]
+impl PrefixScaleEvents {
+    fn record_normalization(&mut self, before: &[i64], after: &[i64], initial: bool) {
+        debug_assert_eq!(before.len(), after.len());
+        let mut changed = 0_u64;
+        let mut absolute_shift = 0_u64;
+        for (&old, &new) in before.iter().zip(after) {
+            if old != new {
+                changed += 1;
+                absolute_shift = absolute_shift.saturating_add(old.abs_diff(new));
+            }
+        }
+        if initial {
+            self.initial_normalize_calls += 1;
+            self.initial_normalize_lane_visits += after.len() as u64;
+            self.initial_exponent_change_lanes += changed;
+            self.initial_abs_exponent_shift = self
+                .initial_abs_exponent_shift
+                .saturating_add(absolute_shift);
+        } else {
+            self.prefix_normalize_calls += 1;
+            self.prefix_normalize_lane_visits += after.len() as u64;
+            self.prefix_exponent_change_lanes += changed;
+            self.prefix_abs_exponent_shift = self
+                .prefix_abs_exponent_shift
+                .saturating_add(absolute_shift);
+        }
+    }
+}
+
+#[cfg(test)]
+impl Drop for PrefixScaleEvents {
+    fn drop(&mut self) {
+        update_route_counts(|counts| {
+            counts.initial_normalize_calls += self.initial_normalize_calls;
+            counts.initial_normalize_lane_visits += self.initial_normalize_lane_visits;
+            counts.initial_exponent_change_lanes += self.initial_exponent_change_lanes;
+            counts.initial_abs_exponent_shift += self.initial_abs_exponent_shift;
+            counts.prefix_normalize_calls += self.prefix_normalize_calls;
+            counts.prefix_normalize_lane_visits += self.prefix_normalize_lane_visits;
+            counts.prefix_exponent_change_lanes += self.prefix_exponent_change_lanes;
+            counts.prefix_abs_exponent_shift += self.prefix_abs_exponent_shift;
+            counts.prefix_scale_probes += self.prefix_scale_probes;
+            counts.prefix_scale_probe_triggers += self.prefix_scale_probe_triggers;
+            counts.prefix_rebase_events += self.prefix_rebase_events;
+            counts.prefix_abs_rebase_shift += self.prefix_abs_rebase_shift;
+        });
+    }
+}
