+#[inline]
+fn product_preserves_scaled_range(left: f64, right: f64, product: f64) -> bool {
+    if left == 0.0 || right == 0.0 {
+        product == 0.0
+    } else {
+        product.is_normal()
+    }
+}
+
+fn flush_prefix_lane(
+    lane: usize,
+    new_exponent: i64,
+    prefix_sum_re: &mut [f64],
+    prefix_sum_im: &mut [f64],
+    prefix_exponents: &mut [i64],
+    sum_re: &mut [f64],
+    sum_im: &mut [f64],
+) -> bool {
+    let contribution_re = scalar::scale_binary(prefix_sum_re[lane], prefix_exponents[lane]);
+    let contribution_im = scalar::scale_binary(prefix_sum_im[lane], prefix_exponents[lane]);
+    let next_re = sum_re[lane] + contribution_re;
+    let next_im = sum_im[lane] + contribution_im;
+    if !next_re.is_finite()
+        || !next_im.is_finite()
+        || next_re.abs() > f64::MAX * 0.5
+        || next_im.abs() > f64::MAX * 0.5
+    {
+        return false;
+    }
+    sum_re[lane] = next_re;
+    sum_im[lane] = next_im;
+    prefix_sum_re[lane] = 0.0;
+    prefix_sum_im[lane] = 0.0;
+    prefix_exponents[lane] = new_exponent;
+    true
+}
+
+fn flush_changed_prefix_lanes(
+    exponents: &[i64],
+    prefix_sum_re: &mut [f64],
+    prefix_sum_im: &mut [f64],
+    prefix_exponents: &mut [i64],
+    sum_re: &mut [f64],
+    sum_im: &mut [f64],
+) -> bool {
+    for (lane, &exponent) in exponents.iter().enumerate() {
+        if prefix_exponents[lane] != exponent
+            && !flush_prefix_lane(
+                lane,
+                exponent,
+                prefix_sum_re,
+                prefix_sum_im,
+                prefix_exponents,
+                sum_re,
+                sum_im,
+            )
+        {
+            return false;
+        }
+    }
+    true
+}
+
+fn flush_all_prefix_lanes(
+    exponents: &[i64],
+    prefix_sum_re: &mut [f64],
+    prefix_sum_im: &mut [f64],
+    prefix_exponents: &mut [i64],
+    sum_re: &mut [f64],
+    sum_im: &mut [f64],
+) -> bool {
+    for (lane, &exponent) in exponents.iter().enumerate() {
+        if !flush_prefix_lane(
+            lane,
+            exponent,
+            prefix_sum_re,
+            prefix_sum_im,
+            prefix_exponents,
+            sum_re,
+            sum_im,
+        ) {
+            return false;
+        }
+    }
+    true
+}
