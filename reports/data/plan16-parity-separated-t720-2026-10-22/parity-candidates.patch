+#[cfg(rustsht_spin1_parity_separated_one_channel)]
+struct FusedPreparedSynthesisParityChannelBlock<'a> {
+    pair_count: usize,
+    cos_theta: &'a [f64],
+    coefficient_a: &'a [f64],
+    coefficient_b: &'a [f64],
+    even: &'a [Complex64],
+    odd: &'a [Complex64],
+    current: &'a [f64],
+    sum_re: &'a mut [f64],
+    sum_im: &'a mut [f64],
+}
+
+#[cfg(rustsht_spin1_parity_separated_one_channel)]
+impl WithSimd for FusedPreparedSynthesisParityChannelBlock<'_> {
+    type Output = ();
+
+    #[inline(always)]
+    fn with_simd<S: Simd>(self, simd: S) {
+        let FusedPreparedSynthesisParityChannelBlock {
+            pair_count,
+            cos_theta,
+            coefficient_a,
+            coefficient_b,
+            even,
+            odd,
+            current,
+            sum_re,
+            sum_im,
+        } = self;
+        let (cosine_vectors, cosine_tail) = S::as_simd_f64s(cos_theta);
+        let (initial_vectors, initial_tail) = S::as_simd_f64s(current);
+        let (sum_re_vectors, sum_re_tail) = S::as_mut_simd_f64s(sum_re);
+        let (sum_im_vectors, sum_im_tail) = S::as_mut_simd_f64s(sum_im);
+
+        for lane_block in 0..cosine_vectors.len() {
+            let cosine = cosine_vectors[lane_block];
+            let mut previous = simd.splat_f64s(0.0);
+            let mut current = initial_vectors[lane_block];
+            let mut even_re = simd.splat_f64s(0.0);
+            let mut even_im = simd.splat_f64s(0.0);
+            let mut odd_re = simd.splat_f64s(0.0);
+            let mut odd_im = simd.splat_f64s(0.0);
+
+            for pair in 0..pair_count {
+                even_re = simd.mul_add_f64s(current, simd.splat_f64s(even[pair].re), even_re);
+                even_im = simd.mul_add_f64s(current, simd.splat_f64s(even[pair].im), even_im);
+                odd_re = simd.mul_add_f64s(current, simd.splat_f64s(odd[pair].re), odd_re);
+                odd_im = simd.mul_add_f64s(current, simd.splat_f64s(odd[pair].im), odd_im);
+
+                if pair + 1 < pair_count {
+                    let cosine_squared = simd.mul_f64s(cosine, cosine);
+                    let leading = simd.mul_add_f64s(
+                        simd.splat_f64s(coefficient_a[pair]),
+                        cosine_squared,
+                        simd.splat_f64s(coefficient_b[pair]),
+                    );
+                    let next = simd.mul_add_f64s(leading, current, previous);
+                    previous = current;
+                    current = next;
+                }
+            }
+
+            sum_re_vectors[lane_block] = simd.mul_add_f64s(cosine, odd_re, even_re);
+            sum_im_vectors[lane_block] = simd.mul_add_f64s(cosine, odd_im, even_im);
+        }
+
+        for lane in 0..cosine_tail.len() {
+            let cosine = cosine_tail[lane];
+            let mut previous = 0.0;
+            let mut current = initial_tail[lane];
+            let mut even_re = 0.0;
+            let mut even_im = 0.0;
+            let mut odd_re = 0.0;
+            let mut odd_im = 0.0;
+
+            for pair in 0..pair_count {
+                even_re = current.mul_add(even[pair].re, even_re);
+                even_im = current.mul_add(even[pair].im, even_im);
+                odd_re = current.mul_add(odd[pair].re, odd_re);
+                odd_im = current.mul_add(odd[pair].im, odd_im);
+
+                if pair + 1 < pair_count {
+                    let leading = coefficient_a[pair].mul_add(cosine * cosine, coefficient_b[pair]);
+                    let next = leading.mul_add(current, previous);
+                    previous = current;
+                    current = next;
+                }
+            }
+
+            sum_re_tail[lane] = cosine.mul_add(odd_re, even_re);
+            sum_im_tail[lane] = cosine.mul_add(odd_im, even_im);
+        }
+    }
+}
