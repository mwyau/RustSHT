+/// Experimental DUCC-like parity-separated accumulation for the spin-1
+/// scalar-conversion route. It keeps each parity contribution in an
+/// independent register accumulator, then combines parities once per lane.
+/// Results are checked and staged before either spectrum is modified.
+#[cfg(rustsht_spin1_parity_separated)]
+#[expect(
+    clippy::too_many_arguments,
+    reason = "The experimental paired parity kernel receives bounded caller-owned worker scratch."
+)]
+pub(crate) fn synthesize_prepared_order_pair_parity_block_dispatched(
+    arch: Arch,
+    m: usize,
+    lmax: usize,
+    sin_theta: &[f64],
+    cos_theta: &[f64],
+    sectoral_norm: f64,
+    coefficient_a: &[f64],
+    coefficient_b: &[f64],
+    first_even: &[Complex64],
+    first_odd: &[Complex64],
+    second_even: &[Complex64],
+    second_odd: &[Complex64],
+    ring_order_limits: &[usize],
+    spectrum_len: usize,
+    first_spectra: &mut [Complex64],
+    second_spectra: &mut [Complex64],
+    previous: &mut [f64],
+    current: &mut [f64],
+    next: &mut [f64],
+    exponents: &mut [i64],
+    first_sum_re: &mut [f64],
+    first_sum_im: &mut [f64],
+    second_sum_re: &mut [f64],
+    second_sum_im: &mut [f64],
+) -> Result<bool, ShtError> {
+    let lane_count = sin_theta.len();
+    debug_assert_eq!(lane_count, cos_theta.len());
+    debug_assert_eq!(lane_count, ring_order_limits.len());
+    debug_assert!(lane_count <= LATITUDE_BLOCK_SIZE);
+    debug_assert_eq!(first_spectra.len(), lane_count * spectrum_len);
+    debug_assert_eq!(second_spectra.len(), first_spectra.len());
+    debug_assert!(previous.len() >= lane_count);
+    debug_assert!(current.len() >= lane_count);
+    debug_assert!(next.len() >= lane_count);
+    debug_assert!(exponents.len() >= lane_count);
+    debug_assert!(first_sum_re.len() >= lane_count);
+    debug_assert!(first_sum_im.len() >= lane_count);
+    debug_assert!(second_sum_re.len() >= lane_count);
+    debug_assert!(second_sum_im.len() >= lane_count);
+
+    let pair_count = (lmax - m + 2) / 2;
+    debug_assert!(coefficient_a.len() >= pair_count);
+    debug_assert!(coefficient_b.len() >= pair_count);
+    debug_assert!(first_even.len() >= pair_count);
+    debug_assert!(first_odd.len() >= pair_count);
+    debug_assert!(second_even.len() >= pair_count);
+    debug_assert!(second_odd.len() >= pair_count);
+    if lane_count == 0
+        || sin_theta
+            .iter()
+            .any(|&sine| !sine.is_finite() || sine < 0.01)
+        || cos_theta.iter().any(|&cosine| !cosine.is_finite())
+        || ring_order_limits.iter().any(|&limit| m > limit)
+    {
+        return Ok(false);
+    }
+
+    let coefficient_a = &coefficient_a[..pair_count];
+    let coefficient_b = &coefficient_b[..pair_count];
+    let first_even = &first_even[..pair_count];
+    let first_odd = &first_odd[..pair_count];
+    let second_even = &second_even[..pair_count];
+    let second_odd = &second_odd[..pair_count];
+
+    for lane in 0..lane_count {
+        let (value, exponent) = scalar::sectoral_value(sin_theta[lane], m, sectoral_norm)?;
+        previous[lane] = 0.0;
+        current[lane] = value;
+        exponents[lane] = exponent;
+    }
+    if !scalar::normalize_pair_lanes(
+        &mut previous[..lane_count],
+        &mut current[..lane_count],
+        &mut exponents[..lane_count],
+    )? {
+        return Ok(false);
+    }
+
+    arch.dispatch(FusedPreparedSynthesisParityPairBlock {
+        pair_count,
+        cos_theta,
+        coefficient_a,
+        coefficient_b,
+        first_even,
+        first_odd,
+        second_even,
+        second_odd,
+        current: &current[..lane_count],
+        first_sum_re: &mut first_sum_re[..lane_count],
+        first_sum_im: &mut first_sum_im[..lane_count],
+        second_sum_re: &mut second_sum_re[..lane_count],
+        second_sum_im: &mut second_sum_im[..lane_count],
+    });
+
+    if !finite_prefix_sums(
+        &first_sum_re[..lane_count],
+        &first_sum_im[..lane_count],
+        &second_sum_re[..lane_count],
+        &second_sum_im[..lane_count],
+    ) || !lane_values_in_normal_range(&first_sum_re[..lane_count])
+        || !lane_values_in_normal_range(&first_sum_im[..lane_count])
+        || !lane_values_in_normal_range(&second_sum_re[..lane_count])
+        || !lane_values_in_normal_range(&second_sum_im[..lane_count])
+    {
+        return Ok(false);
+    }
+
+    // Validate every result before committing either channel. This prevents
+    // the experimental path from partially updating spectra before a checked
+    // fallback on a cancellation, subnormal or extreme lane.
+    for lane in 0..lane_count {
+        let first = Complex64::new(first_sum_re[lane], first_sum_im[lane]);
+        let second = Complex64::new(second_sum_re[lane], second_sum_im[lane]);
+        if !complex_components_in_normal_range(first) || !complex_components_in_normal_range(second)
+        {
+            return Ok(false);
+        }
+        let spectrum_index = lane * spectrum_len + m;
+        let next_first = first_spectra[spectrum_index] + first;
+        let next_second = second_spectra[spectrum_index] + second;
+        let inverse_sine = sin_theta[lane].recip();
+        let weighted_first = next_first * inverse_sine;
+        let weighted_second = next_second * inverse_sine;
+        if !complex_components_in_normal_range(next_first)
+            || !complex_components_in_normal_range(next_second)
+            || !complex_components_in_normal_range(weighted_first)
+            || !complex_components_in_normal_range(weighted_second)
+        {
+            return Ok(false);
+        }
+    }
+
+    for lane in 0..lane_count {
+        let spectrum_index = lane * spectrum_len + m;
+        first_spectra[spectrum_index] += Complex64::new(first_sum_re[lane], first_sum_im[lane]);
+        second_spectra[spectrum_index] += Complex64::new(second_sum_re[lane], second_sum_im[lane]);
+    }
+    Ok(true)
+}
