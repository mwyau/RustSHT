+    #[inline(always)]
+    fn with_simd<S: Simd>(self, simd: S) {
+        let FusedPreparedSynthesisParityPairBlock {
+            pair_count,
+            cos_theta,
+            coefficient_a,
+            coefficient_b,
+            first_even,
+            first_odd,
+            second_even,
