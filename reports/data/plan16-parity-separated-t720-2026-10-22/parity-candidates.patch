+        let (cosine_vectors, cosine_tail) = S::as_simd_f64s(cos_theta);
+        let (initial_vectors, initial_tail) = S::as_simd_f64s(current);
+        let (first_sum_re_vectors, first_sum_re_tail) = S::as_mut_simd_f64s(first_sum_re);
+        let (first_sum_im_vectors, first_sum_im_tail) = S::as_mut_simd_f64s(first_sum_im);
+        let (second_sum_re_vectors, second_sum_re_tail) = S::as_mut_simd_f64s(second_sum_re);
+        let (second_sum_im_vectors, second_sum_im_tail) = S::as_mut_simd_f64s(second_sum_im);
+
+        for lane_block in 0..cosine_vectors.len() {
+            let cosine = cosine_vectors[lane_block];
+            let mut previous = simd.splat_f64s(0.0);
+            let mut current = initial_vectors[lane_block];
+            let mut first_even_re = simd.splat_f64s(0.0);
+            let mut first_even_im = simd.splat_f64s(0.0);
+            let mut first_odd_re = simd.splat_f64s(0.0);
+            let mut first_odd_im = simd.splat_f64s(0.0);
+            let mut second_even_re = simd.splat_f64s(0.0);
+            let mut second_even_im = simd.splat_f64s(0.0);
+            let mut second_odd_re = simd.splat_f64s(0.0);
+            let mut second_odd_im = simd.splat_f64s(0.0);
+
+            for pair in 0..pair_count {
+                first_even_re =
+                    simd.mul_add_f64s(current, simd.splat_f64s(first_even[pair].re), first_even_re);
+                first_even_im =
+                    simd.mul_add_f64s(current, simd.splat_f64s(first_even[pair].im), first_even_im);
+                first_odd_re =
+                    simd.mul_add_f64s(current, simd.splat_f64s(first_odd[pair].re), first_odd_re);
+                first_odd_im =
+                    simd.mul_add_f64s(current, simd.splat_f64s(first_odd[pair].im), first_odd_im);
+                second_even_re = simd.mul_add_f64s(
+                    current,
+                    simd.splat_f64s(second_even[pair].re),
+                    second_even_re,
+                );
+                second_even_im = simd.mul_add_f64s(
+                    current,
+                    simd.splat_f64s(second_even[pair].im),
+                    second_even_im,
+                );
+                second_odd_re =
+                    simd.mul_add_f64s(current, simd.splat_f64s(second_odd[pair].re), second_odd_re);
+                second_odd_im =
+                    simd.mul_add_f64s(current, simd.splat_f64s(second_odd[pair].im), second_odd_im);
+
+                if pair + 1 < pair_count {
+                    let cosine_squared = simd.mul_f64s(cosine, cosine);
+                    let leading = simd.mul_add_f64s(
+                        simd.splat_f64s(coefficient_a[pair]),
+                        cosine_squared,
+                        simd.splat_f64s(coefficient_b[pair]),
+                    );
+                    let next = simd.mul_add_f64s(leading, current, previous);
+                    previous = current;
+                    current = next;
+                }
+            }
+
+            first_sum_re_vectors[lane_block] =
+                simd.mul_add_f64s(cosine, first_odd_re, first_even_re);
+            first_sum_im_vectors[lane_block] =
+                simd.mul_add_f64s(cosine, first_odd_im, first_even_im);
+            second_sum_re_vectors[lane_block] =
+                simd.mul_add_f64s(cosine, second_odd_re, second_even_re);
+            second_sum_im_vectors[lane_block] =
+                simd.mul_add_f64s(cosine, second_odd_im, second_even_im);
+        }
+
+        for lane in 0..cosine_tail.len() {
+            let cosine = cosine_tail[lane];
+            let mut previous = 0.0;
+            let mut current = initial_tail[lane];
+            let mut first_even_re = 0.0;
+            let mut first_even_im = 0.0;
+            let mut first_odd_re = 0.0;
+            let mut first_odd_im = 0.0;
+            let mut second_even_re = 0.0;
+            let mut second_even_im = 0.0;
+            let mut second_odd_re = 0.0;
+            let mut second_odd_im = 0.0;
+
+            for pair in 0..pair_count {
+                first_even_re = current.mul_add(first_even[pair].re, first_even_re);
+                first_even_im = current.mul_add(first_even[pair].im, first_even_im);
+                first_odd_re = current.mul_add(first_odd[pair].re, first_odd_re);
+                first_odd_im = current.mul_add(first_odd[pair].im, first_odd_im);
+                second_even_re = current.mul_add(second_even[pair].re, second_even_re);
+                second_even_im = current.mul_add(second_even[pair].im, second_even_im);
+                second_odd_re = current.mul_add(second_odd[pair].re, second_odd_re);
+                second_odd_im = current.mul_add(second_odd[pair].im, second_odd_im);
+
+                if pair + 1 < pair_count {
+                    let leading = coefficient_a[pair].mul_add(cosine * cosine, coefficient_b[pair]);
+                    let next = leading.mul_add(current, previous);
+                    previous = current;
+                    current = next;
+                }
+            }
+
+            first_sum_re_tail[lane] = cosine.mul_add(first_odd_re, first_even_re);
+            first_sum_im_tail[lane] = cosine.mul_add(first_odd_im, first_even_im);
+            second_sum_re_tail[lane] = cosine.mul_add(second_odd_re, second_even_re);
+            second_sum_im_tail[lane] = cosine.mul_add(second_odd_im, second_even_im);
+        }
+    }
+}
