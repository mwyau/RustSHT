+#[cfg(feature = "parallel")]
+#[test]
+#[ignore = "opt-in M1 spin-1 synthesis route accounting"]
+fn m6_spin1_synthesis_routes() {
+    use crate::{Complex64, GridKind, GridSpec, HarmonicSpec, ShtPlan};
+    use std::time::Instant;
+
+    let lmax: usize = std::env::var("RUSTSHT_ROUTE_LMAX")
+        .unwrap_or_else(|_| "511".into())
+        .parse()
+        .unwrap();
+    let threads: usize = std::env::var("RUSTSHT_ROUTE_THREADS")
+        .unwrap_or_else(|_| "1".into())
+        .parse()
+        .unwrap();
+    assert!(lmax >= 511, "profile the spin-1 recurrence path");
+    let pool = rayon::ThreadPoolBuilder::new()
+        .num_threads(threads)
+        .build()
+        .unwrap();
+    let plan = ShtPlan::new(
+        GridSpec::new(GridKind::GaussLegendre, lmax + 1, 2 * (lmax + 1), 0.37).unwrap(),
+        HarmonicSpec::new(lmax, lmax, 1).unwrap(),
+    )
+    .unwrap();
+    let mut workspace = pool.install(|| plan.workspace()).unwrap();
+    let mut e_alm = vec![Complex64::new(0.0, 0.0); plan.harmonics().nalm()];
+    let mut b_alm = e_alm.clone();
+    for m in 0..=lmax {
+        for l in m..=lmax {
+            if l < 1 {
+                continue;
+            }
+            e_alm[plan.harmonics().index(l, m).unwrap()] = Complex64::new(
+                ((l * 7 + m * 11) % 19) as f64 - 9.0,
+                if m == 0 {
+                    0.0
+                } else {
+                    ((l * 13 + m * 5) % 23) as f64 - 11.0
+                },
+            ) * 1e-5;
+            b_alm[plan.harmonics().index(l, m).unwrap()] = Complex64::new(
+                ((l * 3 + m * 7) % 17) as f64 - 8.0,
+                if m == 0 {
+                    0.0
+                } else {
+                    ((l * 5 + m * 17) % 29) as f64 - 14.0
+                },
+            ) * 1e-5;
+        }
+    }
+
+    let sample_count = (lmax + 1) * 2 * (lmax + 1);
+    let mut q_map = vec![0.0; sample_count];
+    let mut u_map = vec![0.0; sample_count];
+    let synthesize =
+        |q_map: &mut [f64], u_map: &mut [f64], workspace: &mut crate::ShtWorkspace<f64>| {
+            plan.synthesis_spin_into(&e_alm, &b_alm, q_map, u_map, workspace)
+                .unwrap();
+        };
+
+    // One warm-up and one uninstrumented map establish the same-process reference.
+    pool.install(|| synthesize(&mut q_map, &mut u_map, &mut workspace));
+    let disabled_start = Instant::now();
+    pool.install(|| synthesize(&mut q_map, &mut u_map, &mut workspace));
+    let disabled = disabled_start.elapsed();
+    let q_reference = q_map.clone();
+    let u_reference = u_map.clone();
+
+    pool.broadcast(|_| COUNTS.with_borrow_mut(|counts| *counts = Some(Counts::default())));
+    let enabled_start = Instant::now();
+    pool.install(|| synthesize(&mut q_map, &mut u_map, &mut workspace));
+    let enabled = enabled_start.elapsed();
+    assert!(
+        q_map
+            .iter()
+            .zip(&q_reference)
+            .all(|(actual, reference)| actual.to_bits() == reference.to_bits())
+    );
+    assert!(
+        u_map
+            .iter()
+            .zip(&u_reference)
+            .all(|(actual, reference)| actual.to_bits() == reference.to_bits())
+    );
+
+    let workers = pool.broadcast(|_| COUNTS.with_borrow_mut(Option::take));
+    let mut total = Counts::default();
+    macro_rules! sum_field {
+        ($counts:ident, $field:ident) => {
+            total.$field += $counts.$field;
+        };
+    }
+    for (worker, worker_counts) in workers.into_iter().enumerate() {
+        let counts = worker_counts.unwrap_or_default();
+        println!("worker={worker} {counts:?}");
+        sum_field!(counts, fused_ns);
+        sum_field!(counts, visitor_ns);
+        sum_field!(counts, transition_ns);
+        sum_field!(counts, coefficients_ns);
+        sum_field!(counts, factors_ns);
+        sum_field!(counts, transition_calls);
+        sum_field!(counts, preparation_failures);
+        sum_field!(counts, fused);
+        sum_field!(counts, visitor_normal);
+        sum_field!(counts, visitor_scaled);
+        sum_field!(counts, transition_prefix);
+        sum_field!(counts, transition_fused);
+        sum_field!(counts, discarded_prefix);
+        sum_field!(counts, discarded_fused);
+        sum_field!(counts, completed_transitions);
+        sum_field!(counts, declined_transitions);
+        sum_field!(counts, spin1_conversion_ns);
+        sum_field!(counts, spin1_cache_copy_ns);
+        sum_field!(counts, spin1_general_ns);
+        sum_field!(counts, spin1_scalar_visitor_ns);
+        sum_field!(counts, spin1_rescale_ns);
+        sum_field!(counts, spin1_hemisphere_ns);
+        sum_field!(counts, spin1_orders);
+        sum_field!(counts, spin1_cached_orders);
+        sum_field!(counts, spin1_converted_orders);
+        sum_field!(counts, spin1_scalar_blocks);
+        sum_field!(counts, spin1_general_degree_lanes);
+        sum_field!(counts, spin1_scalar_visitor_degree_lanes);
+        sum_field!(counts, spin1_rescale_lanes);
+        sum_field!(counts, spin1_hemisphere_pair_lanes);
+        sum_field!(counts, spin1_hemisphere_attempts);
+    }
+    assert!(total.spin1_orders > 0);
+    let mut hash = 0xcbf29ce484222325_u64;
+    for value in q_map.iter().chain(&u_map) {
+        for byte in value.to_bits().to_le_bytes() {
+            hash ^= u64::from(byte);
+            hash = hash.wrapping_mul(0x100000001b3);
+        }
+    }
+    println!(
+        "M1 spin1 routes L={lmax} q={threads} map_hash_fnv1a64={hash:016x} disabled_ms={:.3} enabled_ms={:.3} {total:?}",
+        disabled.as_secs_f64() * 1000.0,
+        enabled.as_secs_f64() * 1000.0
+    );
+}
