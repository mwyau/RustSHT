+            .unwrap();
+        let expected = 1.0e308 / (4.0 * std::f64::consts::PI).sqrt();
+        assert!(
+            map.iter()
+                .all(|&value| (value / expected - 1.0).abs() < 1.0e-14),
+            "nphi={nphi}, {map:?}"
+        );
+    }
+}
