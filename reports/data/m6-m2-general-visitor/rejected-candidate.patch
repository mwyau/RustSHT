+const NORMAL_PRODUCT_MIN_EXPONENT: i32 = -1021;
+const NORMAL_PRODUCT_MAX_EXPONENT: i32 = 1020;
+
+/// Classifies ordinary products once per coefficient pair and latitude block.
+/// A normal paired basis lane lies between the exponents of `SMALL` and `BIG`;
+/// the cosine bounds cover every lane in this block. The conservative product
+/// exponent interval leaves one exponent of headroom at both ends, so each
+/// multiply in `(coefficient * basis) * cosine` remains finite and normal.
+pub(crate) fn normal_synthesis_coefficients_safe(
+    coefficient_even: Complex64,
+    coefficient_odd: Complex64,
+    cos_theta: &[f64],
+) -> bool {
+    if cos_theta.is_empty() {
+        return false;
+    }
+    let basis_min_exponent = normal_binary_exponent(scalar::SMALL).expect("SMALL is normal");
+    let basis_max_exponent = normal_binary_exponent(scalar::BIG).expect("BIG is normal");
+    let mut cosine_min_exponent = i32::MAX;
+    let mut cosine_max_exponent = i32::MIN;
+    let mut has_zero_cosine = false;
+    for &cosine in cos_theta {
+        if cosine == 0.0 {
+            has_zero_cosine = true;
+            continue;
+        }
+        let Some(exponent) = normal_binary_exponent(cosine) else {
+            return false;
+        };
+        cosine_min_exponent = cosine_min_exponent.min(exponent);
+        cosine_max_exponent = cosine_max_exponent.max(exponent);
+    }
+
+    let even_safe = complex_component_product_range_safe(
+        coefficient_even,
+        basis_min_exponent,
+        basis_max_exponent,
+    );
+    if !even_safe {
+        return false;
+    }
+    let odd_is_zero = coefficient_odd.re == 0.0 && coefficient_odd.im == 0.0;
+    if odd_is_zero {
+        return true;
+    }
+    if has_zero_cosine {
+        return false;
+    }
+    complex_component_product_range_safe(coefficient_odd, basis_min_exponent, basis_max_exponent)
+        && complex_component_product_range_safe(
+            coefficient_odd,
+            basis_min_exponent + cosine_min_exponent,
+            basis_max_exponent + cosine_max_exponent,
+        )
+}
+
+/// Computes the same products and grouping as the scaled synthesis visitor
+/// after the block-level exponent guard proves ordinary product headroom.
+pub(crate) fn normal_synthesis_contribution(
+    coefficient_even: Complex64,
+    coefficient_odd: Complex64,
+    basis: f64,
+    cosine: f64,
+) -> Option<Complex64> {
+    let even_re = coefficient_even.re * basis;
+    let even_im = coefficient_even.im * basis;
+    let odd_re_initial = coefficient_odd.re * basis;
+    let odd_im_initial = coefficient_odd.im * basis;
+    let odd_re = odd_re_initial * cosine;
+    let odd_im = odd_im_initial * cosine;
+    if !product_is_normal_or_exact_zero(even_re, coefficient_even.re, basis)
+        || !product_is_normal_or_exact_zero(even_im, coefficient_even.im, basis)
+        || !product_is_normal_or_exact_zero(odd_re_initial, coefficient_odd.re, basis)
+        || !product_is_normal_or_exact_zero(odd_im_initial, coefficient_odd.im, basis)
+        || !product_is_normal_or_exact_zero(odd_re, odd_re_initial, cosine)
+        || !product_is_normal_or_exact_zero(odd_im, odd_im_initial, cosine)
+    {
+        return None;
+    }
+    let real = even_re + odd_re;
+    let imag = even_im + odd_im;
+    (real.is_normal() || real == 0.0)
+        .then_some(())
+        .filter(|()| imag.is_normal() || imag == 0.0)
+        .map(|()| Complex64::new(real, imag))
+}
+
+fn complex_component_product_range_safe(
+    value: Complex64,
+    factor_min_exponent: i32,
+    factor_max_exponent: i32,
+) -> bool {
+    [value.re, value.im].into_iter().all(|component| {
+        component_product_range_safe(component, factor_min_exponent, factor_max_exponent)
+    })
+}
+
+fn component_product_range_safe(
+    value: f64,
+    factor_min_exponent: i32,
+    factor_max_exponent: i32,
+) -> bool {
+    if value == 0.0 {
+        return true;
+    }
+    let Some(exponent) = normal_binary_exponent(value) else {
+        return false;
+    };
+    let min_product_exponent = exponent + factor_min_exponent;
+    let max_product_exponent = exponent + factor_max_exponent;
+    (NORMAL_PRODUCT_MIN_EXPONENT..=NORMAL_PRODUCT_MAX_EXPONENT).contains(&min_product_exponent)
+        && (NORMAL_PRODUCT_MIN_EXPONENT..=NORMAL_PRODUCT_MAX_EXPONENT)
+            .contains(&max_product_exponent)
+}
+
+fn normal_binary_exponent(value: f64) -> Option<i32> {
+    if !value.is_normal() {
+        return None;
+    }
+    Some(((value.to_bits() >> 52) & 0x7ff) as i32 - 1023)
+}
+
+fn product_is_normal_or_exact_zero(product: f64, left: f64, right: f64) -> bool {
+    product.is_normal() || (product == 0.0 && (left == 0.0 || right == 0.0))
+}
