+#[cfg(feature = "m6-legendre-profile")]
+#[inline(always)]
+fn m6_f32_pair_state_in_fused_range(previous: f32, current: f32, exponent: i64) -> bool {
+    fn value_in_range(value: f32, exponent: i64) -> bool {
+        if value == 0.0 {
+            return true;
+        }
+        let bits = value.to_bits() & 0x7fff_ffff;
+        let raw_exponent = ((bits >> 23) & 0xff) as i64;
+        if raw_exponent == 0 || raw_exponent == 0xff {
+            return false;
+        }
+        let scaled_exponent = raw_exponent + exponent;
+        if !(87..=167).contains(&scaled_exponent) {
+            return false;
+        }
+        let scaled_bits = (bits & 0x007f_ffff) | ((scaled_exponent as u32) << 23);
+        (f32::from_bits(scaled_bits).to_bits()) <= <f32 as LegendrePrecision>::BIG.to_bits()
+            && scaled_bits >= <f32 as LegendrePrecision>::SMALL.to_bits()
+    }
+    value_in_range(previous, exponent) && value_in_range(current, exponent)
+}
