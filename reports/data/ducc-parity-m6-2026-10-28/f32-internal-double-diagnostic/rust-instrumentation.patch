 // SPDX-License-Identifier: GPL-2.0-or-later

 use super::*;
+#[cfg(feature = "m6-legendre-profile")]
+use std::sync::atomic::AtomicU64;
+
+#[cfg(feature = "m6-legendre-profile")]
+static M6_SCALAR_LEGENDRE_NS: [AtomicU64; 64] = [const { AtomicU64::new(0) }; 64];
+#[cfg(feature = "m6-legendre-profile")]
+static M6_SCALAR_LEGENDRE_CALLS: [AtomicU64; 64] = [const { AtomicU64::new(0) }; 64];
+#[cfg(feature = "m6-legendre-profile")]
+static M6_SCALAR_USEFUL_CONTRIBUTIONS: [AtomicU64; 64] = [const { AtomicU64::new(0) }; 64];
+#[cfg(feature = "m6-legendre-profile")]
+static M6_SCALAR_PAIR_CONTRIBUTIONS: [AtomicU64; 64] = [const { AtomicU64::new(0) }; 64];
+#[cfg(feature = "m6-legendre-profile")]
+static M6_SCALAR_RECURRENCE_UPDATES: [AtomicU64; 64] = [const { AtomicU64::new(0) }; 64];
+#[cfg(feature = "m6-legendre-profile")]
+static M6_SCALAR_STAGE_WALL_NS: AtomicU64 = AtomicU64::new(0);
+#[cfg(feature = "m6-legendre-profile")]
+static M6_SCALAR_STAGE_CALLS: AtomicU64 = AtomicU64::new(0);
+
+#[cfg(feature = "m6-legendre-profile")]
+pub(super) fn take_m6_scalar_legendre_profile() -> Vec<(usize, u64, u64, u64, u64, u64)> {
+    (0..64)
+        .filter_map(|worker| {
+            let nanos = M6_SCALAR_LEGENDRE_NS[worker].swap(0, Ordering::Relaxed);
+            let calls = M6_SCALAR_LEGENDRE_CALLS[worker].swap(0, Ordering::Relaxed);
+            let contributions =
+                M6_SCALAR_USEFUL_CONTRIBUTIONS[worker].swap(0, Ordering::Relaxed);
+            let pair_contributions =
+                M6_SCALAR_PAIR_CONTRIBUTIONS[worker].swap(0, Ordering::Relaxed);
+            let recurrence_updates =
+                M6_SCALAR_RECURRENCE_UPDATES[worker].swap(0, Ordering::Relaxed);
+            (calls != 0).then_some((
+                worker,
+                nanos,
+                calls,
+                contributions,
+                pair_contributions,
+                recurrence_updates,
+            ))
+        })
+        .collect()
+}
+
+#[cfg(feature = "m6-legendre-profile")]
+pub(super) fn take_m6_scalar_legendre_stage_wall() -> (u64, u64) {
+    (
+        M6_SCALAR_STAGE_WALL_NS.swap(0, Ordering::Relaxed),
+        M6_SCALAR_STAGE_CALLS.swap(0, Ordering::Relaxed),
+    )
+}

