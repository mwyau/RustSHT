+                q_imag: (0..count).map(|lane| -0.4 + lane as f32 * 0.003).collect(),
+                u_real: (0..count).map(|lane| 0.15 - lane as f32 * 0.002).collect(),
+                u_imag: (0..count).map(|lane| 0.55 + lane as f32 * 0.004).collect(),
