+        assert!(
+            (analyzed_b[index] - expected_b).norm() <= 3.0e-7,
+            "B_{{{degree},{order}}}: actual={:?}, DUCC={expected_b:?}",
+            analyzed_b[index]
+        );
+    }
+}
