+#[expect(
+    clippy::too_many_arguments,
+    reason = "The transition kernel receives coefficient factors and caller-owned lane scratch explicitly."
+)]
+pub(crate) fn try_synthesize_order_scalar_transition_dispatched(
+    arch: Arch,
+    m: usize,
+    lmax: usize,
+    sin_theta: &[f64],
+    cos_theta: &[f64],
+    sectoral_norm: f64,
+    coefficient_a: &[f64],
+    coefficient_b: &[f64],
+    coefficient_even: &[Complex64],
+    coefficient_odd: &[Complex64],
+    previous: &mut [f64],
+    current: &mut [f64],
+    next: &mut [f64],
+    exponents: &mut [i64],
+    sum_re: &mut [f64],
+    sum_im: &mut [f64],
+) -> Result<bool, ShtError> {
+    let lane_count = sin_theta.len();
+    debug_assert_eq!(lane_count, cos_theta.len());
+    debug_assert!(lane_count <= LATITUDE_BLOCK_SIZE);
+    debug_assert!(previous.len() >= lane_count);
+    debug_assert!(current.len() >= lane_count);
+    debug_assert!(next.len() >= lane_count);
+    debug_assert!(exponents.len() >= lane_count);
+    debug_assert!(sum_re.len() >= lane_count);
+    debug_assert!(sum_im.len() >= lane_count);
+
+    if lane_count == 0
+        || sin_theta
+            .iter()
+            .any(|&sine| !sine.is_finite() || sine < 0.01)
+        || cos_theta.iter().any(|&cosine| !cosine.is_finite())
+    {
+        return Ok(false);
+    }
+
+    let pair_count = (lmax - m + 2) / 2;
+    let maximum_sum_bound = 2.0 * scalar::BIG * scalar::BIG * pair_count as f64 * 10_000.0;
+    if !maximum_sum_bound.is_finite()
+        || !prepared_scalar_coefficients_are_safe(coefficient_even, coefficient_odd, pair_count)
+    {
+        return Ok(false);
+    }
+
+    let completed = arch.dispatch(StagedSynthesisScalarTransition {
+        m,
+        lmax,
+        sin_theta,
+        cos_theta,
+        sectoral_norm,
+        coefficient_a,
+        coefficient_b,
+        coefficient_even,
+        coefficient_odd,
+        previous: &mut previous[..lane_count],
+        current: &mut current[..lane_count],
+        next: &mut next[..lane_count],
+        exponents: &mut exponents[..lane_count],
+        sum_re: &mut sum_re[..lane_count],
+        sum_im: &mut sum_im[..lane_count],
+    });
+    if !completed || !finite_scalar_prefix_sums(&sum_re[..lane_count], &sum_im[..lane_count]) {
+        return Ok(false);
+    }
+    Ok(true)
+}
+
+fn prepared_scalar_coefficients_are_safe(
+    coefficient_even: &[Complex64],
+    coefficient_odd: &[Complex64],
+    pair_count: usize,
+) -> bool {
+    coefficient_even.len() >= pair_count
+        && coefficient_odd.len() >= pair_count
+        && coefficient_even
+            .iter()
+            .zip(coefficient_odd)
+            .take(pair_count)
+            .all(|(&even, &odd)| {
+                complex_components_in_normal_range(even) && complex_components_in_normal_range(odd)
+            })
+}
+
+fn finite_scalar_prefix_sums(sum_re: &[f64], sum_im: &[f64]) -> bool {
+    let limit = f64::MAX * 0.5;
+    sum_re
+        .iter()
+        .chain(sum_im)
+        .all(|value| value.is_finite() && value.abs() <= limit)
+}
+
+struct StagedSynthesisScalarTransition<'a> {
+    m: usize,
+    lmax: usize,
+    sin_theta: &'a [f64],
+    cos_theta: &'a [f64],
+    sectoral_norm: f64,
+    coefficient_a: &'a [f64],
+    coefficient_b: &'a [f64],
+    coefficient_even: &'a [Complex64],
+    coefficient_odd: &'a [Complex64],
+    previous: &'a mut [f64],
+    current: &'a mut [f64],
+    next: &'a mut [f64],
+    exponents: &'a mut [i64],
+    sum_re: &'a mut [f64],
+    sum_im: &'a mut [f64],
+}
+
+impl WithSimd for StagedSynthesisScalarTransition<'_> {
+    type Output = bool;
+
+    #[inline(always)]
+    fn with_simd<S: Simd>(self, simd: S) -> bool {
+        let StagedSynthesisScalarTransition {
+            m,
+            lmax,
+            sin_theta,
+            cos_theta,
+            sectoral_norm,
+            coefficient_a,
+            coefficient_b,
+            coefficient_even,
+            coefficient_odd,
+            previous,
+            current,
+            next,
+            exponents,
+            sum_re,
+            sum_im,
+        } = self;
+        let mut previous = previous;
+        let mut current = current;
+        let mut next = next;
+
+        for lane in 0..sin_theta.len() {
+            let (value, exponent) = match scalar::sectoral_value(sin_theta[lane], m, sectoral_norm)
+            {
+                Ok(value) => value,
+                Err(_) => return false,
+            };
+            previous[lane] = 0.0;
+            current[lane] = value;
+            exponents[lane] = exponent;
+            sum_re[lane] = 0.0;
+            sum_im[lane] = 0.0;
+        }
+
+        let mut normal_range = match scalar::normalize_pair_lanes(previous, current, exponents) {
+            Ok(normal_range) => normal_range,
+            Err(_) => return false,
+        };
+        if normal_range
+            && lane_values_in_normal_range(previous)
+            && lane_values_in_normal_range(current)
+        {
+            return FusedSynthesisScalarSuffix {
+                m,
+                lmax,
+                pair_start: 0,
+                cos_theta,
+                coefficient_a,
+                coefficient_b,
+                coefficient_even,
+                coefficient_odd,
+                previous,
+                current,
+                sum_re,
+                sum_im,
+            }
+            .with_simd(simd);
+        }
+
+        let pair_count = (lmax - m + 2) / 2;
+        for pair in 0..pair_count {
+            let even = coefficient_even[pair];
+            let odd = coefficient_odd[pair];
+            for lane in 0..current.len() {
+                let odd_factor = Complex64::new(odd.re * cos_theta[lane], odd.im * cos_theta[lane]);
+                let factor = Complex64::new(
+                    odd.re.mul_add(cos_theta[lane], even.re),
+                    odd.im.mul_add(cos_theta[lane], even.im),
+                );
+                if !complex_sum_is_normal_or_zero(factor, even, odd_factor) {
+                    return false;
+                }
+                let contribution =
+                    scalar::multiply_complex_scaled(factor, current[lane], exponents[lane]);
+                if !complex_scaled_product_is_normal_or_zero(
+                    contribution,
+                    factor,
+                    current[lane],
+                    1.0,
+                ) {
+                    return false;
+                }
+                let accumulated = Complex64::new(sum_re[lane], sum_im[lane]);
+                let updated = accumulated + contribution;
+                if !complex_sum_is_normal_or_zero(updated, accumulated, contribution) {
+                    return false;
+                }
+                sum_re[lane] = updated.re;
+                sum_im[lane] = updated.im;
+            }
+
+            if pair + 1 == pair_count {
+                break;
+            }
+
+            let (current_vectors, current_tail) = S::as_simd_f64s(current);
+            let (previous_vectors, previous_tail) = S::as_simd_f64s(previous);
+            let (cosine_vectors, cosine_tail) = S::as_simd_f64s(cos_theta);
+            let (next_vectors, next_tail) = S::as_mut_simd_f64s(next);
+            let a = simd.splat_f64s(coefficient_a[pair]);
+            let b = simd.splat_f64s(coefficient_b[pair]);
+            for index in 0..current_vectors.len() {
+                let cosine_squared = simd.mul_f64s(cosine_vectors[index], cosine_vectors[index]);
+                let leading = simd.mul_add_f64s(a, cosine_squared, b);
+                next_vectors[index] =
+                    simd.mul_add_f64s(leading, current_vectors[index], previous_vectors[index]);
+            }
+            for lane in 0..current_tail.len() {
+                let cosine_squared = cosine_tail[lane] * cosine_tail[lane];
+                let leading = coefficient_a[pair].mul_add(cosine_squared, coefficient_b[pair]);
+                next_tail[lane] = leading.mul_add(current_tail[lane], previous_tail[lane]);
+            }
+            std::mem::swap(&mut previous, &mut current);
+            std::mem::swap(&mut current, &mut next);
+            if normal_range {
+                if scalar::pair_lanes_need_scaling(simd, previous, current) {
+                    normal_range = match scalar::normalize_pair_lanes(previous, current, exponents)
+                    {
+                        Ok(normal_range) => normal_range,
+                        Err(_) => return false,
+                    };
+                }
+            } else {
+                normal_range = match scalar::normalize_pair_lanes(previous, current, exponents) {
+                    Ok(normal_range) => normal_range,
+                    Err(_) => return false,
+                };
+            }
+            if normal_range
+                && lane_values_in_normal_range(previous)
+                && lane_values_in_normal_range(current)
+            {
+                if !finite_scalar_prefix_sums(sum_re, sum_im) {
+                    return false;
+                }
+                return FusedSynthesisScalarSuffix {
+                    m,
+                    lmax,
+                    pair_start: pair + 1,
+                    cos_theta,
+                    coefficient_a,
+                    coefficient_b,
+                    coefficient_even,
+                    coefficient_odd,
+                    previous,
+                    current,
+                    sum_re,
+                    sum_im,
+                }
+                .with_simd(simd);
+            }
+        }
+        false
+    }
+}
+
+struct FusedSynthesisScalarSuffix<'a> {
+    m: usize,
+    lmax: usize,
+    pair_start: usize,
+    cos_theta: &'a [f64],
+    coefficient_a: &'a [f64],
+    coefficient_b: &'a [f64],
+    coefficient_even: &'a [Complex64],
+    coefficient_odd: &'a [Complex64],
+    previous: &'a [f64],
+    current: &'a [f64],
+    sum_re: &'a mut [f64],
+    sum_im: &'a mut [f64],
+}
+
+impl WithSimd for FusedSynthesisScalarSuffix<'_> {
+    type Output = bool;
+
+    #[inline(always)]
+    fn with_simd<S: Simd>(self, simd: S) -> bool {
+        let FusedSynthesisScalarSuffix {
+            m,
+            lmax,
+            pair_start,
+            cos_theta,
+            coefficient_a,
+            coefficient_b,
+            coefficient_even,
+            coefficient_odd,
+            previous: initial_previous,
+            current: initial_current,
+            sum_re,
+            sum_im,
+        } = self;
+        let (cosine_vectors, cosine_tail) = S::as_simd_f64s(cos_theta);
+        let (previous_vectors, previous_tail) = S::as_simd_f64s(initial_previous);
+        let (initial_vectors, initial_tail) = S::as_simd_f64s(initial_current);
+        let (sum_re_vectors, sum_re_tail) = S::as_mut_simd_f64s(sum_re);
+        let (sum_im_vectors, sum_im_tail) = S::as_mut_simd_f64s(sum_im);
+        let pair_count = (lmax - m + 2) / 2;
+        debug_assert!(pair_start <= pair_count);
+        debug_assert_eq!(previous_vectors.len(), initial_vectors.len());
+        debug_assert_eq!(previous_tail.len(), initial_tail.len());
+
+        for lane_block in 0..cosine_vectors.len() {
+            let cosine = cosine_vectors[lane_block];
+            let mut previous = previous_vectors[lane_block];
+            let mut current = initial_vectors[lane_block];
+            if !simd_values_in_normal_range(simd, previous)
+                || !simd_values_in_normal_range(simd, current)
+            {
+                return false;
+            }
+            let mut accumulated_re = sum_re_vectors[lane_block];
+            let mut accumulated_im = sum_im_vectors[lane_block];
+            for pair in pair_start..pair_count {
+                let even = coefficient_even[pair];
+                let odd = coefficient_odd[pair];
+                let coefficient_re =
+                    simd.mul_add_f64s(simd.splat_f64s(odd.re), cosine, simd.splat_f64s(even.re));
+                let coefficient_im =
+                    simd.mul_add_f64s(simd.splat_f64s(odd.im), cosine, simd.splat_f64s(even.im));
+                accumulated_re = simd.mul_add_f64s(current, coefficient_re, accumulated_re);
+                accumulated_im = simd.mul_add_f64s(current, coefficient_im, accumulated_im);
+
+                if pair + 1 < pair_count {
+                    let cosine_squared = simd.mul_f64s(cosine, cosine);
+                    let leading = simd.mul_add_f64s(
+                        simd.splat_f64s(coefficient_a[pair]),
+                        cosine_squared,
+                        simd.splat_f64s(coefficient_b[pair]),
+                    );
+                    let next = simd.mul_add_f64s(leading, current, previous);
+                    if !simd_values_in_normal_range(simd, next) {
+                        return false;
+                    }
+                    previous = current;
+                    current = next;
+                }
+            }
+            sum_re_vectors[lane_block] = accumulated_re;
+            sum_im_vectors[lane_block] = accumulated_im;
+        }
+
+        for lane in 0..cosine_tail.len() {
+            let cosine = cosine_tail[lane];
+            let mut previous = previous_tail[lane];
+            let mut current = initial_tail[lane];
+            if !scalar_value_in_normal_range(previous) || !scalar_value_in_normal_range(current) {
+                return false;
+            }
+            let mut accumulated_re = sum_re_tail[lane];
+            let mut accumulated_im = sum_im_tail[lane];
+            for pair in pair_start..pair_count {
+                let even = coefficient_even[pair];
+                let odd = coefficient_odd[pair];
+                accumulated_re = current.mul_add(odd.re.mul_add(cosine, even.re), accumulated_re);
+                accumulated_im = current.mul_add(odd.im.mul_add(cosine, even.im), accumulated_im);
+                if pair + 1 < pair_count {
+                    let leading = coefficient_a[pair].mul_add(cosine * cosine, coefficient_b[pair]);
+                    let next = leading.mul_add(current, previous);
+                    if !scalar_value_in_normal_range(next) {
+                        return false;
+                    }
+                    previous = current;
+                    current = next;
+                }
+            }
+            sum_re_tail[lane] = accumulated_re;
+            sum_im_tail[lane] = accumulated_im;
+        }
+        true
+    }
+}
