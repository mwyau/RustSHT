+    #[test]
+    fn f32_spin_pair_interleaved_normalization_matches_two_pass_reference() {
+        let initial_previous_plus = [
+            0.0,
+            f32::from_bits(1),
+            f32::from_bits(SMALL.to_bits() - 1),
+            -f32::from_bits(BIG.to_bits() + 1),
+            f32::MAX,
+            f32::MIN_POSITIVE,
+            -0.5,
+            0.0,
+        ];
+        let initial_current_plus = [
+            -0.0,
+            0.0,
+            0.0,
+            BIG,
+            f32::MIN_POSITIVE,
+            -f32::from_bits(1),
+            0.25,
+            SMALL,
+        ];
+        let mut actual_previous_plus = initial_previous_plus;
+        let mut actual_current_plus = initial_current_plus;
+        let mut actual_exponents_plus = [0; 8];
+        let mut actual_previous_minus = initial_current_plus;
+        let mut actual_current_minus = initial_previous_plus;
+        let mut actual_exponents_minus = [0; 8];
+        let mut expected_previous_plus = initial_previous_plus;
+        let mut expected_current_plus = initial_current_plus;
+        let mut expected_exponents_plus = [0; 8];
+        let mut expected_previous_minus = initial_current_plus;
+        let mut expected_current_minus = initial_previous_plus;
+        let mut expected_exponents_minus = [0; 8];
+
+        reference_normalize_pair_lanes(
+            &mut expected_previous_plus,
+            &mut expected_current_plus,
+            &mut expected_exponents_plus,
+        );
+        reference_normalize_pair_lanes(
+            &mut expected_previous_minus,
+            &mut expected_current_minus,
+            &mut expected_exponents_minus,
+        );
+        normalize_spin_pair_lanes(
+            &mut actual_previous_plus,
+            &mut actual_current_plus,
+            &mut actual_exponents_plus,
+            &mut actual_previous_minus,
+            &mut actual_current_minus,
+            &mut actual_exponents_minus,
+        )
+        .unwrap();
+
+        for lane in 0..initial_previous_plus.len() {
+            assert_eq!(
+                actual_previous_plus[lane].to_bits(),
+                expected_previous_plus[lane].to_bits()
+            );
+            assert_eq!(
+                actual_current_plus[lane].to_bits(),
+                expected_current_plus[lane].to_bits()
+            );
+            assert_eq!(actual_exponents_plus[lane], expected_exponents_plus[lane]);
+            assert_eq!(
+                actual_previous_minus[lane].to_bits(),
+                expected_previous_minus[lane].to_bits()
+            );
+            assert_eq!(
+                actual_current_minus[lane].to_bits(),
+                expected_current_minus[lane].to_bits()
+            );
+            assert_eq!(actual_exponents_minus[lane], expected_exponents_minus[lane]);
+        }
+    }
