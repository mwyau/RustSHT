+#[inline(always)]
+fn analysis_pair_recurrence_tail(
+    coefficient_a: f64,
+    coefficient_b: f64,
+    cosine_squared: f64,
+    current: f64,
+    previous: f64,
+) -> f64 {
+    coefficient_a
+        .mul_add(cosine_squared, coefficient_b)
+        .mul_add(current, previous)
+}
+
+#[inline(always)]
+fn normal_analysis_value(value: f64) -> bool {
+    value.is_finite()
+        && value.abs() <= scalar::BIG
+        && (value == 0.0 || value.abs() >= scalar::SMALL)
+}
