+// SPDX-FileCopyrightText: 2026 Albert M. W. Yau
+// SPDX-FileCopyrightText: 2010-2026 Max-Planck-Society (DUCC FFT pass equations)
+// SPDX-License-Identifier: BSD-3-Clause
+//
+// The radix-103 paired-frequency equations follow DUCC fft1d_impl.h at
+// c1ed01b8fda69d2a378190f0915f1a19762dddbf. This module adds FMA accumulation
+// to the AVX2 implementation in `simd.rs`.
+
+use std::arch::x86_64::*;
+
+use num_complex::Complex;
+
+use crate::simd::ComplexGeneralPrimeIdo1Params;
+
+const RADIX: usize = 103;
+const HALF: usize = RADIX / 2;
+const PAIR_COUNT: usize = HALF / 2;
+
+/// Executes the radix-103 paired-frequency pass with AVX2 and FMA.
+///
+/// # Safety
+///
+/// The caller must confirm AVX2 and FMA support, provide disjoint buffers of
+/// at least `103 * l1` complex values, and ensure the inverse input is within
+/// the deferred-normalization safety range. The phase table must contain at
+/// least `51 * 103` entries, and the root table must cover every indexed root.
+#[target_feature(enable = "avx2,fma")]
+#[inline(never)]
+pub(crate) unsafe fn execute(
+    input: &[Complex<f64>],
+    output: &mut [Complex<f64>],
+    params: ComplexGeneralPrimeIdo1Params<'_, f64>,
+) {
+    let ComplexGeneralPrimeIdo1Params {
+        l1,
+        roots,
+        root_stride,
+        phase_indices,
+        inverse,
+        scale,
+    } = params;
+    debug_assert!(l1 > 0);
+    debug_assert!(root_stride > 0);
+    debug_assert!(input.len() >= RADIX * l1);
+    debug_assert!(output.len() >= RADIX * l1);
+    debug_assert!(phase_indices.len() >= HALF * RADIX);
+    debug_assert!(roots.len() > (RADIX - 1) * root_stride);
+
+    let output_ptr = output.as_mut_ptr();
+    let output_scale = _mm256_set1_pd(scale);
+    let sign = if inverse { 1.0 } else { -1.0 };
+
+    for outer in 0..l1 {
+        let input_zero = input[RADIX * outer];
+        let mut pair_inputs = std::mem::MaybeUninit::<[Complex<f64>; HALF]>::uninit();
+        let mut imaginary_differences = std::mem::MaybeUninit::<[Complex<f64>; HALF]>::uninit();
+        let pair_inputs_ptr = pair_inputs.as_mut_ptr().cast::<Complex<f64>>();
+        let imaginary_differences_ptr = imaginary_differences.as_mut_ptr().cast::<Complex<f64>>();
+        let mut dc = input_zero;
+        for branch_index in 0..HALF {
+            let branch = branch_index + 1;
+            let left = input[RADIX * outer + branch];
+            let right = input[RADIX * outer + (RADIX - branch)];
+            let pair = left + right;
+            let difference = left - right;
+            // SAFETY: each index in 0..HALF is written exactly once in both
+            // scratch arrays before either array is read below.
+            unsafe {
+                pair_inputs_ptr.add(branch_index).write(pair);
+                imaginary_differences_ptr
+                    .add(branch_index)
+                    .write(Complex::new(-difference.im, difference.re));
+            }
+            dc += pair;
+        }
+        // SAFETY: the preceding loop initialized every element in both arrays.
+        let pair_inputs = unsafe { pair_inputs.assume_init_ref() };
+        let imaginary_differences = unsafe { imaginary_differences.assume_init_ref() };
+        if inverse {
+            dc *= scale;
+        }
+        output[outer] = dc;
+
+        for pair_index in 0..PAIR_COUNT {
+            let frequency = 1 + 2 * pair_index;
+            let initial =
+                _mm256_setr_pd(input_zero.re, input_zero.im, input_zero.re, input_zero.im);
+            let mut positive = initial;
+            let mut negative = initial;
+
+            for branch_index in 0..HALF {
+                let phase_first = usize::from(phase_indices[branch_index * RADIX + frequency]);
+                let phase_second = usize::from(phase_indices[branch_index * RADIX + frequency + 1]);
+                let root_first = roots[phase_first * root_stride];
+                let root_second = roots[phase_second * root_stride];
+                let cosine =
+                    _mm256_setr_pd(root_first.re, root_first.re, root_second.re, root_second.re);
+                let sine = _mm256_setr_pd(
+                    root_first.im * sign,
+                    root_first.im * sign,
+                    root_second.im * sign,
+                    root_second.im * sign,
+                );
+                let pair_value = pair_inputs[branch_index];
+                let difference_value = imaginary_differences[branch_index];
+                let pair =
+                    _mm256_setr_pd(pair_value.re, pair_value.im, pair_value.re, pair_value.im);
+                let difference = _mm256_setr_pd(
+                    difference_value.re,
+                    difference_value.im,
+                    difference_value.re,
+                    difference_value.im,
+                );
+                positive =
+                    _mm256_fmadd_pd(sine, difference, _mm256_fmadd_pd(cosine, pair, positive));
+                negative =
+                    _mm256_fnmadd_pd(sine, difference, _mm256_fmadd_pd(cosine, pair, negative));
+            }
+
+            if inverse {
+                positive = _mm256_mul_pd(positive, output_scale);
+                negative = _mm256_mul_pd(negative, output_scale);
+            }
+            // SAFETY: low and high lanes each contain one complex result;
+            // both output frequencies are in range for 1 <= frequency < 52.
+            unsafe {
+                _mm_storeu_pd(
+                    output_ptr.add(frequency * l1 + outer).cast::<f64>(),
+                    _mm256_castpd256_pd128(positive),
+                );
+                _mm_storeu_pd(
+                    output_ptr.add((frequency + 1) * l1 + outer).cast::<f64>(),
+                    _mm256_extractf128_pd(positive, 1),
+                );
+                _mm_storeu_pd(
+                    output_ptr
+                        .add((RADIX - frequency) * l1 + outer)
+                        .cast::<f64>(),
+                    _mm256_castpd256_pd128(negative),
+                );
+                _mm_storeu_pd(
+                    output_ptr
+                        .add((RADIX - frequency - 1) * l1 + outer)
+                        .cast::<f64>(),
+                    _mm256_extractf128_pd(negative, 1),
+                );
+            }
+        }
+
+        let mut positive = input_zero;
+        let mut negative = input_zero;
+        for branch_index in 0..HALF {
+            let phase = usize::from(phase_indices[branch_index * RADIX + HALF]);
+            let root = roots[phase * root_stride];
+            let pair = pair_inputs[branch_index];
+            let difference = imaginary_differences[branch_index];
+            let cosine = pair * root.re;
+            let sine = difference * (root.im * sign);
+            positive = positive + cosine + sine;
+            negative = negative + cosine - sine;
+        }
+        if inverse {
+            positive *= scale;
+            negative *= scale;
+        }
+        output[HALF * l1 + outer] = positive;
+        output[(RADIX - HALF) * l1 + outer] = negative;
+    }
+}
