+fn execute_1442_rader<T: Float + FromPrimitive>(
+    input: &[Complex<T>],
+    output: &mut [Complex<T>],
+    pass: &ComplexPass<T>,
+    execution: &mut PassExecution<'_, T>,
+) -> bool {
+    let (Some(plan), Some(workspace)) = (
+        execution.radix103_rader,
+        execution.radix103_rader_workspace.as_deref_mut(),
+    ) else {
+        return false;
+    };
+    if execution.total_len != 1442
+        || pass.radix != 103
+        || pass.l1 != 14
+        || pass.ido != 1
+        || (execution.direction == Direction::Inverse && !execution.defer_inverse_normalization)
+        || !plan.is_safe_components(
+            input.iter().flat_map(|value| [value.re, value.im]),
+            execution.total_len,
+            1,
+        )
+    {
+        return false;
+    }
+
+    let radix = pass.radix;
+    let direction = execution.direction;
+    let inverse_scale = execution.inverse_output_scale;
+    let radix_input = &mut execution.radix_input[..radix];
+    let radix_output = &mut execution.radix_output[..radix];
+    for outer in 0..pass.l1 {
+        for (branch, value) in radix_input.iter_mut().enumerate() {
+            *value = input[branch + radix * outer];
+        }
+        plan.execute_complex(radix_input, radix_output, direction, workspace);
+        for (frequency, &transformed) in radix_output.iter().enumerate() {
+            let value = if direction == Direction::Inverse {
+                transformed * inverse_scale
+            } else {
+                transformed
+            };
+            output[frequency * pass.l1 + outer] = value;
+        }
+    }
+
+    #[cfg(test)]
+    crate::m0_record_route(format!(
+        "c2c-rader n=1442 radix={} l1={} ido={} convolution={}",
+        pass.radix,
+        pass.l1,
+        pass.ido,
+        plan.convolution_len()
+    ));
+    true
+}
