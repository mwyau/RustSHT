index 0000000..fd18ad2
--- /dev/null
+++ b/crates/rustsht-fft/src/simd/x86/f64_kernel/radix103_paired_outer.rs
@@ -0,0 +1,223 @@
+// SPDX-FileCopyrightText: 2026 Albert M. W. Yau
+// SPDX-FileCopyrightText: 2010-2026 Max-Planck-Society (DUCC FFT pass equations)
+// SPDX-License-Identifier: BSD-3-Clause
+//
+// This AVX2 kernel evaluates radix-103 direct sums while pairing adjacent
+// outer groups in vector lanes.
+
+use std::arch::x86_64::*;
+
+use num_complex::Complex;
+
+use crate::simd::ComplexGeneralPrimeIdo1Params;
+
+const RADIX: usize = 103;
+const HALF: usize = RADIX / 2;
+
+/// Executes a radix-103 `ido == 1` pass over adjacent outer groups.
+///
+/// A frequency's coefficient is shared across both complex values in each
+/// vector, and the output group pair is contiguous in the pass layout. A
+/// remaining odd group uses a scalar tail.
+///
+/// # Safety
+///
+/// The caller must have detected AVX2 and provide disjoint input and output
+/// slices, positive `l1`, a complete radix-103 phase table and every
+/// root indexed by the parameters. Inverse input must be in the deferred
+/// normalization safety range.
+#[target_feature(enable = "avx2")]
+#[inline(never)]
+pub(super) unsafe fn execute(
+    input: &[Complex<f64>],
+    output: &mut [Complex<f64>],
+    params: ComplexGeneralPrimeIdo1Params<'_, f64>,
+) {
+    let ComplexGeneralPrimeIdo1Params {
+        l1,
+        roots,
+        root_stride,
+        phase_indices,
+        inverse,
+        scale,
+    } = params;
+    debug_assert!(l1 > 0);
+    debug_assert!(input.len() >= RADIX * l1);
+    debug_assert!(output.len() >= RADIX * l1);
+    debug_assert!(phase_indices.len() >= HALF * RADIX);
+    debug_assert!(roots.len() > (RADIX - 1) * root_stride);
+
+    let output_ptr = output.as_mut_ptr();
+    let output_scale = _mm256_set1_pd(scale);
+    let sign = if inverse { 1.0 } else { -1.0 };
+
+    let vector_l1 = l1 - l1 % 2;
+    for outer in (0..vector_l1).step_by(2) {
+        let input_zero_first = input[RADIX * outer];
+        let input_zero_second = input[RADIX * (outer + 1)];
+        let initial = _mm256_setr_pd(
+            input_zero_first.re,
+            input_zero_first.im,
+            input_zero_second.re,
+            input_zero_second.im,
+        );
+        let mut dc = initial;
+        let mut pair_inputs = [_mm256_setzero_pd(); HALF];
+        let mut imaginary_differences = [_mm256_setzero_pd(); HALF];
+        for branch_index in 0..HALF {
+            let branch = branch_index + 1;
+            let left_first = input[RADIX * outer + branch];
+            let right_first = input[RADIX * outer + (RADIX - branch)];
+            let left_second = input[RADIX * (outer + 1) + branch];
+            let right_second = input[RADIX * (outer + 1) + (RADIX - branch)];
+            let pair_first = left_first + right_first;
+            let pair_second = left_second + right_second;
+            let difference_first = left_first - right_first;
+            let difference_second = left_second - right_second;
+            pair_inputs[branch_index] =
+                _mm256_setr_pd(pair_first.re, pair_first.im, pair_second.re, pair_second.im);
+            imaginary_differences[branch_index] = _mm256_setr_pd(
+                -difference_first.im,
+                difference_first.re,
+                -difference_second.im,
+                difference_second.re,
+            );
+            dc = _mm256_add_pd(dc, pair_inputs[branch_index]);
+        }
+        let dc = if inverse {
+            _mm256_mul_pd(dc, output_scale)
+        } else {
+            dc
+        };
+        // SAFETY: `outer` and `outer + 1` are a complete in-bounds pair, and
+        // the output slice is disjoint from the input.
+        unsafe {
+            _mm256_storeu_pd(output_ptr.add(outer).cast::<f64>(), dc);
+        }
+
+        for frequency in 1..HALF {
+            let mut positive = initial;
+            let mut negative = initial;
+            for branch_index in 0..HALF {
+                let phase = usize::from(phase_indices[branch_index * RADIX + frequency]);
+                let root = roots[phase * root_stride];
+                let cosine = _mm256_set1_pd(root.re);
+                let sine = _mm256_set1_pd(root.im * sign);
+                let pair = pair_inputs[branch_index];
+                let difference = imaginary_differences[branch_index];
+                let cosine_term = _mm256_mul_pd(pair, cosine);
+                let sine_term = _mm256_mul_pd(difference, sine);
+                positive = _mm256_add_pd(positive, _mm256_add_pd(cosine_term, sine_term));
+                negative = _mm256_sub_pd(_mm256_add_pd(negative, cosine_term), sine_term);
+            }
+            if inverse {
+                positive = _mm256_mul_pd(positive, output_scale);
+                negative = _mm256_mul_pd(negative, output_scale);
+            }
+            // SAFETY: both frequencies are in 1..RADIX, and each store covers
+            // the adjacent outer pair initialized above.
+            unsafe {
+                _mm256_storeu_pd(
+                    output_ptr.add(frequency * l1 + outer).cast::<f64>(),
+                    positive,
+                );
+                _mm256_storeu_pd(
+                    output_ptr
+                        .add((RADIX - frequency) * l1 + outer)
+                        .cast::<f64>(),
+                    negative,
+                );
+            }
+        }
+
+        let mut positive = initial;
+        let mut negative = initial;
+        for branch_index in 0..HALF {
+            let phase = usize::from(phase_indices[branch_index * RADIX + HALF]);
+            let root = roots[phase * root_stride];
+            let cosine = _mm256_set1_pd(root.re);
+            let sine = _mm256_set1_pd(root.im * sign);
+            let cosine_term = _mm256_mul_pd(pair_inputs[branch_index], cosine);
+            let sine_term = _mm256_mul_pd(imaginary_differences[branch_index], sine);
+            positive = _mm256_add_pd(positive, _mm256_add_pd(cosine_term, sine_term));
+            negative = _mm256_sub_pd(_mm256_add_pd(negative, cosine_term), sine_term);
+        }
+        if inverse {
+            positive = _mm256_mul_pd(positive, output_scale);
+            negative = _mm256_mul_pd(negative, output_scale);
+        }
+        // SAFETY: the final two frequencies and both outer values are in
+        // bounds; the output slice is disjoint from the input.
+        unsafe {
+            _mm256_storeu_pd(output_ptr.add(HALF * l1 + outer).cast::<f64>(), positive);
+            _mm256_storeu_pd(
+                output_ptr.add((RADIX - HALF) * l1 + outer).cast::<f64>(),
+                negative,
+            );
+        }
+    }
+
+    if vector_l1 < l1 {
+        execute_scalar_group(
+            input,
+            output,
+            vector_l1,
+            l1,
+            roots,
+            root_stride,
+            phase_indices,
+            inverse,
+            scale,
+        );
+    }
+}
+
+#[cold]
+#[inline(never)]
+fn execute_scalar_group(
+    input: &[Complex<f64>],
+    output: &mut [Complex<f64>],
+    outer: usize,
+    l1: usize,
+    roots: &[Complex<f64>],
+    root_stride: usize,
+    phase_indices: &[u8],
+    inverse: bool,
+    scale: f64,
+) {
+    let sign = if inverse { 1.0 } else { -1.0 };
+    let input_zero = input[RADIX * outer];
+    let mut dc = input_zero;
+    for branch_index in 0..HALF {
+        let branch = branch_index + 1;
+        let left = input[RADIX * outer + branch];
+        let right = input[RADIX * outer + (RADIX - branch)];
+        dc += left + right;
+    }
+    output[outer] = if inverse { dc * scale } else { dc };
+
+    for frequency in 1..=HALF {
+        let mut positive = input_zero;
+        let mut negative = input_zero;
+        for branch_index in 0..HALF {
+            let branch = branch_index + 1;
+            let left = input[RADIX * outer + branch];
+            let right = input[RADIX * outer + (RADIX - branch)];
+            let pair = left + right;
+            let difference = left - right;
+            let imaginary_difference = Complex::new(-difference.im, difference.re);
+            let phase = usize::from(phase_indices[branch_index * RADIX + frequency]);
+            let root = roots[phase * root_stride];
+            let cosine_term = pair * root.re;
+            let sine_term = imaginary_difference * (root.im * sign);
+            positive += cosine_term + sine_term;
+            negative += cosine_term - sine_term;
+        }
+        if inverse {
+            positive *= scale;
+            negative *= scale;
+        }
+        output[frequency * l1 + outer] = positive;
+        output[(RADIX - frequency) * l1 + outer] = negative;
+    }
+}
